{"benchmark_id": "bmk-v1-084", "category": "formats_compile_faq", "context_hash": "b68e827962b77f355bbafe38a8b5a736c403bbaebda2b1bc8b09b5b39ac340c0", "msgctxt": "doc/texinfo/gmsh.texi|MSH file format|paragraph|fb365987f89eb95430c5e5674bd3df3bea343286fcde9ba874999785049da3bd", "msgid": "18-node second order prism (6 nodes associated with the vertices, 9 with\nthe edges and 3 with the quadrangular faces).", "msgid_sha256": "fb365987f89eb95430c5e5674bd3df3bea343286fcde9ba874999785049da3bd", "node": "MSH file format", "protected_hash": "4b1bfc55c78614bccacf681c010f08968cae2dea2c99ce69944682df2eaa3f17", "protected_values": ["18", "6", "9", "3"], "reference_translation": "", "reference_translation_status": "pending", "role": "paragraph", "schema_version": 1, "selection_method": "sha256-stratified-v1", "selection_rank": "0d4cfaafec5a5f936bb66401dc011d7ec60f28c9b7e5599653370b70182874cc", "semantic_key": "fb365987f89eb95430c5e5674bd3df3bea343286fcde9ba874999785049da3bd", "source_file": "doc/texinfo/gmsh.texi", "source_hash": "be5372626c43fd2f3ecfe35fe45fc16b6b706be1dd28c6c21538c3615a130989", "structure_path": "doc/texinfo/gmsh.texi::MSH file format", "subcategory": "formats", "unit_id": "0a8dbf089d97f1b6745df548ef524ec4078e5a4860c5c185a947ce3f10acbe76"}
{"benchmark_id": "bmk-v1-085", "category": "formats_compile_faq", "context_hash": "569d075ee8fd20da04c3cc8d906ce1edba20308dc0f2486ff3a2195d674864b9", "msgctxt": "doc/texinfo/gmsh.texi|MSH file format|paragraph|3502f41510892e5e9ee87bf1c69ed313409c793ba0119431fb7a9bc863d0609b", "msgid": "125-node fourth order hexahedron (8 nodes associated with the vertices, 36\nwith the edges, 54 with the faces, 27 in the volume)", "msgid_sha256": "3502f41510892e5e9ee87bf1c69ed313409c793ba0119431fb7a9bc863d0609b", "node": "MSH file format", "protected_hash": "d38444a487658a421e507157644cc26e5a529713b6a4c8811e137fc889ff1ae2", "protected_values": ["125", "8", "36", "54", "27"], "reference_translation": "", "reference_translation_status": "pending", "role": "paragraph", "schema_version": 1, "selection_method": "sha256-stratified-v1", "selection_rank": "0f9c32e78b7ff4f4be9da99c97a287e9c37d7db68f8f0473d75bd451fa1e94ed", "semantic_key": "3502f41510892e5e9ee87bf1c69ed313409c793ba0119431fb7a9bc863d0609b", "source_file": "doc/texinfo/gmsh.texi", "source_hash": "68bd5e32292e97b9e82fea7779bdaa905120c6ad0d2b5042531ef448bb7440d8", "structure_path": "doc/texinfo/gmsh.texi::MSH file format", "subcategory": "formats", "unit_id": "6d9e125db069f6cc54eacdd3f7e3b346d62db4eab0758a6d5564bfb758684372"}
{"benchmark_id": "bmk-v1-086", "category": "formats_compile_faq", "context_hash": "02dc15e0a25ea8e4756689fd6f53c0ed58fc7fc685aa29e8cbfda3dc26bf217a", "msgctxt": "doc/texinfo/gmsh.texi|MSH file format|paragraph|61a3d9e4fe3b9f671004772eba23284a60b57073f0b8206ec93a5c8cc8266f8f", "msgid": "In the format description above, @code{elementType} is e.g.:", "msgid_sha256": "61a3d9e4fe3b9f671004772eba23284a60b57073f0b8206ec93a5c8cc8266f8f", "node": "MSH file format", "protected_hash": "707573c1f6a8901fc7a9310cc64a1f4d647d9fbd6014d4047a7f7d686450dff1", "protected_values": ["@code{elementType}"], "reference_translation": "", "reference_translation_status": "pending", "role": "paragraph", "schema_version": 1, "selection_method": "sha256-stratified-v1", "selection_rank": "0ffa950ef354ec9a509bcc89d2321e804ebae71cb59abac2557d2a75562d9275", "semantic_key": "61a3d9e4fe3b9f671004772eba23284a60b57073f0b8206ec93a5c8cc8266f8f", "source_file": "doc/texinfo/gmsh.texi", "source_hash": "272954c49b6062857b91b92447add4c6d846cd6cb6fe8ff701976ca4da518f7f", "structure_path": "doc/texinfo/gmsh.texi::MSH file format", "subcategory": "formats", "unit_id": "5ff1c28280dbb6ea34d6c2f80e0d37387bb9d6ba01545a4e94b28a3f97deb736"}
{"benchmark_id": "bmk-v1-087", "category": "formats_compile_faq", "context_hash": "3392b6548735c8e6881644d10f9aae5aa808da38a1332e4be8fa29f3ec3630f0", "msgctxt": "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{number-of-interpolation-matrices}#2", "msgid": "Below is a small example (a mesh consisting of two quadrangles with an\nassociated nodal scalar dataset; the comments are not part of the actual\nfile!):", "msgid_sha256": "1f691264d3a43a555523462d458f751fc318540925b2901022bee115b18d0247", "node": "MSH file format version 2 (Legacy)", "protected_hash": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "protected_values": [], "reference_translation": "", "reference_translation_status": "pending", "role": "paragraph", "schema_version": 1, "selection_method": "sha256-stratified-v1", "selection_rank": "1c393ddba774f2c1eb8be3e9389eaa41e05a7ee5da0db9f194590a11780416a6", "semantic_key": "@var{number-of-interpolation-matrices}#2", "source_file": "doc/texinfo/gmsh.texi", "source_hash": "c581e369bc75924d72a251c8e9af4523b18ac78d41fd214afa78457ba03f15e9", "structure_path": "doc/texinfo/gmsh.texi::MSH file format version 2 (Legacy)", "subcategory": "formats", "unit_id": "589125eb172faf2f835e91ab4c6724f7b74e04345d6456f839532aa10bc2d197"}
{"benchmark_id": "bmk-v1-088", "category": "formats_compile_faq", "context_hash": "967cdb37306c832926248cf11b90adbbd86b6a0d23a2860ddb6bd1080777d593", "msgctxt": "doc/texinfo/gmsh.texi|MSH file format|paragraph|f549b33ca7c58f6c82fcc668abd0eac469189001a66d18fb71064f6712e9b8e1", "msgid": "The @code{$Periodic} section has been changed to always provide the\nnumber of values in the affine transform (which can be zero, if the\ntransform is not provided).", "msgid_sha256": "f549b33ca7c58f6c82fcc668abd0eac469189001a66d18fb71064f6712e9b8e1", "node": "MSH file format", "protected_hash": "f335767bc74c2a8adf8d3b71a569821a81a24ba82f55d3db17a186a60cff2d62", "protected_values": ["@code{$Periodic}"], "reference_translation": "", "reference_translation_status": "pending", "role": "paragraph", "schema_version": 1, "selection_method": "sha256-stratified-v1", "selection_rank": "1f27b19c19dcf3cc0b2cbeba671a902c16db0954b9152ba1080fc0830c49e714", "semantic_key": "f549b33ca7c58f6c82fcc668abd0eac469189001a66d18fb71064f6712e9b8e1", "source_file": "doc/texinfo/gmsh.texi", "source_hash": "5342bd70d1a86d7d63d386a63921bd40bfd731ded33be2e46647aa22b65f5bf0", "structure_path": "doc/texinfo/gmsh.texi::MSH file format", "subcategory": "formats", "unit_id": "08240f820530cb05591754af316e8ec96b6f750de5cfcd8a82dfe0ab2a69157d"}
{"benchmark_id": "bmk-v1-089", "category": "formats_compile_faq", "context_hash": "0b3c6db1ea00eda34fd53836e2cb5ee9ade8df0105709b3e47876c3672e4a20e", "msgctxt": "doc/texinfo/gmsh.texi|Gmsh file formats|paragraph|ad7c5dea5377baec21e32dc2dd2825c6b173fac39e6d695e7b54a2d10b4979bd", "msgid": "(Remember that for small post-processing datasets you can also use\nhuman-readable ``parsed'' post-processing views, as described in\n@ref{Post-processing scripting commands}. Such ``parsed'' views do not\nrequire an underlying mesh, and can therefore be easier to use in some\ncases.)", "msgid_sha256": "ad7c5dea5377baec21e32dc2dd2825c6b173fac39e6d695e7b54a2d10b4979bd", "node": "Gmsh file formats", "protected_hash": "bb995bf8b3f6ea572e20b2d0c2c554edef301364914b8dd0f485ea72d0b22bfe", "protected_values": ["@ref{Post-processing scripting commands}"], "reference_translation": "", "reference_translation_status": "pending", "role": "paragraph", "schema_version": 1, "selection_method": "sha256-stratified-v1", "selection_rank": "217621456722343a0cdbd1cd3084a702b892b75d8eb93e8658a3b01e8e613469", "semantic_key": "ad7c5dea5377baec21e32dc2dd2825c6b173fac39e6d695e7b54a2d10b4979bd", "source_file": "doc/texinfo/gmsh.texi", "source_hash": "b126da5d92efcd80608302d6d8a7b3be401156054ee5966524627abd442e00c4", "structure_path": "doc/texinfo/gmsh.texi::Gmsh file formats", "subcategory": "formats", "unit_id": "ce879fedc5d12e91cae13e76b9020144b809dbcc4d0b43a569403ecfb7c81d5e"}
{"benchmark_id": "bmk-v1-090", "category": "formats_compile_faq", "context_hash": "902bb58a1ee4d794d6887336084716346cfd0914582c00fb876430a3c0ca92e8", "msgctxt": "doc/texinfo/gmsh.texi|POS ASCII file format (Legacy)|paragraph|@var{view-name}", "msgid": "is a string containing the name of the view (max. 256 characters).", "msgid_sha256": "c7b606519c79135a882072fa64968b5e4a8f8ed801d767743247438db13c8589", "node": "POS ASCII file format (Legacy)", "protected_hash": "44928603bf7fb1cfd4549dfcf76c562fb6561265cb8603954e52ffc5edd9f758", "protected_values": ["256"], "reference_translation": "", "reference_translation_status": "pending", "role": "paragraph", "schema_version": 1, "selection_method": "sha256-stratified-v1", "selection_rank": "2216a2231805c0811e9b9b75692edc5c7be9a9923d5383f8bd477b4794075536", "semantic_key": "@var{view-name}", "source_file": "doc/texinfo/gmsh.texi", "source_hash": "b6cffef878046bb1e1f427f427263415fc27c9c5fad84bcfb6efc92599cd2059", "structure_path": "doc/texinfo/gmsh.texi::POS ASCII file format (Legacy)", "subcategory": "formats", "unit_id": "e1c2bd03c77781019e5f5860f5e28c1db14075eb41589345746de21f6d4af99a"}
