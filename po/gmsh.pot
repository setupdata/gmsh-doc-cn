#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.17"
msgid "1.17 (Apr 17, 2001): corrected physical points saving; fixed parsing of DOS\nfiles (carriage return problems); easier geometrical selections (cursor change);\nplugin manager; enhanced variable arrays (sublist selection and affectation);\nline loop check; New arrow display; reduced number of 'fatal' errors + better\nhandling in interactive mode; fixed bug when opening meshes; enhanced File->Open\nbehavior for meshes and post-processing views."
msgstr ""

#. unit_id: d954e6a5e2b589355550d5bb8004a24ccddceb908a887bf7efb23ad3fba1bb69
