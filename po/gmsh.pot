#. source_hash: 6ddac9fe9f461c0d50e30eecede8f4d91d4b45c901250e79db0a88274211d822
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{version-number}"
msgid "is a real number equal to 2.2"
msgstr ""

#. unit_id: 7e59729f2e94ea74932dabe88fcbe61be2bbf73034cefbb2cbb7d5f0e7a7899c
#. source_hash: 74a06d069a0a9257f2016246daeba0c0f226430397dd0ae8efd3227202649ec6
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|item|@var{file-type}"
msgid "@var{file-type}"
msgstr ""

#. unit_id: 2f13dbb0cad6a3b7655214b389f0fa801192e4cf5581d0649b5de3ca1a585194
#. source_hash: 66d0b6052e66d9f463db4c5db6efcf09abef4b7c2a02d2f1f1591e56efdfc602
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{file-type}"
msgid "is an integer equal to 0 in the ASCII file format."
msgstr ""

#. unit_id: 408217dafffb1d5572bb535cb6b29932a068ed4e9273beb74577621d5f92eab6
#. source_hash: e9d52467ddc02c0c9cbd6794e7bd191f5e428a4d316f3571b9f82d06c282112f
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|item|@var{data-size}"
msgid "@var{data-size}"
msgstr ""

#. unit_id: ceedb91f9260e3441bb97efe5585a523857179bafc81a149bca1a9c161687e67
#. source_hash: 824d18e469c02dcfb26e37eb571810a91f718c72868467f30c0adc26b0a97728
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{data-size}"
msgid "is an integer equal to the size of the floating point numbers used in the\nfile (currently only @var{data-size} = sizeof(double) is supported)."
msgstr ""

#. unit_id: 6950b43f99e2bbb8d8084a9635c77abb019d4c74c1ddb4d7ed3d67a0576c1329
#. source_hash: cdecf58b1289ec847899329bc91d26fae41c2ac4904d6b09ebe6c64157b03afe
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|item|@var{number-of-nodes}"
msgid "@var{number-of-nodes}"
msgstr ""

#. unit_id: 5913e69fbc19fb95d4215fca5d981d8c14bc7f55a7db1f29ebec30aa6611124d
#. source_hash: 800ce1680436bed6bffb196024a71f2d24defdfcbccb1eaf20be9f28d992659d
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{number-of-nodes}"
msgid "is the number of nodes in the mesh."
msgstr ""

#. unit_id: c2832e088fe1f9646612b2861c1aa3ed2d7c954c0ce88e78237bc3199ec088fe
#. source_hash: 85dbdc4565b801c6b7eea9b23c184113a441bb006955174bff89c61299751ba9
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|item|@var{node-number}"
msgid "@var{node-number}"
msgstr ""

#. unit_id: 5e4464146f34838f78d72d659289fd5d871b3e0466101dfe4a3156f4605b6c25
#. source_hash: 00bd522bc72129a213629ae21793c11ddf76cbddc0e2074ac65d688525bd840b
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{node-number}"
msgid "is the number (index) of the @var{n}-th node in the mesh;\n@var{node-number} must be a positive (non-zero) integer. Note that the\n@w{@var{node-number}s} do not necessarily have to form a dense nor an\nordered sequence."
msgstr ""

#. unit_id: 7512d95c2a180da169f82114b4e35ecdc2fe55398f6e21a459f4f3148bbac6ab
#. source_hash: 322797ff59cbfad27a45f6243e0ee65f422a39b7ad935d0d6809ad557725b9df
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|item|@var{x-coord} @var{y-coord} @var{z-coord}"
msgid "@var{x-coord} @var{y-coord} @var{z-coord}"
msgstr ""

#. unit_id: 348f139821d6ca52418ca9ff2f918b612762a396d14a35d076d3d3dcb929dc6b
#. source_hash: cb374e3de8ff66545d94e9822043817cc70bbdbcd188345eae32845475ba50b3
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{x-coord} @var{y-coord} @var{z-coord}"
msgid "are the floating point values giving the X, Y and Z coordinates of the\n@var{n}-th node."
msgstr ""

#. unit_id: baf4f191985eba5002ee1eafc8fd787a072f207d68db6caef7b8f81b412480ab
#. source_hash: 175ebe017cabde65e83c80478c9384a7b5bdfea6b58447148cef398765ac4017
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|item|@var{number-of-elements}"
msgid "@var{number-of-elements}"
msgstr ""

#. unit_id: 3df40a6ce49f4110e6351905ec4c630e4c1a41757251834a37af71d610d9d566
#. source_hash: a8a217882b158866ad79c6c0be606af76b15500269e973d54c3532b31d11e055
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{number-of-elements}"
msgid "is the number of elements in the mesh."
msgstr ""

#. unit_id: 40055d0748b72819ba17e699b52483acea8feada8c5b80081a87b7ce73c1bbed
#. source_hash: 3d3b2ab81fec5b0d878c45c3675c78f037de4a9cf869d496cd53758d4b4ddaf1
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|item|@var{elm-number}"
msgid "@var{elm-number}"
msgstr ""

#. unit_id: 18cfa33572294ae00da2dcd1a8de1716586853eb287512fc09eeb75098e27218
#. source_hash: a5d048a2fa451c3cbcb68c04515ac47229039f697c3740677bcbb9a03370b8ac
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{elm-number}"
msgid "is the number (index) of the @var{n}-th element in the mesh;\n@var{elm-number} must be a positive (non-zero) integer. Note that the\n@w{@var{elm-number}s} do not necessarily have to form a dense nor an\nordered sequence."
msgstr ""

#. unit_id: 2929b7f00ab97de2e5e24546790113647ee02dab619ed09ce732c7e8c15f326c
#. source_hash: c7775c78c7243c954f84d3c5e3d66955d2e73191c5cf1d2c775c6efd2c62213f
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|item|@var{elm-type}"
msgid "@var{elm-type}"
msgstr ""

#. unit_id: 045e6d21498fad978c9c162d02c34a20d90b3801bbe0830627a410c38d5122c2
#. source_hash: 44eafade55a690be15e2d1870a096dcee895a3166b81c754c3a005521ec379eb
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{elm-type}"
msgid "defines the geometrical type of the @var{n}-th element: see @ref{MSH\nfile format}."
msgstr ""

#. unit_id: d78fc110041e00d4544575be33d6134c082273a38d0d8ffb3b49e822cad4bfa2
#. source_hash: 3ac6df498255c10bccbfd6b49e4fa5827a852699fbf0877afd2977b0c77a908d
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|item|@var{number-of-tags}"
msgid "@var{number-of-tags}"
msgstr ""

#. unit_id: b366c848b3510dd5e3da232e44018fd058c68d303dd30499bcfad35ef9e253cc
#. source_hash: a86492ed1cad1fc3918594697432246d5c553852d484b587d92739da5f17b133
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{number-of-tags}"
msgid "gives the number of integer tags that follow for the @var{n}-th\nelement. By default, the first @var{tag} is the tag of the physical\nentity to which the element belongs; the second is the tag of the\nelementary model entity to which the element belongs; the third is the\nnumber of mesh partitions to which the element belongs, followed by the\npartition ids (negative partition ids indicate ghost cells). A zero tag\nis equivalent to no tag. Gmsh and most codes using the MSH 2 format\nrequire at least the first two tags (physical and elementary tags)."
msgstr ""

#. unit_id: 5dc763e87eed4e8a3538cdaa2ece09e34319a36f4628f576f962e450dcd2b5dc
#. source_hash: 0d8b6e77039610848355432c01694525bcdb2efa91d0e52272eb399abc58cc06
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|item|@var{node-number-list}"
msgid "@var{node-number-list}"
msgstr ""

#. unit_id: 6a452510f40f48048a28a8b9537580bda91cd3603556802edcbf09337a508ec5
#. source_hash: f7f289bb70c290d5de712845ec205e73eedf2b3d8f69d3991b2b59a3c7f2ed55
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{node-number-list}"
msgid "is the list of the node numbers of the @var{n}-th element. The ordering of\nthe nodes is given in @ref{Node ordering}."
msgstr ""

#. unit_id: 261f8349fafe769da7f522127abc1c2712738bf96c2ad4a89752eb96309c88e7
#. source_hash: 0a8f8467f20263c07f4ec1a7f138760cbf1eee545b86b00b37336ff8fec60bad
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|item|@var{number-of-string-tags}"
msgid "@var{number-of-string-tags}"
msgstr ""

#. unit_id: 46a957fb63dfc6f457e2d3049bca2559847c3a7a910d4ac2a9cc760d8f6ce26e
#. source_hash: cfc9a820f51ffa24c7ad853e9ca0456e72c5f4cf851057a968e718d10d83fce5
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{number-of-string-tags}"
msgid "gives the number of string tags that follow. By default the first\n@var{string-tag} is interpreted as the name of the post-processing view\nand the second as the name of the interpolation scheme. The\ninterpolation scheme is provided in the @code{$InterpolationScheme}\nsection (see below)."
msgstr ""

#. unit_id: d875bbebb17a21212787288fabf37a74db2dad43ccaef12d11b72af06b14e489
#. source_hash: 9726819a9f363942c71b041330f11626d0599219e3b0f5c973bfc231f9a8d52d
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|item|@var{number-of-real-tags}"
msgid "@var{number-of-real-tags}"
msgstr ""

#. unit_id: d832afa212f16e97da447db198c167ce9d3558d9bc908da6b383a9d4738cf161
#. source_hash: 60fb5572b7be78d2a787aecc6dad9d11af1dc9f4276377e3300a34f9e80ae1a8
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{number-of-real-tags}"
msgid "gives the number of real number tags that follow. By default the first\n@var{real-tag} is interpreted as a time value associated with the\ndataset."
msgstr ""

#. unit_id: b4d86880c136af7204304850a23b8aee31bb07616c25d1a089fab743eca4199f
#. source_hash: 9db1f8fc15f404b4abdedae805ad565639375e82c8ad373f481735d0defa3a3b
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|item|@var{number-of-integer-tags}"
msgid "@var{number-of-integer-tags}"
msgstr ""

#. unit_id: 349f0047ddd089cdc88b0b7c7e52273a703d88bf26564d55e99b92b13920c5fc
#. source_hash: 76d47856182803f4d4a102a5f8f367ad9299f114719d6482c5050972f05fefb7
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{number-of-integer-tags}"
msgid "gives the number of integer tags that follow. By default the first\n@var{integer-tag} is interpreted as a time step index (starting at 0),\nthe second as the number of field components of the data in the view (1,\n3 or 9), the third as the number of entities (nodes or elements) in the\nview, and the fourth as the partition index for the view data (0 for no\npartition)."
msgstr ""

#. unit_id: efc523cf99bfe9cf84ca6fe196d2dfeb4fb953612fc080592521e6d8d63ea8ea
#. source_hash: b14a7c8f591ab19f140e56de4179b7122d2866c41432e75a18a2186b86775b15
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|item|@var{number-of-nodes-per-elements}"
msgid "@var{number-of-nodes-per-elements}"
msgstr ""

#. unit_id: f3e0fe4189abb7aee06533c06a74c0b334ecde03f5586664fbc4ec3fcf7aa932
#. source_hash: 617bc8531a89f60f1fd9c367d64c382db18a47c31e32035f3c7d0b4477bd21ec
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{number-of-nodes-per-elements}"
msgid "gives the number of node values for an element in an element-based view."
msgstr ""

#. unit_id: 55fc41c9c9fedf152203e1d7691f90006bcd9593caf7e4eb1a1caa64c01726aa
#. source_hash: fda8ed759df7e5fa391416555c66c5efbe250907ea87c3a80ae175d313990688
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|item|@var{value}"
msgid "@var{value}"
msgstr ""

#. unit_id: 36106b78075f9bcbf368f48eea4132e8c749b31a6f23947e450bfed080080f82
#. source_hash: 3da705ce3d035614842a2819b078dbd6605901e3e0180ce2fadc2f9059be6084
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{value}"
msgid "is a real number giving the value associated with a node or an\nelement. For @code{NodeData} (respectively @code{ElementData}) views,\nthere are @var{ncomp} values per node (resp. per element), where\n@var{ncomp} is the number of field components. For\n@code{ElementNodeData} views, there are @var{ncomp} times\n@var{number-of-nodes-per-elements} values per element."
msgstr ""

#. unit_id: 17c892bc7a7a19256ae6f2f71ed40eff0bac2329eb17a0ad4a5d89e25e6a2b9c
#. source_hash: 9e589939f5e80a6fcfda0dca7a51fdf60ea2e8db60db30e6b7263fbd6d5e6829
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|item|@var{number-of-element-topologies}"
msgid "@var{number-of-element-topologies}"
msgstr ""

#. unit_id: 654d6997abd87d2a9652f9fade04d63d3fc3a4764f7128481a74df312896f7d2
#. source_hash: 6af10c5a8b0cffe958097f4a6f91116ef2eddcf2724f1755db4943295cf8c4e6
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{number-of-element-topologies}"
msgid "is the number of element topologies for which interpolation matrices are\nprovided"
msgstr ""

#. unit_id: abcd31b58c1a0608f0ee6e174d29410a66141d0b4dac69d37858b92f39b751a8
#. source_hash: 2fa752a104484fad33e6c3924280d0d178d9bb865ff68f692c5ad3b387a72e88
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|item|@var{elm-topology}"
msgid "@var{elm-topology}"
msgstr ""

#. unit_id: 6cd589e2adc130985970a18ac1be22966d1eac377cd86cbf2bdfe64d4b1a7549
#. source_hash: bcdde527c8989f8367ba3b6e689c598420d16fb8061195e9ba5b50d983245feb
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{elm-topology}"
msgid "is the id tag of a given element topology: 1 for points, 2 for lines, 3\nfor triangles, 4 for quadrangles, 5 for tetrahedra, 6 for pyramids, 7\nfor prisms, 8 for hexahedra, 9 for polygons and 10 for polyhedra."
msgstr ""

#. unit_id: f9b8ee32717d346f3ad86723f2d1218fef6d68d4911412cd3965cbfd78f4a08e
#. source_hash: a711a232df0736422ef2714444c6c14a4a7a928b28be77530e12550ecbf198ad
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|item|@var{number-of-interpolation-matrices}"
msgid "@var{number-of-interpolation-matrices}"
msgstr ""

#. unit_id: 15a5648be5e393d625d04b52bc03cb276fac0d685e72881b506b411608973059
#. source_hash: 45aa29a86d244e50aaa4f7ca0dee1f22110f671e2ff44d1c6392d0b85a4cee10
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{number-of-interpolation-matrices}"
msgid "is the number of interpolation matrices provided for the element\ntopology @var{elm-topology}. Currently you should provide 2 matrices,\ni.e., the matrices that specify how to interpolate the data (they have\nthe same meaning as in @ref{Post-processing scripting commands}). The matrices are\nspecified by 2 integers (@var{num-rows} and @var{num-columns}) followed\nby the values."
msgstr ""

#. unit_id: 589125eb172faf2f835e91ab4c6724f7b74e04345d6456f839532aa10bc2d197
#. source_hash: c581e369bc75924d72a251c8e9af4523b18ac78d41fd214afa78457ba03f15e9
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|@var{number-of-interpolation-matrices}#2"
