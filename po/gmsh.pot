#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|paragraph|Point | Curve @{ @var{expression-list} @} In Surface @{ @var{expression} @};"
msgid "Add a meshing constraint to embed the point(s) or curve(s) in the given\nsurface. The surface mesh will conform to the mesh of the point(s) or\ncurves(s). @value{SYNC}"
msgstr ""

#. unit_id: 4c5ee0f05d1f5b3f95f5b8d26bc3aa98688caa09b28fcca56c88b8e1c2f626c1
