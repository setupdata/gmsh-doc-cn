msgid "2.9.2 (March 31, 2015): added support for extrusion of embedded points/curves;\nimproved hex-dominant algorithm; fixed crashes in quad algorithm; fix regression\nin MED reader introduced in 2.9.0; new dark interface mode."
msgstr ""

#. unit_id: 2566b7c57643b8c1a347b98040cdb8c5a2f7585008cb89774facc6af63934219
