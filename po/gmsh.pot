msgctxt "doc/texinfo/gmsh.texi|Adding a new option|paragraph|fb167b2032adaba167094e7025399bf84840089d7aca5e197281ca35f0b2a93d"
msgid "create the handling routine @code{opt_XXX} in\n@url{@value{GITLAB-PREFIX}/src/common/Options.cpp,src/common/Options.cpp}\n(and add the prototype in\n@url{@value{GITLAB-PREFIX}/src/common/Options.h,src/common/Options.h});"
msgstr ""

#. unit_id: f7fa3551e7304725c4c29d0d0a0bba52f97498243343271de6f7f8830c3496a1
