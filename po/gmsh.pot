#. source_hash: 229cade4e75ec64e5adbe05ab586c7ce1248525f37b7759f95b9198996b6f94c
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Coding style|paragraph|3e0b66589483c3507147ebc7a5f68b5943928000d9d71bf16b8cd48c0e5a2834"
msgid "See @uref{https://gitlab.onelab.info/gmsh/gmsh/wikis/Git-cheat-sheet}\nfor instructions on how to contribute to Gmsh's Git source code\nrepository. All branches are tested; make sure that all tests pass and\nthat your code does not produce any warnings before submitting merge\nrequests."
msgstr ""

#. unit_id: 8d3bf439abbdc82e8625dae203590528c601b0304cd986378fdfa77b2eff1402
#. source_hash: 4a4b61049ad4abf82e73a20a5269ddb8033d5355c5e00c0f1a523c4447e3765a
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Coding style|paragraph|05b92413a6974691e451460e89bb279042ce38df8c7e7fae30409adfb58e8284"
msgid "Follow the style used in the existing code when adding something new:\nindent using 2 spaces (never use tabs!), put 1 space after commas, put\nopening braces for functions on a separate line, opening braces for\nloops and tests on the same line, etc. You can use the\n@code{clang-format} tool to apply these rules automatically (the rules\nare defined in the\n@url{@value{GITLAB-PREFIX}/.clang-format,.clang-format}\nfile.)"
msgstr ""

#. unit_id: 1f8b9a4b171ca6dc38526aec723c8f99b56bfd419e55817be1ba4e0f594a8cba
#. source_hash: 20d215f9bc72015d4ccd392150a7b8e15bc633b8814d7c2414bbfc1bb8496975
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Coding style|paragraph|eecbc6777ef22ea9fc9598facc9d8335adb99c5b14a953849cf93c148ed5314c"
msgid "Always use the @code{Msg::} class to print information or errors"
msgstr ""

#. unit_id: 1a7dd6208622a5f908b8e9cedb921ada7861ebb47dd4acfd8208ec1b2960b5ce
#. source_hash: ddd58dd63eb1db914a0d5e6d28a5940124c765d38ba4943cf7bcf52ca16a4c30
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Coding style|paragraph|c1999a1c0df060d8d16e4585dc2ee72e3e84ed86d6b9266fb0f5de182b0fdc07"
msgid "Use memory checking tools to detect memory leaks and other nasty memory\nproblems. For example, on Linux you can use\n@code{valgrind --leak-check=full gmsh file.geo -3}."
msgstr ""

#. unit_id: 968c51d2d4b518c58b1356bffbd5b4d16d6e03c2711e10a1b26be5d4df7cbd14
