#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|paragraph|Point | Curve | Surface @{ @var{expression-list} @} In Volume @{ @var{expression} @};"
msgid "Add a meshing constraint to embed the point(s), curve(s) or surface(s)\nin the given volume. The volume mesh will conform to the mesh of the\ncorresponding point(s), curve(s) or surface(s). This is only supported\nwith the 3D Delaunay algorithms. @value{SYNC}"
msgstr ""

#. unit_id: 945091721aa43cd2c7695d67652004e033186faf81f13373b5651056b0c536aa
