msgstr ""

#. unit_id: 05b527618f9ef636e6cb00cc502a677460a52f181ee5c3dec5cac16aa0409fe5
#. source_hash: 8b7763488cc0049a86b868ddcea7f4ed6ef4800642d876e02aa65d25e548ba1b
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|paragraph|ReverseMesh Curve | Surface @{ @var{expression-list-or-all} @} ;"
msgid "Add a constraint to reverse the orientation of the mesh of the given\ncurve(s) or surface(s) during meshing. @value{SYNC}"
msgstr ""

