msgid "where"
msgstr ""

#. unit_id: b69c794a051c27bf1dde4e8d0c0bfbc98a397ed0d25a64b5f607ce8baa69d510
#. source_hash: 48561a1b612e9643f0b0bca76f5fb5bca9c354b1ef2ba6b676d8df8a561fcbf8
#: doc/texinfo/gmsh.texi
