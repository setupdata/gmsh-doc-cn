#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.12.0"
msgid "2.12.0 (March 5, 2016): improved interactive definition of physical groups and\nhandling of ONELAB clients; improved full quad algorithm; added support for list\nof strings, trihedra elements and X3D format; improved message console; new\ncolormaps; various bugs fixes and small improvements all over."
msgstr ""

#. unit_id: 150be1a29e71937f303bc468b0e1a675190503a6801e0db9dd99a4c2c998ca43
