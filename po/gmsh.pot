#. unit_id: 45feed82bf723445c8b09ab79e53a819a07ac766320641edc0c78414c7a30eff
#. source_hash: a265851d53bf250c0ab66616cd3a8736a53158b5c372c8ce27bfe820cb1575bc
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Comments|paragraph|22ff4fe85cb76bb5e7f1da2aad0ffc94b7438a3654242359ff1ea2552e683b2a"
msgid "Gmsh script files support both C and C++ style comments:"
msgstr ""

#. unit_id: 22a2b1d7d2c6968fe0277a92eaad579e13f1bbd6f294a47be6dfcf3d3b0b6320
#. source_hash: 1606aedde9be93ec1a6eaa80e86d515eb54ced3db3f259eac109bcaf44a6a7a8
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Comments|paragraph|ac00770cb08126041f32636edb3b7ce9040901f51bef55f975866b8dd2d3e26f"
msgid "any text comprised between @code{/*} and @code{*/} pairs is ignored;"
msgstr ""

#. unit_id: b575bf6abc14ef887d6ab3603dedfd1787cfb2d6e3e03dcbb28458eeec9b483c
#. source_hash: a3e7338b2627db41d4583d5ca48c2f1c6498ea0b07971f4ae9b21dbb8d3b9044
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Comments|paragraph|b480558ae0151dbe5da077f147fbad840d9389fca3c61ccb23e3598c92b88218"
msgid "the rest of a line after a double slash @code{//} is ignored."
msgstr ""

#. unit_id: e4f11ad571893c628c46b7b3f076b07e6266ec9876a47360151917d9fae3a8e4
#. source_hash: 8206e8a115dbb2c3d1576a00a876abf8b92ec8d238d875067f11197a04656c33
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Comments|paragraph|154d19b9c46908cb54e6555a85d6ee5e01a9283c65d672ab6c54e6f0fbdd6dd3"
msgid "These commands won't have the described effects inside double quotes or\ninside keywords. Also note that `white space' (spaces, tabs, new line\ncharacters) is ignored inside all expressions."
msgstr ""

#. unit_id: c58a5ff5aeb6059bda657a0d89d8600d2ad5a9088c8fe178864b7addfe5c581d
#. source_hash: ba23fcdafe1b99aadd28898c2de3c52a9aa33d1f471437dc7467eb0cd864a40b
#: doc/texinfo/gmsh.texi
