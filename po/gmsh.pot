#. source_hash: 88d038163709ee41f281c923a111f11501d75210e8bfb7b9919e0c551594037f
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|39ba97be20ae2a63cb510e7227c99401bdd68a3c909967dfe02f0e3a590b4df2"
msgid "35-node fourth order tetrahedron (4 nodes associated with the vertices,\n18 with the edges, 12 with the faces, 1 in the volume)"
msgstr ""

#. unit_id: 66ad614731d32d54828a455740ff1b42b48e51a3b1ce125f6717299c911b7070
#. source_hash: be74525d3b00297d129d85039e07e766068912c9a23c675f979bef6d692ce0c4
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|1b630436e24cd21dfe1f43592cfb97ae24eec865b0840068edde7475a6c798ac"
msgid "56-node fifth order tetrahedron (4 nodes associated with the vertices,\n24 with the edges, 24 with the faces, 4 in the volume)"
msgstr ""

#. unit_id: aa9d60cb1b83965220019b7387e0ba2135a17e4de71ef4c53fb1d9e57a4642b7
#. source_hash: 81c60837dd6e606eb6f181a4d917d034e0091c023e3516fc91d2294902b8066a
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|22e9efd608283913a7ff808fafeee52c4c7173ab09b8598dd8b38ce45c4e7ea0"
msgid "64-node third order hexahedron (8 nodes associated with the vertices, 24\nwith the edges, 24 with the faces, 8 in the volume)"
msgstr ""

#. unit_id: 6d9e125db069f6cc54eacdd3f7e3b346d62db4eab0758a6d5564bfb758684372
#. source_hash: 68bd5e32292e97b9e82fea7779bdaa905120c6ad0d2b5042531ef448bb7440d8
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|3502f41510892e5e9ee87bf1c69ed313409c793ba0119431fb7a9bc863d0609b"
msgid "125-node fourth order hexahedron (8 nodes associated with the vertices, 36\nwith the edges, 54 with the faces, 27 in the volume)"
msgstr ""

#. unit_id: 95a31566cf591b694470d072856e52d9d36f609d75813b39ee2d3aa7186288a3
#. source_hash: 8afd399d6a739e8f158a6b854ff66c020c387ef7e82e9e07fabec0e3e7b3d23e
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|1f2889435a356f207c3dc980079731631e99bca86e26305655ad0a2bcdbfcdf6"
msgid "All the currently supported elements in the format are defined in\n@url{https://gitlab.onelab.info/gmsh/gmsh/blob/master/src/common/GmshDefines.h,GmshDefines.h}. See\n@ref{Node ordering} for the ordering of the nodes."
msgstr ""

#. unit_id: 0de866e37509fa00e2bb263d3d6954cbeada650ed1b5d2251662d529361518e7
#. source_hash: 06f86a9858e8c95fe1b703b786a56365dd265125e1b45f76ea83650d97341857
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|c5b8fcaac7acbfabddb6e32a1ee3ab31bd13963cb610939b5c75b0697e49a018"
msgid "The post-processing sections (@code{$NodeData}, @code{$ElementData},\n@code{$ElementNodeData}) can contain @code{numStringTags} string tags,\n@code{numRealTags} real value tags and @code{numIntegerTags} integer\ntags. The default set of tags understood by Gmsh is as follows:"
msgstr ""

#. unit_id: 28ad5f7e31060d177cdc3985452b150461e3469c322b59d4ee79f2fd949a1c08
#. source_hash: 83ff969e5c55fa6e53c4e720cdd33f7e656f53e704adb802ff9e93729225281a
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|item|stringTag"
msgid "stringTag"
msgstr ""

#. unit_id: bac1e6dbb9c12f1f8e523cf276d26e402d0d64dbafd1c845586cd9e725d8abec
#. source_hash: 6e02fa87bdf2db431a90709d271eea9c232a6ebc92d9f2d0746abb5477a6b933
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|stringTag"
msgid "The first is interpreted as the name of the post-processing view and the\nsecond as the name of the interpolation scheme, as provided in the\n@code{$InterpolationScheme} section."
msgstr ""

#. unit_id: 6c58bf3c886790dbb611ce73f547c05d0ea14e66674f2fad01ce0f45874d970b
#. source_hash: 3a2ff677d7d85385a50a9a2419a4295258e20f9cbd66974fd3ffe40875945620
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|item|realTag"
msgid "realTag"
msgstr ""

#. unit_id: f371dcde8ee1c34a65048736bdbd6e00187e993a9a1cecce6f559461b18dc5c3
#. source_hash: 6c2cc4eec76c06d5841e1bb87f331967fb4ded79b50d70cdacdca2ea7d083754
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|realTag"
msgid "The first is interpreted as a time value associated with the dataset."
msgstr ""

#. unit_id: 854a6aabf4bafea2f97e779b56a929e55d1846870ff4228da0f89707c7f72681
#. source_hash: bf104dfc81d24cc7e1070fbb0bbd95bde44cf5dcc802160276ec5cb0230b2ad3
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|item|integerTag"
msgid "integerTag"
msgstr ""

#. unit_id: 18db21068feba87b73ca09c6f48a98407cd41d9ac5ac5f733f8b00f516f49623
#. source_hash: f79dd3ea69b675ebd14c3731dfe0f1993a4868b9af12adb04087d5d03a9814cc
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|integerTag"
msgid "The first is interpreted as a time step index (starting at 0), the\nsecond as the number of field components of the data in the view (1, 3\nor 9), the third as the number of entities (nodes or elements) in the\nview, and the fourth as the partition index for the view data (0 for no\npartition)."
msgstr ""

#. unit_id: 621c420169d3b7b40a54b2f252bf793464fba08816dc75a714b4753213010c2f
#. source_hash: a3c79b35382e00844ba42f62dbff39c7d4d0ce86e3bea23d81e2e9022a77e913
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|integerTag#2"
msgid "In the @code{$InterpolationScheme} section:"
msgstr ""

#. unit_id: 6a3cc0415f9024a081242094ba4e5859f3510e3ff045dcbde09e54aba1a8399c
#. source_hash: eb34b091ef8e1e482f775ea2a14ba7398597c0f901e66610577e92fbc0588e57
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|item|numElementTopologies"
msgid "numElementTopologies"
msgstr ""

#. unit_id: 79278ca76ddb8b2169a35cd3291ee61ea433e8dfc4a901edf55435bf143fd29b
#. source_hash: bdae58a72fbd4c5703630c1029147d09d7d19aba48958b78fc19165a83cf0ddb
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|numElementTopologies"
msgid "is the number of element topologies for which interpolation matrices are\nprovided."
msgstr ""

#. unit_id: 67d5576ecd4576714ae164c0dc5cb998d5c221c1d80593e9006e02467aa8a386
#. source_hash: b44e683e5191846020398b6a6f48ce39e2eb386448ab2035061980293ed527b2
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|item|elementTopology"
msgid "elementTopology"
msgstr ""

#. unit_id: 274cbf47ae2d85ee9df28662be03453e6918fbeedfd2f63387fec4ee048e368c
#. source_hash: bcdde527c8989f8367ba3b6e689c598420d16fb8061195e9ba5b50d983245feb
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|elementTopology"
msgid "is the id tag of a given element topology: 1 for points, 2 for lines, 3\nfor triangles, 4 for quadrangles, 5 for tetrahedra, 6 for pyramids, 7\nfor prisms, 8 for hexahedra, 9 for polygons and 10 for polyhedra."
msgstr ""

#. unit_id: 9e21809f5626fcad733fe73c570c3d5a1a57252752d6e423de1aaa24bfb04cad
#. source_hash: e5763a34af046f6a836b78b0118f588c91c359e1778454ea553feb4edb23fcc3
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|item|numInterpolationMatrices"
msgid "numInterpolationMatrices"
msgstr ""

#. unit_id: 5827398c1c1ff6029e582a92e6804a9939d72cdcf1cc3d70ba320eb8389c86bc
#. source_hash: 5c7de2a2e45975d907401a1f2578e67ec0ad1e9c249afb4c055959a772b419b2
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|numInterpolationMatrices"
msgid "is the number of interpolation matrices provided for the given element\ntopology. Currently you should provide 2 matrices, i.e., the matrices\nthat specify how to interpolate the data (they have the same meaning as\nin @ref{Post-processing scripting commands}). The matrices are specified by 2\nintegers (@code{numRows} and @code{numColumns}) followed by the values,\nby row."
msgstr ""

#. unit_id: c480cdc4586dc7181152fd8255f4fa7386526d7e3a97bffe3cb2823cd04c49ce
#. source_hash: 55da0eac6878fbd0efabcf44c37a6bfc6634995cac041b3e2377e24ae954cb8e
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|numInterpolationMatrices#2"
msgid "Here is a small example of a minimal ASCII MSH4.1 file, with a mesh\nconsisting of two quadrangles and an associated nodal scalar dataset\n(the comments are not part of the actual file):"
msgstr ""

#. unit_id: 0987ea4c2f0e03d9950f80066d2b16a64862cb0e42b4f7ba5b3542ed00c4dce4
#. source_hash: 57e8120c3ce8993d21ca854beb5eefedb5eac6810dc8570b15d879347f0648da
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|numInterpolationMatrices#3"
msgid "The 4.1 revision of the format includes the following modifications with\nrespect to the initial 4.0 version:"
msgstr ""

#. unit_id: 6be7750248a79edcb5abd3812c53624c257b74c99d17efa9d9a88cde22cff974
#. source_hash: f8d1b9dfa38cbbd0455a3f318c1f9cdb09c39f3b2ed452efd55c7fe619a52de4
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|833b3549923f9708dab675dba0b386a2d7bab4a58a03e9b0cfb492b8fe801afd"
msgid "All the @code{unsigned long} entries have been changed to\n@code{size_t}. All the entries designating counts which were previously\nencoded as @code{int} have also been changed to @code{size_t}. (This\nonly impacts binary files.)"
msgstr ""

#. unit_id: 7af3b647843c42a7524386d6f0babad3b2c89d7ff9ca7b47ac323e43bd9858ef
#. source_hash: 6cb44d3d2b02074df8da2cbdcd9a01630fb4426732c4ba84de0eaa0963da7d2a
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|7eb9c2f8bb56391ea3aea78ebd8b0a90560f16eaa10aaf4f33976bb6f1e1c36b"
msgid "The @code{$Entities} section is now optional."
msgstr ""

#. unit_id: 23242ad00dad309ee89acc3144de80d4801c6ec0150b42e7225e3325962eca19
#. source_hash: be64c692e5da91496124202108644f67da0a86b29a1cb4a6cecfb7b2a91748ed
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|1e9aa603dfa5a5c14615399d09acda5620e8273a4320ddf823ee45eb3b1175a5"
msgid "Integer and floating point data in the @code{$Nodes} section is not\nmixed anymore: all the tags are given first, followed by all the\ncoordinates."
msgstr ""

#. unit_id: 9f61cac99d77c654a91df260461b47d25d5c42c1aee18134e79035cd362853b7
#. source_hash: fd220ab6db00ad07caee45e7d61461b964ac40ba4b4dba64de61a4930dd0165a
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|d1d555a1727177294b4d803bf104ee11a82d72249b8ebe1956381a372c459a39"
msgid "The bounding box for point entities has been replaced simply by the 3\ncoordinates of the point (instead of the six bounding box values)."
msgstr ""

#. unit_id: 6a760126a5bc9bd5aba0bae7f3a03248786328eebaf226dc8fc7357f5f98bbda
#. source_hash: d0c4b391c2850c58f032c781e3ea9575b655b680a242e09cf89743ad5cb65ab6
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|1144889f2a18d7ea43844aa06e0498f649f5d20bda6652d182267afc2654fc5c"
msgid "The @code{entityDim} and @code{entityTag} values have been switched in\nthe @code{$Nodes} and @code{$Elements} sections (for consistency with\nthe ordering used elsewhere in the file and in the @ref{Gmsh application programming interface})."
msgstr ""

#. unit_id: 02376696a0a0a577af63caece06375ce46734f01c412a5a74b80311a4979526b
#. source_hash: f27a1c01f5f41ee7af63cc734185783a2ad2a477bf158bf2194037836709f1ad
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|c2a5c7f684d4e74a291f04f9af8e887caad4a83ae10a760e4cc2ef203cd7fb39"
msgid "The minimum and the maximum tag of nodes (resp. elements) have been\nadded in the header of the @code{$Nodes} (resp. @code{$Elements})\nsection, to facilitate the detection of sparse or dense numberings when\nreading the file."
msgstr ""

#. unit_id: 08240f820530cb05591754af316e8ec96b6f750de5cfcd8a82dfe0ab2a69157d
#. source_hash: 5342bd70d1a86d7d63d386a63921bd40bfd731ded33be2e46647aa22b65f5bf0
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|f549b33ca7c58f6c82fcc668abd0eac469189001a66d18fb71064f6712e9b8e1"
msgid "The @code{$Periodic} section has been changed to always provide the\nnumber of values in the affine transform (which can be zero, if the\ntransform is not provided)."
msgstr ""

#. unit_id: 07fd7e73e467719286c286091c0c15cced0ea27b891a532e740f2c1a4bfe0932
#. source_hash: e531c0b2ba33326c0e23edc6e225e1d9a01ad32d8b97a252e612cf32913eb7ad
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|097f493e2c5419d4bc21964da6051461a7bd8368337b59aad28a77ef01e34969"
msgid "The following changes are foreseen in a future revision of the MSH format:"
msgstr ""

#. unit_id: 8171ef38672da23966143e23a8db3d2c4581ff8cae8e1ed179053497e8139665
#. source_hash: b85d9f1f2127e903a2e296dbc330c43b21b16d8e502c550c7977bc5b5f926964
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|36feb9181219467dc1178a96a2991674b850c3bbf44705685c05b6f874189442"
msgid "The @code{$GhostElements}, @code{$NodeData}, @code{$ElementData} and\n@code{$ElementNodeData} will be reworked for greater IO efficiency, with\nseparation of entries by type and a block structure with predictable\nsizes."
msgstr ""

#. unit_id: 47eea64fe4759d412887e560831a00b5aac9f735f2ae3f59017db7e294f9370d
#. source_hash: 84db80b6e13df8e7505f2f662956bf556f935499e2c887f5614f5cbd85721442
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format|paragraph|5e4b46795cd55db2f0fc2cadaaf3c4bf1bd544f94400a1596ef1d6a12014e742"
msgid "Node and element tags in @code{$NodeData}, @code{$ElementData} and\n@code{$ElementNodeData} will be switched to @code{size_t}."
msgstr ""

#. unit_id: 8f3396daa4969f266cecdd3244a35e20eaae6dd86c81f2dfda479e15b0bd3b37
#. source_hash: 8d0de0818ac500eca03fa770b0c50b671aa06dbce63ad70fc22671aaf562e0a0
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Node ordering|heading|Node ordering"
msgid "Node ordering"
msgstr ""

#. unit_id: cb81559c8f3d37fa24d25ea9a97036b6e04c8e6b81a23aae1b7b7e93b2d237bc
#. source_hash: 24d9af9bf4f4da72d95b92d7ca8b3cf4f3850538d11f72b77be2967c8b1c91e4
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Node ordering|index|Nodes, ordering"
msgid "Nodes, ordering"
msgstr ""

#. unit_id: efa58d943d27a0613d55391bf5b98afb1ff086fda7b57bd319757031ad446298
#. source_hash: a676b1a27368ca759916e97c9a1da01caf6f04c95039376353cd01379b0b3127
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Node ordering|paragraph|7b6527abbff8098d96141a25bfde4862161a78fd3b5ac120446192731103a50e"
msgid "Historically, Gmsh first supported linear elements (lines, triangles,\nquadrangles, tetrahedra, prisms and hexahedra). Then, support for second\nand some third order elements has been added. Below we distinguish such\n``low order elements'', which are hardcoded (i.e. they are explicitly\ndefined in the code), and general ``high-order elements'', that have\nbeen coded in a more general fashion, theoretically valid for any order."
msgstr ""

#. unit_id: 93e61f63d124645f30ede457ffc8cf88730c5a7fd710e3bf05f29d19294136b2
#. source_hash: 46f7b201eed34835b0ffcf6dc152007bd8a33d83b3c751ee58eeacf63d5565ae
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Node ordering|heading|Node ordering#2"
msgid "Low order elements"
msgstr ""

#. unit_id: 9ea41fc9252f4d75ee289cc445dd198a0ad4752f1f2be848013612c60078643d
#. source_hash: 98a639a47efa82fa2167615fa11dea9ac9f418fdcc9864b1bb6676b7052a404a
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Node ordering|paragraph|827a582fbf8891cdfeafc4119b8215ab189d9410f1d2c6b473a367063e604ede"
msgid "For all mesh and post-processing file formats, the reference elements\nare defined as follows."
msgstr ""

#. unit_id: 9732078a118e02a0dc8453da3473f1d375ad15fef691e0e873c92a63cfd7bbca
#. source_hash: 8b7c1742e07c97deb4f9bb3cf8bee70f3fb516518647ffe1757db00b8e163f9c
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Node ordering|heading|Node ordering#3"
msgid "High-order elements"
msgstr ""

#. unit_id: 8ef6cc4b81c25c360667921dca4490579e61c3aac1bf569ac9f9f664ea6e6b2e
#. source_hash: 68096ffc06296eac91c3eb3ecf325d40b4ca53a92e3b6af5e16b77826d910dd1
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Node ordering|paragraph|0f1032ded613e5daa3867070e19c104cd7de436765ab0b444958386b1083d654"
msgid "The node ordering of a higher order (possibly curved) element is\ncompatible with the numbering of low order element (it is a\ngeneralization). We number nodes in the following order:"
msgstr ""

#. unit_id: 065eaf382b7b489e6469a1d0e0ac8c75bd3b18a86b3ded22ad63b4c171b5a01d
#. source_hash: f377b1fb777dbf44b9c929f77f77ecaae51d39854553029f7a0e60d2d0bd7751
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Node ordering|item|the element principal or corner vertices;"
msgid "the element principal or corner vertices;"
msgstr ""

#. unit_id: 9e0aa983567f4fc1e02e4e7ffea929f13b05bd5e05b016f806f912f67f5e1722
#. source_hash: a6590bf18150b80b58d957c8870e3764f846ec605f13851ce67c8d23ef93dc09
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Node ordering|item|the internal nodes for each edge;"
msgid "the internal nodes for each edge;"
msgstr ""

#. unit_id: 85f70d990f44331367f01b0d3320f8a9fd3db9dc28a0fea24bd999c695ef4709
#. source_hash: f51f9fa94e451e91c03a1220c7502b8bcf84f30863af5b993e29347e9d9cd86c
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Node ordering|item|the internal nodes for each face;"
msgid "the internal nodes for each face;"
msgstr ""

#. unit_id: b08c025c9a912473973126bb1c7f6e8c4898ed9dfa65eb3741a0ddec408ff5d5
#. source_hash: e5d0792de99a78aeafb545a4ee2086450f354d45f347376e93a7112c83115b5b
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Node ordering|item|the volume internal nodes."
msgid "the volume internal nodes."
msgstr ""

#. unit_id: 20b30bd4657eb8ad366113c9a1478bc677d942437cf1c18551577209341708f2
#. source_hash: 74fc103a51dac669fc836bed43b495ef38242089c2bd90fba0726b391c871f55
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Node ordering|paragraph|the volume internal nodes."
msgid "The numbering for internal nodes is recursive, i.e. the numbering follows\nthat of the nodes of an embedded edge/face/volume of lower order. The\nhigher order nodes are assumed to be equispaced. Edges and faces are\nnumbered following the lowest order template that generates a single\nhigh-order on this edge/face. Furthermore, an edge is oriented from the\nnode with the lowest to the highest index. The orientation of a face\nis such that the computed normal points outward; the starting point is\nthe node with the lowest index."
msgstr ""

#. unit_id: de1d229f60cef80968bd0cf3e074b74e84d0db962aeaf172a8bcb7fcbeae4369
#. source_hash: 3a5ba857ce09eca02415fcbe5f5c82735de56f3e18ee9e9a6b6f22aab1793bcf
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Legacy formats|heading|Legacy formats"
msgid "Legacy formats"
msgstr ""

#. unit_id: b0913c51268e2ce8ef720caf0bf58349c5e46d70c86789909bbd96e03e131871
#. source_hash: 13f2f3104d5bbd9e3e569fcad250b13ed944c1a3ec77a85db1bc612db7ae119d
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Legacy formats|paragraph|0fbc13d4e76822484a8e41f8843d6109d36c54021cd7a070924aa1678e40e9ca"
msgid "This section describes Gmsh's older native file formats. Future versions\nof Gmsh will continue to support these formats, but we recommend that\nyou do not use them in new applications."
msgstr ""

#. unit_id: 94a1665d3da6841dafb698e6762e167f82a1aee7b8a69ecb819b1ced815d5404
#. source_hash: bd87a88f2ab21a284ea969eb5ca5e2bbaa7e802343514a186e655e9327c551a3
