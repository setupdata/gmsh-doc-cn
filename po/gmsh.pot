msgid "Recombine Surface @{ @var{expression-list-or-all} @}  < = @var{expression} >;"
msgstr ""

#. unit_id: 59ed2fd7893222c8141043b52eefdeac0ab257e44be9f7ccd6e6b6d070584eb4
#. source_hash: 76dd3bf0b7bf59063dea8cfae47a960a6e3dd9037c5e6176bf230ccfb30c7fb8
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|paragraph|Recombine Surface @{ @var{expression-list-or-all} @}  < = @var{expression} >;"
msgid "Recombine the triangular meshes of the surfaces listed in\n@var{expression-list} into mixed triangular/quadrangular meshes. The\noptional @var{expression} on the right hand side specifies the maximum\ndifference (in degrees) allowed between the largest angle of a\nquadrangle and a right angle (a value of 0 would only accept quadrangles\nwith right angles; a value of 90 would allow degenerate quadrangles;\ndefault value is 45). @value{SYNC}"
msgstr ""

#. unit_id: e0ec3975aef151682c12e8d73b342a0883590191989deae23fa9c8c0f3b9612c
#. source_hash: 67208549c111a704eca83efbee34328dc1afbd9bd7ca53505645be43575f99ad
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|item|MeshAlgorithm Surface @{ @var{expression-list} @} = @var{expression};"
