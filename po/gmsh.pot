msgid "* New API functions: model/isEntityOrphan, occ/getClosestEntities"
msgstr ""

#. unit_id: 92719ec999a4b647069b621f9cfdc7cd29eb07da6031be52b5de2c859791d8b8
#. source_hash: 10aeac4501bbd97541ebdc8dc2b7f5e982c7f989589e5b54c863bc489579786f
