msgctxt "CHANGELOG.txt|Version history|paragraph|8e8479b92d16de797f795d4dc1841056a0e4d75c6e4759683c09c6c4169d64e2"
msgid "* Incompatible API changes: new arguments to algorithm/tetrahedralize and\n  fltk/run"
msgstr ""

#. unit_id: 72b2d23a5b531a9604670e962d07b24cc53ad2de0f821f2efb582123f5c8882c
#. source_hash: 35de501f4ec109bfc38eba5cae2fc765a4492c182e24fc01ddeac40a0a4e66da
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|4.14.1"
msgid "4.14.1 (September 2, 2025): further improvement of return value of boolean\noperations; bug fixes."
msgstr ""

#. unit_id: 59ce14117210ed4d4594ebfea945e45eeb4b513ce1f90e6655da8e2fb560b737
#. source_hash: a73dd27e52e679981706f040bc4d1e23fc75a960c6b01d7a58e0194431ae14be
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|4.14.0"
msgid "4.14.0 (July 3, 2025): improved return value of boolean operations; improved\nONELAB parameter GUI; improved XAO export with mesh sizes; improved unrolled GEO\nexport to handle OCC geometries; new Step() built-in parser function; fixed\nocc/getClosestPoint for OCC surfaces; renamed Windows DLL import library from\n.lib to .dll.lib; official binary builds now use OCC 7.8, and Linux and Windows\nbinary builds use FLTK 1.3 (instead of FLTK 1.4, which introduced performance\nregressions in OpenGL rendering); bug fixes."
msgstr ""

#. unit_id: 4e039242c11c71908bf9c9c3226a6a18b0aa415c9b2d1466fc7e942f88cb1fbd
#. source_hash: 286d9b8bfa67b7b2c50538094f2704a1a776acaa64aaa3814365789c8f513820
