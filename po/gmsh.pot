#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Specifying mesh element sizes|index|Mesh, background"
msgid "Mesh, background"
msgstr ""

#. unit_id: fc0aaf5868f4bf37764163c47523f54c3a19ed9fc64edb64480f7883646fbb7f
#. source_hash: 510daefea388c2687a0942df88b1d5174ac9e19c8e1e6195687f88a1b4d7bff4
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Specifying mesh element sizes|index|Background mesh"
msgid "Background mesh"
msgstr ""

#. unit_id: c9499696eb76c2181f4c27474710cfed8ee4694572078e64997ac63100a494d9
#. source_hash: 5db32038cdeb84d44bf02154565c77c01d4c32bbae863d939082da20aea1b00e
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Specifying mesh element sizes|paragraph|37c0825c744a0a82ff77be8a364b121279d05b2b180e3b7d6afccd5b4fd7eceb"
msgid "To determine the size of mesh elements, Gmsh locally computes the minimum of"
msgstr ""

#. unit_id: c58611339605040df02ed2102bc17bb3a5a22b997d8615876c463f5b5c7aa4e3
#. source_hash: 41beedcd74280755c03c2f50063d4bcf2eaf2760b4e3e406ad95671c68348743
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Specifying mesh element sizes|paragraph|42ba7f280544787c5055b942c73f0997d7bd6fb510294cbf60c4ac5c31fecaf3"
msgid "the size of the model bounding box;"
msgstr ""

#. unit_id: 16fe5416fea81b60d4d0705adb3aba2385350b82d8667b8ec304f2bd38096ea8
#. source_hash: fe4f41bc926b70d4a431771881ba05597eff0fb34fc9f77585cc662015011f54
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Specifying mesh element sizes|paragraph|255d415902584ca3d9f585c5b637487e59956f444f10b5b9db53c89c0b0f3c36"
msgid "if @code{Mesh.MeshSizeFromPoints} is set, the mesh size specified at\ngeometrical points;"
msgstr ""

#. unit_id: b63714ab0e733e4deaf02851c77de28926e29d554060dfe77251c0d18205c18c
#. source_hash: 7c798a664108bc6c1d1bad11f81e4b434c4f242254b45d2ecb6cab63cae31fd1
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Specifying mesh element sizes|paragraph|171a4a39b1de4230045fdf68b604c9d5a34e4dfd87cf1fa529a7811ccd36ce73"
msgid "if @code{Mesh.MeshSizeFromCurvature} is positive, the mesh size based on\nthe curvature of the curves and surfaces (the specified value is the\nnumber of elements per 2 Pi radians);"
msgstr ""

#. unit_id: 76fea186b72268dd2e6c0812feac7828535bb1775b122bb6095a2a42502366f8
#. source_hash: 94cf384d1ec7fdf4e85085cff66cbcc8830ca6ee1a823e9de9d752cf7028cc71
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Specifying mesh element sizes|paragraph|ae212c2020b796a116b9e715d32ff189040dcd929812052a573a12fd1568b99b"
msgid "the background mesh size field, expressed as a combination of mesh size\nfields (@pxref{Gmsh mesh size fields}):"
msgstr ""

#. unit_id: 2f74b6c916776707767cd42e722771d81d957876fc72d5a6e5c4f6a84f1ab776
#. source_hash: b55cabf269316e3f2c051059bf78db014549aa8789b1c4f4b525a49dcca4d85b
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Specifying mesh element sizes|paragraph|21ec291790c2b0de480db59db914ff348278b2e9bf3594bd78ed29bcb03f3a0b"
msgid "@code{Box} fields specify the size inside and outside of a\nparallelepipedic region;"
msgstr ""

#. unit_id: a03c42b86000c74f4ff8160b827844ccb8067672010a850d7aef9783fadc0614
#. source_hash: 90324743af061356c7642eb3245bfd1b95a441bcffb75b8be0ae834b1d886666
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Specifying mesh element sizes|paragraph|3e639ce329ee75daf7cd62dfb83503a7c0b8c8d6581597d0dc9f4cbc291d2b7c"
msgid "@code{Distance} fields specify the size according to the distance to\nmodel entities;"
msgstr ""

#. unit_id: 7b260d05d1c220db3f736dee30b0073aed9631096581db7b0209261c8df6ae57
#. source_hash: fcafd4896d211d09c69c922b4ad937c7034cd1c74e5ac37745fb9e0f9395b41e
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Specifying mesh element sizes|paragraph|2e34be781e13567a908cffa4fbb2949de7e2a6905946049afb217757206dddef"
msgid "@code{MathEval} fields specify the size using an explicit mathematical\nfunction;"
msgstr ""

#. unit_id: 693a89dc95539a5cf1c4049e21df391b2f81d768e422f3944dda97e1ab5cee2a
#. source_hash: 3b7f6c07d31d85c640f14c62ddcfb69293c8530219e1067d3226e696af88a7eb
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Specifying mesh element sizes|paragraph|9f58196cb4516850e1ea2aa64c4661dbc30ed8b17a865d51ce7b18f7d4e667b5"
msgid "@code{PostView} fields specify an explicit background mesh in the form\nof a scalar post-processing view (see @ref{Post-processing module}, and\n@ref{Gmsh file formats}) in which the nodal values represent the target\nsizes.  This method is very general but it requires a first (usually\nrough) mesh and a way to compute the target sizes on this mesh (usually\nthrough an error estimation procedure, e.g. in an iterative process of\nmesh adaptation);"
msgstr ""

#. unit_id: e0624d0c2f35f889f371fa15e91bba9ed01ef8aca7d47d8d6897c5ca6e1233bb
#. source_hash: 0a67ebb70ad09dcb6d7adbf06094c67294f7dbf5c9b856d0249fedddbd2a6c53
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Specifying mesh element sizes|paragraph|f28027e2f3263f0deaa2047ba89fd755a1c5dc858f6b26d8f16c1786fa68c5ec"
msgid "@code{Extend} fields compute an extension of the sizes from a given\nboundary entity inside the enclosed surfaces or volumes;"
msgstr ""

#. unit_id: 9e7434d2a9786c825493be2a80c32d3e394f281a123330ba286d141fa2121d18
#. source_hash: 75204f187c3efb65314c59faa0e15f5609d51e0c1db728e100bc2a1a45f35770
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Specifying mesh element sizes|paragraph|8fe8b0fca71b5307580e8c14e975c09a8c9acb7901000636be731e43fdeae673"
msgid "@code{Min} and @code{Max} fields specify the size as the minimum or\nmaximum of the sizes computed using other fields;"
msgstr ""

#. unit_id: 0088889d9fda76c918c419369b8b7b2215a6431c78b65eecdd20989e16e97f13
#. source_hash: bf729b72a74ee4bb97980549fbb3a64bcce6d3653a57260762cd938cf6bcdc71
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Specifying mesh element sizes|paragraph|fa38524dc4a747de0bdbf3288bc68ae92887b8e608e83c61a0116d7fa888411d"
msgid "any per-entity mesh size constraint."
msgstr ""

#. unit_id: a9ac67ae24a2002110ac3ca1a6213972f5ab7c7224e38cadf852e464b06a987e
#. source_hash: bb0f4fbfabc5f03736fae05bba1ab46fc34dc2e5738171a28375adbfdcde793c
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Specifying mesh element sizes|paragraph|8dbf37707c9d850dfde24bf3f01dda819c8ba6b81667ded4452767208553a0f2"
msgid "Using the Gmsh API, this value can then be further modified using a C++,\nC, Python, Julia or Fortran mesh size callback function provided via\n@code{gmsh/model/mesh/setSizeCallback} (@pxref{Namespace\ngmsh/model/mesh})."
msgstr ""

#. unit_id: dcfe061889390b11374d72e23879d5e257a58766e061321ae06da05cc418f95c
#. source_hash: 4dfb34c9c47957a3ea8fc81a0a9c9e245a2f9254f4100dfef3a7809d8f85a699
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Specifying mesh element sizes|paragraph|463b40f5e3a81a5bfd6b259f5f7691983bc5309c91cfb53a0058db6a0fa047ba"
msgid "The resulting value is then constrained in the interval\n[@code{Mesh.MeshSizeMin}, @code{Mesh.MeshSizeMax}] (which can also be\nprovided on the command line with @code{-clmin} and @code{-clmax}) and\nmultiplied by @code{Mesh.MeshSizeFactor} (@code{-clscale} on the command\nline)."
msgstr ""

#. unit_id: 2883d9340f7f84142775b4973878aa6dcd753d6bae690f785b0972072fdd1036
#. source_hash: 4133f318e3e00c00e7640b81734c1c7ededb55b3c9fed2d0a0e732c52ff73a60
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Specifying mesh element sizes|paragraph|d54375d880593df88d6bb06734ab6440eeac37fb0377bc7e313346a2717be4a8"
msgid "Boundary mesh sizes are automatically interpolated during mesh\ngeneration inside surfaces and/or volumes if\n@code{Mesh.MeshSizeExtendFromBoundary} is set (it is set by default; see\n@ref{Mesh options} for the default values of all the options).  If only\nspecific parts of the model should use a different mesh size\n(e.g. refinement of the mesh along an edge or within a fillet/surface),\nyou may want to set @code{Mesh.MeshSizeExtendFromBoundary} to 0 to avoid\nunintentional refinement in nearby entities. Typically, when the mesh\nelement sizes are fully specified by a mesh size field, it is often\ndesirable to set"
msgstr ""

#. unit_id: 98abcddd3d55ee4c32e78c88838d8d9496f4ef46467bb51f6b95a9ae196e7788
#. source_hash: 2c3cb295604bc13f2be62501b37320de323d99bb7f423a011d58cde547e44d43
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Specifying mesh element sizes|paragraph|1603ca459943a5be274de8d951ee59e91aaaf21aa0120c56a1a871ea4f460ec1"
msgid "to prevent over-refinement inside an entity due to small mesh sizes on\nits boundary."
msgstr ""

#. unit_id: 23827535d771e33529885948519300513d4f2f363b16b6f1d4f439a869a42d37
#. source_hash: a5f0e17b8252c888b7df13fb2eda0f1ed00e9eb3b198123e8839de084d2215c8
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Specifying mesh element sizes|paragraph|1561728438b992aa464ac7c80adc9d0102ea7cc7fe203e2c21d1f02dc5b9c540"
msgid "In all cases, meshes are constrained by structured meshing constraints\n(e.g. transfinite or extruded meshes) as well as by any discrete model\nentity that is not equipped with a geometry (which will thus preserve\nits mesh during mesh generation). Meshes on curves are further\nconstrainted by the @code{Mesh.MinLineNodes}, @code{Mesh.MinCircleNodes}\nand @code{Mesh.MinCurveNodes} options."
msgstr ""

#. unit_id: 9fa989b2cfecd1bf2de19754690f79a63d9bc03ef50752649da04091a3239570
#. source_hash: 299dd444cf0fa6a0abf86f119eee9093630159cf0eac0ce78f3e7523145da2fc
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Elementary entities vs physical groups|heading|Elementary entities vs physical groups"
msgid "Elementary entities vs. physical groups"
msgstr ""

#. unit_id: 8ca7d68c6b5bb62fe91daf71a8c1bc4f5edf50225542abe489cdb7709e1fc3ba
#. source_hash: a038326cb43b330313a9701be8d60b78a803e78ce297e3c8a1f54cf3705076a5
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Elementary entities vs physical groups|paragraph|7f417cc0ad890b592384b72ef12dceb299bdc244480a83bfbfa5b72637e51ffb"
msgid "It is usually convenient to combine elementary geometrical entities into\nmore meaningful groups, e.g. to define some mathematical (``domain'',\n``boundary with Neumann condition''), functional (``left wing'',\n``fuselage'') or material (``steel'', ``carbon'') properties.  Such\ngrouping is done in Gmsh's geometry module (@pxref{Geometry module})\nthrough the definition of ``physical groups''."
msgstr ""

#. unit_id: 6f97bb1fe9dcd0d6bf398a41acc56d6ad905c3da403a669cc66f2c8b8391d4f7
#. source_hash: 6fe427af0c1729095a93143441319352003fc3c13081115e91617eecd3c038a3
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Elementary entities vs physical groups|paragraph|df25a36c63c984a4a9b8e8257a7996c75dffe8b5c111ce3e8bacf0fb69652427"
msgid "By default in the native Gmsh MSH mesh file format (@pxref{Gmsh file\nformats}), as well as in most other mesh formats, if physical groups are\ndefined, the output mesh only contains those elements that belong to at\nleast one physical group. (Different mesh file formats treat physical\ngroups in slightly different ways, depending on their capability to\ndefine groups.) To save all mesh elements whether or not physical groups\nare defined, use the @code{Mesh.SaveAll} option (@pxref{Mesh options})\nor specify @code{-save_all} on the command line. In some formats\n(e.g. MSH2), setting @code{Mesh.SaveAll} will however discard all\nphysical group definitions."
msgstr ""

#. unit_id: c64821bdd663b85c371f471bf3b8840db46d99519d367fd765133f5535ff699a
#. source_hash: 7ec3268882a65a02f8e16a7c14265faff5d4f0c2aed1c51531cfcd612c215181
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Solver module|heading|Solver module"
msgid "Solver module"
msgstr ""

#. unit_id: f07f3100e3e549b534e1197dc6713cff7ba3e2854b91e58f88eeb6b7b7aaf913
#. source_hash: 9c223cd7dd23ed878a5326e7bd25113a02536a8f1c8ad2244907a504215fdba3
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Solver module|paragraph|1c9dbc8a539a03defba57e9c209ca688added125ebbe4b46e0f1a7bf3f61ff59"
msgid "Gmsh implements a ONELAB (@uref{http://onelab.info}) server to exchange\ndata with external solvers or other codes (called ``clients''). The\nONELAB interface allows to call such clients and have them share\nparameters and modeling information."
msgstr ""

#. unit_id: 5442de2898a1e32f5e8d444aafd99ce921ac8ec5a50d577cfb0854982ed62826
#. source_hash: 1119ac4ea16f050e7fa4ec1c6399eab01e375c8a05534c2e4d0c73c3a7297b35
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Solver module|paragraph|8af46b1c50c97b4fa2df1cc0be220f7aa113490d6cbe2c07c95e9eabe9f0fa82"
msgid "The implementation is based on a client-server model, with a server-side\ndatabase and local or remote clients communicating in-memory or through\nTCP/IP sockets. Contrary to most solver interfaces, the ONELAB server\nhas no a priori knowledge about any specifics (input file format,\nsyntax, ...) of the clients. This is made possible by having any\nsimulation preceded by an analysis phase, during which the clients are\nasked to upload their parameter set to the server. The issues of\ncompleteness and consistency of the parameter sets are completely dealt\nwith on the client side: the role of ONELAB is limited to data\ncentralization, modification and re-dispatching."
msgstr ""

#. unit_id: 27039843cfc77bdc1e4295349dcba197f965ac7f7c0ec7572b0d650ce8121123
#. source_hash: 38473e940178371f463aaf0e119042be3fe03bd05d016729d1d4444d5877d81c
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Solver module|paragraph|aff384012ad5b1f40384dad262cc3baa3858a2a122e048d2b2b6458b9e166a1e"
msgid "Using the Gmsh API, you can directly embed Gmsh in your C++, C, Python,\nJulia or Fortran solver, use ONELAB for interactive parameter definition\nand modification, and to create post-processing data on the fly. See\n@url{@value{GITLAB-PREFIX}/examples/api/prepro.py,prepro.py},\n@url{@value{GITLAB-PREFIX}/examples/api/custom_gui.py,custom_gui.py} and\n@url{@value{GITLAB-PREFIX}/examples/api/custom_gui.cpp,custom_gui.cpp}\nfor examples."
msgstr ""

#. unit_id: 66a3b1eacdbd2fdeec13d17aaa788a47ce7675ed99677dce0234167d0cedeb5b
#. source_hash: 2495f7a7528a45d60fab18a8ba46b6f6d7438deaafed03a6f3eaa0640acb366d
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Solver module|paragraph|e963733e9657ff0285ff5909934d9107b92b87d010dcd9d690be68e457a95904"
msgid "If you prefer to keep codes separate, you can also communicate with Gmsh\nthrough a socket by providing the solver name (@code{Solver.Name0},\n@code{Solver.Name1}, etc.) and the path to the executable\n(@code{Solver.Executable0}, @code{Solver.Executable1}, etc.). Parameters\ncan then be exchanged using the ONELAB protocol: see the\n@url{@value{GITLAB-PREFIX}/utils/solvers,utils/solvers} directory for\nexamples. A full-featured solver interfaced in this manner is GetDP\n(@uref{https://getdp.info}), a general finite element solver using mixed\nfinite elements."
msgstr ""

#. unit_id: c50ea0548422e2da0dec8f6a6fe845b74b28bec125d7f8e360a5bb8f2c43ed6f
#. source_hash: 47d9e314e6d275d545956a846b3d276625e849c4356498a6f00771da242489c6
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Post-processing module|heading|Post-processing module"
msgid "Post-processing module"
msgstr ""

#. unit_id: 0bd6f5829af68fbd1811e93d6a86e96472bc55f1439e74f3e027372b7a88fc50
#. source_hash: 3ead2954fc1b61fbb3b0e272933318c08ee8e5fb20b6b4838e9e9c1514793430
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Post-processing module|paragraph|1961890ea2489245920cbbddc23ef291abbd0e62c4731847e5cb56ae9377494e"
msgid "The post-processing module can handle multiple scalar, vector or tensor\ndatasets along with the geometry and the mesh. The datasets can be given\nin several formats: in human-readable ``parsed'' format (these are just\npart of a standard input script, but are usually put in separate files\nwith a @file{.pos} extension -- see @ref{Post-processing scripting\ncommands}), in native MSH files (ASCII or binary files with @file{.msh}\nextensions: see @ref{Gmsh file formats}), or in standard third-party\nformats such as CGNS or MED. Datasets can also be directly imported\nusing the Gmsh API (@pxref{Namespace gmsh/view})."
msgstr ""

#. unit_id: 6a934c582d767f83957c37f99fb0df79dc0bdcb12c960d0f9dd129007a923d1c
#. source_hash: 93593748429d9b75551aa8fafd39d8d4f5331627e03d503df538a571af918cf0
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Post-processing module|paragraph|ee94ab30bd001429ccce384b893bbab7601d33326ad02c97c12db11f5819269e"
msgid "Once loaded into Gmsh, scalar fields can be displayed as iso-curves,\niso-surfaces or color maps, whereas vector fields can be represented\neither by three-dimensional arrows or by displacement maps. Tensor\nfields can be displayed as Von-Mises effective stresses, min/max\neigenvalues, eigenvectors, ellipses or ellipsoids. (To display other\ncombinations of components, you can use the\n@code{View.ForceNumComponents} option -- see @ref{Post-processing\noptions}.)"
msgstr ""

#. unit_id: c361a97c703b967a6263f5f6b5f05e8ece2416029fa1e3cdf4e2c219615f1fb1
#. source_hash: 427ce670f7c8db9fa4a0fea17f6e0f8a2f0c1b7993eaa4b91e586a9b011687f5
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Post-processing module|paragraph|8ba453dff6f261ce338dcddfbdab17aef1973d2cd7acd8e4fdcfff2e02f24abb"
msgid "Each dataset, along with the visualization options, is called a\n``post-processing view'', or simply a ``view''. Each view is given a\nname, and can be manipulated either individually (each view has its own\nbutton in the GUI and can be referred to by its index or its unique tag\nin a script or in the API) or globally (see the\n@code{PostProcessing.Link} option in @ref{Post-processing options}).\nPossible operations on post-processing views include section\ncomputation, offset, elevation, boundary and component extraction, color\nmap and range modification, animation, vector graphic output, etc.\nThese operations are either carried out nondestructively through the\nmodification of post-processing options, or can lead to the actual\nmodification of the view data or the creation of new views when done\nusing post-processing plugins (@pxref{Gmsh plugins}). Both can be fully\nautomated in scripts or through the API (see e.g., @ref{t8}, and\n@ref{t9})."
msgstr ""

#. unit_id: 1838a3933f352b57517065802c16ac3d291dcd1000bc746625b741b152af8cbc
#. source_hash: 7774d152e1e5e0b5ff16e089c455839ef9332ddb7adf89a69422f2d7d624f738
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Post-processing module|paragraph|963475e962c1eb3714295b1bae1868c8edff7099365d9cf6d27d56110eab669a"
msgid "By default, Gmsh treats all post-processing views as three-dimensional\nplots, i.e., draws the scalar, vector and tensor primitives (points,\ncurves, triangles, tetrahedra, etc.) in 3D space. But Gmsh can also\nrepresent each post-processing view containing @emph{scalar points} as\ntwo-dimensional (``X-Y'') plots, either space- or time-oriented:"
msgstr ""

#. unit_id: 2855ef4377c6dd74492848525e35ea42d974a348f42d2ca39051820229c66043
#. source_hash: ffa946f3dc7905a09f7bce9b0c7d33392e3c3ce2872489e35ecb740d5dcf96d6
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Post-processing module|paragraph|e88b9cd1bd05a3df3917526b4f4a38e56a4d981b61225f43fc7924e2969844c0"
msgid "in a `2D space' plot, the scalar points are taken in the same order as they\nare defined in the post-processing view: the abscissa of the 2D graph is\nthe curvilinear abscissa of the curve defined by the point series, and only\none curve is drawn using the values associated with the points. If several\ntime steps are available, each time step generates a new curve;"
msgstr ""

#. unit_id: 9b71255cf5874d57221d5e3763dab271f59ef5ddf473ec3433ab7e99b16b7141
#. source_hash: 1695e16a28dc30c27aa92ad3e9efd3dc7a2c9923786bf2a821b45138ed8126a1
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Post-processing module|paragraph|6b3031ba8d32e1029fc8709a7db09666ac2df31ffe13c7852721f4b0ece8a47e"
msgid "in a `2D time' plot, one curve is drawn for each scalar point in the\nview and the abscissa is the time step."
msgstr ""

#. unit_id: a70c8e71c08db696fcb2a8592a7003e13e738143fdac3f5f7295a8cd10921850
#. source_hash: 1e6f4f79e46725d4b6b7497f26e8dddd51e07b671c2b82e04923c9cefbfc9af4
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|What Gmsh is pretty good at|heading|What Gmsh is pretty good at"
msgid "What Gmsh is pretty good at @dots{}"
msgstr ""

#. unit_id: 3aeaf56c43b2cefd2e2077b4c141ae8f70f83c7f337863d41fcc2ae5f06bc689
#. source_hash: 4c702e2a4c42b611768c8c0d124fd4ccbd0c87c55ca75b508b50436e52d8a613
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|What Gmsh is pretty good at|paragraph|f46b6ce3caa67573c83d2a9d20fbf1ae949b363b54055e0530939bcd26a2d5f6"
msgid "Here is a tentative list of what Gmsh does best:"
msgstr ""

#. unit_id: 694d23b9c0f0fa60971503a0738896d2161b0de058e2a5cd6b21ada92dca8d7c
#. source_hash: 3ac289fbe90cd80847cd77a607dfb86f92dec30b17039a9142fe259dc4ae1018
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|What Gmsh is pretty good at|paragraph|fee5728f6d195c386ce547574d9e02ef49f4e93101e2e5adc8fd3d243fe49b02"
msgid "quickly describe simple and/or ``repetitive'' geometries with the\nbuilt-in scripting language, thanks to user-defined macros, loops,\nconditionals and includes (see @ref{User-defined macros}, @ref{Loops and\nconditionals}, and @ref{Other general commands}). For more advanced\ngeometries, using the Gmsh API (@pxref{Gmsh application programming\ninterface}) in the language of your choice (C++, C, Python, Julia or\nFortran) brings even greater flexibility, the only downside being that\nyou need to either compile your code (for C++, C and Fortran) or to\nconfigure and install an interpreter (Python or Julia) in addition to\nGmsh. A binary Software Development Kit (SDK) is distributed on the Gmsh\nweb site to make the process easier (@pxref{Installing and running Gmsh\non your computer});"
msgstr ""

#. unit_id: 81024771cc3eb6dfef85348a64491f47a0ccb47d7f5741cf2de358e25b5365f8
#. source_hash: fbc4eaadcfd13a6b37fd43662ea6e28aa4710bfd52d0c07def93e35bbde45202
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|What Gmsh is pretty good at|paragraph|c49078b4186d7b98d41f8fe920db394206af4675b324408f1f26cd31587eb6c1"
msgid "parametrize these geometries. Gmsh's scripting language or the Gmsh API\nenable all commands and command arguments to depend on previous\ncalculations. Using the OpenCASCADE geometry kernel, Gmsh gives access\nto all the usual constructive solid geometry operations (see\ne.g. @ref{t16});"
msgstr ""

#. unit_id: bb76e515148e66a6e1c285929c7d5e78c4179131ec5812730c87128e4163dfc4
#. source_hash: 897a1aedb929f7c269d42cbeebaaffdb77946729e39ac1999df97bd1c9ac1b23
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|What Gmsh is pretty good at|paragraph|b13ee028dbb8e1286174189aefa3c771de4de50f90c77b387eac283d88a8a6b9"
msgid "import geometries from other CAD software in standard exchange\nformats. Gmsh uses OpenCASCADE to import such files, including label and\ncolor information from STEP and IGES files (see e.g. @ref{t20});"
msgstr ""

#. unit_id: 69d7e79ccfd11c0d3faf2ba72dc9ea5c97f64db3413f972c2e1ccbb6426735dc
#. source_hash: 84e905d035a8e6215d7a53e036c531480bf3fbcfb722196d9a656dd932e2e5c4
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|What Gmsh is pretty good at|paragraph|d74a9cfb8580be4de6d9a408ce23a15d56491df9aa39d6d0961ec032a0dd6270"
msgid "generate unstructured 1D, 2D and 3D simplicial (i.e., using line\nsegments, triangles and tetrahedra) finite element meshes (see @ref{Mesh\nmodule}), with fine control over the element size (@pxref{Specifying\nmesh element sizes});"
msgstr ""

#. unit_id: f9298e5b7789c38e7de0264dcbbe6e015347c63f3549894a68e369c3de2f81b2
#. source_hash: 359fdb5daabb620c245ddca5b870ef4813d3c81918a7f75c8549c44d6697b925
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|What Gmsh is pretty good at|paragraph|e09eb667e077f6a8d529e3d9256b0e933b820f36eb664fa2c8cdf21b1c7c083b"
msgid "create simple extruded geometries and meshes, and allow to automatically\ncouple such structured meshes with unstructured ones (using a layer of\npyramids in 3D);"
msgstr ""

#. unit_id: 031622d2f0571c9f944e1d3375e8d9987c72d33b9307f9715d1b811af0222201
#. source_hash: bdc924eb7e48056cca17c60b054561aea0e8cd1791009cb1acd27de43217582b
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|What Gmsh is pretty good at|paragraph|aa2372704ccdc2cb0254b8f64438d51c46d83862ec5d6fdd3999d4fe670d6026"
msgid "generate high-order (curved) meshes that conform to the CAD model\ngeometry. High-order mesh optimization tools allow to guarantee the\nvalidity of such curved meshes;"
msgstr ""

#. unit_id: 2dfd673ee911347b58c9545cf738880d29485bd6ad34f195f01ae1476ff76b76
#. source_hash: 5be8f26410def0cdd4139e92dabd9d5333f8c0fe12e71e1761e4c5edb88e4415
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|What Gmsh is pretty good at|paragraph|50190812c83ef0f3fa13c9b2373573fbb8718d204076bc63a2a53203ff56a6f1"
msgid "interact with external solvers by defining ONELAB parameters, shared\nbetween Gmsh and the solvers and easily modifiable in the GUI\n(@pxref{Solver module});"
msgstr ""

#. unit_id: 90806d127badcf4b587e49581c86cba6ea6375e7c0194408513bca632e385da9
#. source_hash: 1987eb3fff838ae598bd337f7ac0ce6f033b89c2492178a98aa0ff3cd325e2d8
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|What Gmsh is pretty good at|paragraph|a05b3c618eb8fd534106187dfdd9e3eb4671635acb62662fbcc2c27a2abda398"
msgid "visualize and export computational results in a great variety of\nways. Gmsh can display scalar, vector and tensor datasets, perform\nvarious operations on the resulting post-processing views\n(@pxref{Post-processing module}), can export plots in many different\nformats, and can generate complex animations (see e.g. @ref{t8});"
msgstr ""

#. unit_id: c3c10c0ebe15647295a45fe6127582b97eb2d1de1cc787b36c1fe05b5f8af7cf
#. source_hash: 419a02bfccdb8373c938d3763d7639213038eac9740ddb61a8861f986b33de35
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|What Gmsh is pretty good at|paragraph|7579d35afd2fe1f37390754c1905befebaf838b6ccacc33046eb16e80236a2c8"
msgid "run on low end machines and/or machines with no graphical\ninterface. Gmsh can be compiled with or without the GUI\n(@pxref{Compiling the source code}), and all versions can be used either\ninteractively or directly from the command line;"
msgstr ""

#. unit_id: b5ec6ae7bdb3369725ef484f561c44bbe2b43964159251a95438ab0270652ac0
#. source_hash: d7317ff409be1bf3b22b1f3e82ec0eee33e131179afa4e0391bb43441aa335c6
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|What Gmsh is pretty good at|paragraph|0ee2a2abf00041b9a1834a401aeb851218efccc391d0926ecb089fea3a469ef0"
msgid "configure your preferred options. Gmsh has a large number of\nconfiguration options that can be set interactively using the GUI,\nscattered inside script files, changed through the API, set in per-user\nconfiguration files and specified on the command line (@pxref{Gmsh\noptions});"
msgstr ""

#. unit_id: a280608035441c246cb6c03abf8b743c582e30b27e5b1186f677454e5ebb7ffb
#. source_hash: 240b9a47638b0d2bc258040d24b2088bcdc15228339743e3d01be7795b408caa
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|What Gmsh is pretty good at|paragraph|7672e0d9612f4c99761ce23c537b25d90a7783d0473936db339c51d6c25cd5cc"
msgid "and do all the above on various platforms (Windows, macOS and Linux),\nfor free (@pxref{Copying conditions})!"
msgstr ""

