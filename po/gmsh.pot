msgctxt "doc/texinfo/gmsh.texi|Adding a new option|paragraph|e984b8ecb03142cd0fd56ca64ae0bf61a73d50d383636ae94956e42a47f3f50e"
msgid "create the option in the @code{CTX} class\n(@url{@value{GITLAB-PREFIX}/src/common/Context.h,src/common/Context.h}\nif it's a classical option, or in the @code{PViewOptions} class\n(@url{@value{GITLAB-PREFIX}/src/post/PViewOptions.h,src/post/PViewOptions.h})\nif it's a post-processing view-dependent option;"
msgstr ""

#. unit_id: e4233c1920f1cdb724174b5bf22e5b6563b9c3cbf16e8220b17e92f8fb66ccd5
#. source_hash: 2ee35186aa8a621b0240ab057f2170b6516935397001ac16dca301e6f2bb4835
