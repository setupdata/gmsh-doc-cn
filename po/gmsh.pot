msgstr ""

#. unit_id: 89090924d3076d7db9acee709551950de4b694f1bb8e482d69eba255ae4810f1
#. source_hash: 722e01b3efaad844605fe44a0e55524b3cf9ad58512cc4edf9df3f598223b01d
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|paragraph|TransfQuadTri @{ @var{expression-list} @} ;"
msgid "Apply the transfinite QuadTri algorithm on the @var{expression-list}\nlist of volumes.  A transfinite volume with any combination of\nrecombined and un-recombined transfinite boundary surfaces is valid when\nmeshed with @code{TransfQuadTri}. When applied to non-Transfinite\nvolumes, TransfQuadTri has no effect on those volumes. @value{SYNC}"
msgstr ""

