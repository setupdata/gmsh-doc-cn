#. unit_id: 353ff2e2160cc0e4399471d32f0048ad4ca227636add1ecbf197f9fcc857f93c
#. source_hash: 069bdf900a21ce769c3f51021f9ee501fb6710e7eb891dbf3527739d29b40276
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Floating point expressions|index|Expressions, definition"
