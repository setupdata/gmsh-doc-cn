msgid "List of expressions are also widely used, and are defined as:"
msgstr ""

#. unit_id: c4a884728ef042cfe060ac8abb5c95087c931dc03a81f470217e7773ffd72c81
#. source_hash: 842793b0a2eff6b443092e393d48c54cbfce2d29a5b1c9adabaafc763a600721
#: doc/texinfo/gmsh.texi
