msgid "To add a new option in Gmsh:"
msgstr ""

#. unit_id: 18a8c18d5dd092aeb732ab3c89420db88df230c07404f0ce77dfd1fe34c1e902
#. source_hash: e105790cb5bf075bd490295059454be791425836dc924305745ca9c5bccf8081
