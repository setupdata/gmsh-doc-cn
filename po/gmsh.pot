msgid "4.4.1 (July 25, 2019): small improvements (transfinite with degenerate curves,\nrenumbering for some mesh formats, empty MSH file sections, tunable accuracy of\ncompound meshes) and bug fixes (ellipse < pi, orientation and reclassification\nof compound parts, serendip pyramids, periodic MeshAdapt robustness, invalidate\ncache after mesh/addNodes)."
msgstr ""

#. unit_id: 99c420990442f142357c4ad468227e2a400db373222626a32e65ec8496375b78
