msgstr ""

#. unit_id: 008e3e0b997eb8aee8c31ead73c9dade909a1c7bd76f7f546f20227bd0802a46
#. source_hash: bce8b39dd9bbeddddf87287a4bad6942c5371e39f6bb960212b2844166463ad1
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|paragraph|Compound Curve | Surface @{ @var{expression-list-or-all} @} ;"
msgid "Treat the given entities as a single entity when meshing, i.e. perform\ncross-patch meshing of the entities."
msgstr ""

