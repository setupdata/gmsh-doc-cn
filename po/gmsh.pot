msgid "Installing and running Gmsh on your computer"
msgstr ""

#. unit_id: e899d114c063956cea38568e80f180dc42b97902d9f74372d2237a9c68493e5c
#. source_hash: ab4a5e7f1b428cef6c358a5e4fce699d1498f5b06537e832e3261dc9cfa5ed8e
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Installing and running Gmsh on your computer|index|Running Gmsh"
msgid "Running Gmsh"
msgstr ""

#. unit_id: 93d4e79cf427a5d0c1adbd9a1b95f485a158fad7a8b589b9f8b0278f6ee1136f
#. source_hash: 0dda32137e8719e017ceaabc5c248b0c6943be886aa3cf33af2a172a72014942
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Installing and running Gmsh on your computer|index|Installation"
msgid "Installation"
msgstr ""

#. unit_id: f5a469282a464657dbf9fa46565742bdd8f4186bda5252bb667acdf0ebdab698
#. source_hash: 20bbe68b055833c858f35617c1a7307c0feed7534e5ca17305956077057b218a
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Installing and running Gmsh on your computer|paragraph|ea6d1414c82cb0bfbe9f919c5c778f36857c8246c5c72b99539ae56acae35017"
msgid "Gmsh can be used either as a standalone application, or as a library."
msgstr ""

#. unit_id: 6785538f4e697e9e8185bdcccc94f569b17cc0beb6b0adefd21f09d4b868fa43
#. source_hash: d1c2663c03caf48b683dcff733f0175c27f67525a97a4d132019af39720a9677
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Installing and running Gmsh on your computer|paragraph|5f6320f5a0196b14fe71e433b6a19161bc904b045df1a3d788fad92079251dde"
msgid "As a standalone application, Gmsh can be controlled with the GUI\n(@pxref{Gmsh graphical user interface}), through the command line\n(@pxref{Gmsh command-line interface}) and through @file{.geo} script\nfiles (@pxref{Gmsh scripting language}). In addition, the ONELAB\ninterface (@pxref{Solver module}) allows to interact with the Gmsh\napplication through Unix or TCP/IP sockets.  Binary versions of the Gmsh\napp for Windows, Linux and macOS can be downloaded from\n@url{https://gmsh.info/#Download}. Several Linux distributions also ship\nthe Gmsh app. See @ref{Compiling the source code} for instructions on\nhow to compile the Gmsh app from source."
msgstr ""

#. unit_id: 867f71b02df7b83d61bcf30b5515bc45d4f3b840e34eaa126293f134b43c2020
#. source_hash: c0d50dd6f45768fd6ab835fd2b1e3f50565883ac2812aad1f1adcbd248a1c59e
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Installing and running Gmsh on your computer|paragraph|f99fe0fa9cdbdcfad73a3d8e6ad28d18667c0927bb8dec0f2fde0173c4a7736d"
msgid "As a library, Gmsh can still be used in the same way as the standalone\nGmsh app, but in addition it can also be embedded in external codes\nusing the Gmsh API (@pxref{Gmsh application programming interface}).\nThe API is available in C++, C, Python, Julia and Fortran.  A binary\nSoftware Development Kit (SDK) for Windows, Linux and macOS, that\ncontains the dynamic Gmsh library and the associated header and module\nfiles, can be downloaded from @url{https://gmsh.info/#Download}. Python\nusers can use"
msgstr ""

#. unit_id: cf882168f5456dcba237428e89d1664a401163fe46498fc1acbc09cceaf85bc8
#. source_hash: 5db94cffb8ed9ea3884e136b02920a73d3f1df4157be0a3d9ddee8db6aa8d9ae
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Installing and running Gmsh on your computer|paragraph|61ca86c48287f909166dbf57eb5906985d599e76bcb178e6c4781c9570310ff7"
msgid "which will download the binary SDK and install the files in the\nappropriate system directories. Several Linux distributions also ship\nthe Gmsh SDK. See @ref{Compiling the source code} for instructions on\nhow to compile the dynamic Gmsh library from source."
msgstr ""

#. unit_id: c4607cc4d521c2417724aad4fe24504f25ed6cbc6375ba769a13aaad945a7415
#. source_hash: 75c4ddef6f14ad3bedf1d69b413d19e17efcd9cd50ab90c839c73a78b08023fa
#: doc/texinfo/gmsh.texi
