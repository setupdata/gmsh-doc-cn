#. unit_id: 1c4313ecccefe666a540c3b9faabb681ee1d08b24155ada648a903f2d3c6844d
#. source_hash: 34e7a356da034fe37ed911cdacfee046eab21eb08a7cbeece1667eb0f959d4d0
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|POS ASCII file format (Legacy)|paragraph|@var{text3d}#2"
msgid "where @var{coord1}, @var{coord2} and @var{coord3} give the XYZ coordinates\nof the string in model (real world) coordinates, @var{index} gives the\nstarting index of the string in @var{text3d-chars}, and @var{style} has the\nsame meaning as in @var{text2d}."
msgstr ""

