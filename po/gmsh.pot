msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|item|Periodic Surface @var{expression} @{ @var{expression-list} @} = @var{expression} @{ @var{expression-list} @} ;"
msgid "Periodic Surface @var{expression} @{ @var{expression-list} @} = @var{expression} @{ @var{expression-list} @} ;"
msgstr ""

#. unit_id: dd8604ef146dc2bf9e2e571192cd00f58225ce5d14e9700b69802d8e646bc40e
#. source_hash: b5750dc88c6406257e34938186b78e33d445bcd941339aa34963af3ad5c6ba77
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|paragraph|Periodic Surface @var{expression} @{ @var{expression-list} @} = @var{expression} @{ @var{expression-list} @} ;"
msgid "Add a meshing constraint to force the mesh of the surface on the\nleft-hand side (with boundary edges specified between braces) to match\nthe mesh of the master surface on the right-hand side (with boundary\nedges specified between braces). If used after meshing, generate the\nperiodic node correspondence information assuming the mesh of the\nsurface on the left-hand side effectively matches the mesh of the master\nsurface on the right-hand side (useful for structured and extruded\nmeshes). @value{SYNC}"
msgstr ""

#. unit_id: e155c6fd0b34bf632a57e405cadbf112383f793630858940b2335c9a832fb902
#. source_hash: 7f344c8d6d0b8d9b17645a90c0c026f6c6c14a71ab32b14e8deed8b6c160b658
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|item|Periodic Curve | Surface @{ @var{expression-list} @} = @{ @var{expression-list} @} Affine | Translate @{ @var{expression-list} @} ;"
msgid "Periodic Curve | Surface @{ @var{expression-list} @} = @{ @var{expression-list} @} Affine | Translate @{ @var{expression-list} @} ;"
msgstr ""

#. unit_id: f3c7a54eec0e0eff2ac9523fac696deb581ee9f2dc8d7d2143674d3092c2b685
#. source_hash: 348dbfe92191fdbd87810e1af923368183fb2eb4648b43b6d4f9fafedbcf4c6f
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|paragraph|Periodic Curve | Surface @{ @var{expression-list} @} = @{ @var{expression-list} @} Affine | Translate @{ @var{expression-list} @} ;"
msgid "Add a meshing constraint to force mesh of curves or surfaces on the\nleft-hand side to match the mesh of the curves or surfaces on the\nright-hand side (masters), using prescribed geometrical\ntransformations. If used after meshing, generate the periodic node\ncorrespondence information assuming the mesh of the curves or surfaces\non the left-hand side effectively matches the mesh of the curves or\nsurfaces on the right-hand side (useful for structured and extruded\nmeshes). @code{Affine} takes a 4 x 4 affine transformation matrix given\nby row (only 12 entries can be provided for convenience);\n@code{Translate} takes the 3 components of the translation as in\n@ref{Transformations}. @value{SYNC}"
msgstr ""

#. unit_id: ca4c8658f102c51d51ae8c1801cfc38ce76c33cb29c251da4d7fdea840fa5627
#. source_hash: ac3a77b97d22cbcb082e9e70c3047165bf5016f41de249b3b80b44b3e9518c4f
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|item|Periodic Curve | Surface @{ @var{expression-list} @} = @{ @var{expression-list} @} Rotate @{ @var{expression-list} @}, @{ @var{expression-list} @}, @var{expression} @} ;"
msgid "Periodic Curve | Surface @{ @var{expression-list} @} = @{ @var{expression-list} @} Rotate @{ @var{expression-list} @}, @{ @var{expression-list} @}, @var{expression} @} ;"
msgstr ""

#. unit_id: d40adafb55df169597dc1327fc1265ee43488fddf047def412f3cf5dcddd77b7
#. source_hash: a12b4106380da43534259c381b7ee8da55df0d7a0be31e2611ffde47bbb3c1ca
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|paragraph|Periodic Curve | Surface @{ @var{expression-list} @} = @{ @var{expression-list} @} Rotate @{ @var{expression-list} @}, @{ @var{expression-list} @}, @var{expression} @} ;"
msgid "Add a meshing constraint to force the mesh of curves or surfaces on the\nleft-hand side to match the mesh of the curves on the right-hand side\n(masters), using a rotation specified as in @ref{Transformations}. If\nused after meshing, generate the periodic node correspondence\ninformation assuming the mesh of the curves or surfaces on the left-hand\nside effectively matches the mesh of the curves or surfaces on the\nright-hand side (useful for structured and extruded\nmeshes). @value{SYNC}"
msgstr ""

