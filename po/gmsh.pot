msgstr ""

#. unit_id: a4faa80a51c0f521c8dabab7efa8785193aa48f60dc12bb7531ffa0009e4f40b
#. source_hash: b6665764590825085a3b5a114ef8e222274d93ffa8c1b270444729c4df1a4161
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|paragraph|CreateTopology < @{ @var{expression} , @var{expression} @} > ;"
msgid "Create a boundary representation from the mesh of the current model if\nthe model does not have one (e.g. when imported from mesh file formats\nwith no BRep representation of the underlying model). If the first\noptional argument is set (or not given), make all volumes and surfaces\nsimply connected first; if the second optional argument is set (or not\ngiven), clear any built-in CAD kernel entities and export the discrete\nentities in the built-in CAD kernel."
msgstr ""

#. unit_id: 825b678d66d75f6b3118689ba626e1823c0d6dd0ae06b9169034428ce31192f2
#. source_hash: 48df4447eb9de109ceb080558af50419b558761a07dfa79c11b6c289f008bdcc
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|item|CreateGeometry < @{ <Physical> Point | Curve | Surface | Volume @{ @var{expression-list-or-all} @}; @dots{} @} > ;"
msgid "CreateGeometry < @{ <Physical> Point | Curve | Surface | Volume @{ @var{expression-list-or-all} @}; @dots{} @} > ;"
msgstr ""

#. unit_id: 2071f6cfaf06d5d900c5bf12db5fe8075288259d94ac1b60eb5cf4fa5cc7ba69
#. source_hash: ad3f436f455b43a0fbed32b3549c39efa7bbeda650c483c30254d581a2d67e50
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|paragraph|CreateGeometry < @{ <Physical> Point | Curve | Surface | Volume @{ @var{expression-list-or-all} @}; @dots{} @} > ;"
msgid "Create a geometry for discrete entities (represented solely by a mesh,\nwithout an underlying CAD description) in the current model, i.e. create\na parametrization for discrete curves and surfaces, assuming that each\ncan be parametrized with a single map. If no entities are given, create\na geometry for all discrete entities."
msgstr ""

#. unit_id: 931c13075b43e2f0e26f4416e027707f502b001bbf58597a64dab468c0908e1f
#. source_hash: c283110bdf1810e8811cb739fc3fe3f941cddd4979dd55dc3011c8a57eb83f49
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|item|ClassifySurfaces @{ @var{expression} , @var{expression} , @var{expression} < , @var{expression} > @};"
msgid "ClassifySurfaces @{ @var{expression} , @var{expression} , @var{expression} < , @var{expression} > @};"
msgstr ""

#. unit_id: 2178088e0dc807003e1b79b36ae541321e1b07b212132881a6fbf79a121f6d49
#. source_hash: 2a32a47b157b884feac2a926000d173e96dbcbaa58d9a86711af26e2b8035c28
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|paragraph|ClassifySurfaces @{ @var{expression} , @var{expression} , @var{expression} < , @var{expression} > @};"
msgid "Classify (``color'') the current surface mesh based on an angle\nthreshold (the first argument, in radians), and create new discrete\nsurfaces, curves and points accordingly.  If the second argument is set,\nalso create discrete curves on the boundary if the surface is open. If\nthe third argument is set, create edges and surfaces that can be\nreparametrized with @code{CreateGeometry}. The last optional argument\nsets an angle threshold to force splitting of the generated curves."
msgstr ""

#. unit_id: 15355d8cee5358bb641c51a1e7840a24d5a23218e9b166f46b2c5d357cf2ae9c
#. source_hash: 265e53eb3ded7347e43bf5f5dd72d5bda30e56573d307b67889019f85f450cf1
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|item|RenumberMeshNodes;"
