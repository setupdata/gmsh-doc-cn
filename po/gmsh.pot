#. unit_id: 2aa2ed13a013ecf995639a040ef12b84df099de67ae58a776cbed54bb9e51b93
#. source_hash: a71f3fb4131bea8c1c62f7ed4fa3b0c2220a971b03fcad55dbaec3b283ce5926
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|4.9.3"
msgid "4.9.3 (January 4, 2022): improved handling of degenerate curves in periodic\nsurfaces and boundary layer extrusion; extended Mesh.SaveGroupsOfElements\ncapabilities for INP export; extended Mesh.MeshSizeExtendFromBoundary + new\n\"Extend\" mesh size field to enable alternative mesh size extensions from\nboundary; enhanced X3D output; moved all kernel sources to src/ subdirectory;\nrenamed demos/ as examples/ and tutorial/ as tutorials/; small bug fixes."
msgstr ""

#. unit_id: 2bc41d7127b81cc9bc2599c82b84b36a9a0cc06787c09b10c9cfd4fdaa883e2c
#. source_hash: 4499f21901648cb77d5e839db5da332209e7ab7155819595c0c3707a3100063e
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|4.9.2"
msgid "4.9.2 (December 23, 2021): faster projection on OCC entities; extended\nMesh.SaveGroupsOfNodes capabilities for INP export; improved transfinite meshing\nof surfaces with boundary on periodic seam."
msgstr ""

#. unit_id: bfa069f0841363a9e850d6c138d44b1b8fd864306ea50d9199b4442851529e56
#. source_hash: d3c5ed2313ac04c9c58af19bfcfde2e1a101a836d7a11923a7cf23d81b3cc440
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|4.9.1"
msgid "4.9.1 (December 18, 2021): relax tolerance on curve parametrization match for\nperiodic meshing; enable extruded boundary layers on generic model entities;\nactivate IncludeBoundary by default in Restrict field; downgraded compiler for\nofficial Linux releases to gcc 6 to improve compatibility with older systems;\nsmall bug fixes (view tag generation with zero tag, model/setTag)."
msgstr ""

#. unit_id: ef6c0538be4692625fdce146768fe6478616ae023ac06dccd6ecddd5f93474c7
#. source_hash: 4cfd321256e648d15f28ebcb144a9e237ad080863a6a3a469bef7c2a4bb4bce2
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|4.9.0"
msgid "4.9.0 (December 3, 2021): new initial 2D meshing algorithm; new quasi-structured\nquad algorithm; improved handling of imperfect curve reparametrization on\nsurfaces in 2D periodic meshing algorithm; mesh renumbering now also renumbers\ndependent post-processing views; the mesh size callback is now per-model and its\nreturned value is not gathered with the other size constraints in a global min\nreduction anymore: instead the callback takes as additional argument the mesh\nsize lc that would be prescribed in the absence of the callback, which allows to\nperform any desired modification (the old behavior can be achieved by returning\nmin(lc, value)); OCC STL representation is now generated using relative\ndeflection tolerance; new TransformMesh command in .geo files; new behavior of\nMesh.SaveGroupsOf{Nodes,Elements} in UNV and INP exports; partitioned MSH4 files\nnow contain the full partition topology (i.e. all partition entities); fixed\nmetric calculation with Eigen (for anisotropic mesh generation); official binary\nbuilds now support OpenMP parallelization and are 64 bit only (build OS upgraded\nto Windows 10, macOS 10.15 and Linux glibc 2.24); new experimental Fortran API;\nnew API functions to handle view options by tag instead of by index; color\noptions in the API can now be specified as in .geo files, in the form\n\"Category.Color.Option\"; small bug fixes."
msgstr ""

#. unit_id: b31ef6b1a9fd4051228ae6fb371b2c21410526e2a187fff97fa072e3c4e58045
#. source_hash: 09a1f3dc0c98f182e28acaffc36757420dcace24052d77f314d1c2995dac2c48
