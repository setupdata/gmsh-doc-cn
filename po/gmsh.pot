#. unit_id: 38f170f6cae78cf3806e7ace372487cbeb1e99cec138de5d6a3e1f6bf7c5ab6f
#. source_hash: 3968e32685ae6dd319dbf40b08e802b389d1bfa36c5272f16b86a840684b757f
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|paragraph|Extrude @{ @var{expression-list} @} @{ @var{extrude-list} @var{layers} @}"
msgid "Extrude both the geometry and the mesh using a translation\n(@pxref{Extrusions}). The @var{layers} option determines how the mesh is\nextruded and has the following syntax:"
msgstr ""

#. unit_id: b9ac3424c79afeef65f04c55595f09c3318e7506b21c2d6248747ad99b9cbac9
#. source_hash: 236ea0a0b70f0f63fdebdb8c468258dc397dfb1926244b51c1d41c6e6934ceed
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|paragraph|Extrude @{ @var{expression-list} @} @{ @var{extrude-list} @var{layers} @}#2"
msgid "In the first @code{Layers} form, @var{expression} gives the number of\nelements to be created in the (single) layer. In the second form, the\nfirst @var{expression-list} defines how many elements should be created\nin each extruded layer, and the second @var{expression-list} gives the\nnormalized height of each layer (the list should contain a sequence of\n@var{n} numbers 0 < @var{h1} < @var{h2} < @dots{} < @var{hn} <= 1). See\n@ref{t3}, for an example."
msgstr ""

#. unit_id: f92ec7e33fae133a3b638fc6f68d8dbce7af9c9a361a749434e22874294da952
#. source_hash: 5538e4a40341db3129f0a09b4618eb698d212e32b40fe90333054b8279e3ebab
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|paragraph|Extrude @{ @var{expression-list} @} @{ @var{extrude-list} @var{layers} @}#3"
msgid "For curve extrusions, the @code{Recombine} option will recombine triangles\ninto quadrangles when possible.  For surface extrusions, the\n@code{Recombine} option will recombine tetrahedra into prisms, hexahedra or\npyramids."
msgstr ""

#. unit_id: a8749a1a10f73dd7f4071a8f1a790d78cf76eceaffc5f9a151ceb0ff764f0046
#. source_hash: 93c3897064b1ffb51e5a5dbb7235594e5f1f39420a5bd701da5b40af76b02078
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|paragraph|Extrude @{ @var{expression-list} @} @{ @var{extrude-list} @var{layers} @}#4"
msgid "Please note that, starting with Gmsh 2.0, region tags cannot be\nspecified explicitly anymore in @code{Layers} commands. Instead, as with\nall other geometry commands, you must use the automatically created\nentity identifier created by the extrusion command. For example, the\nfollowing extrusion command will return the tag of the new ``top''\nsurface in @code{num[0]} and the tag of the new volume in @code{num[1]}:"
msgstr ""

#. unit_id: d1727069351e28c77015a2f38ac61d2bb4f0b7f2f005ec0cf7ee9283d782d26e
#. source_hash: b702b2f4db3957edf672386ca3c5b5c8047aa5c4958fd4f274b69b8b1cb633f2
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|paragraph|Extrude @{ @var{expression-list} @} @{ @var{extrude-list} @var{layers} @}#5"
msgid "@code{QuadTriNoNewVerts} and @code{QuadTriAddVerts} allow to connect\nstructured, extruded volumes containing quadrangle-faced elements to\nstructured or unstructured tetrahedral volumes, by subdividing into\ntriangles any quadrangles on boundary surfaces shared with tetrahedral\nvolumes. (They have no effect for 1D or 2D extrusions.)\n@code{QuadTriNoNewVerts} subdivides any of the region's quad-faced 3D\nelements that touch these boundary triangles into pyramids, prisms, or\ntetrahedra as necessary, all without adding new\nnodes. @code{QuadTriAddVerts} works in a similar way, but subdivides 3D\nelements touching the boundary triangles by adding a new node inside\neach element at the node-based centroid. Either method results in a\nstructured extrusion with an outer layer of subdivided elements that\ninterface the inner, unmodified elements to the triangle-meshed region\nboundaries."
msgstr ""

#. unit_id: 790ee8caeb4bf07bc64408209df1d40dc0fac16876c9f617009cb755396a1a35
#. source_hash: a27b3b0d6e3a55cddd929177d3c04fd0395162f7083c6d6d40b1157a69837196
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|paragraph|Extrude @{ @var{expression-list} @} @{ @var{extrude-list} @var{layers} @}#6"
msgid "In some rare cases, due to certain lateral boundary conditions, it may\nnot be possible make a valid element subdivision with\n@code{QuadTriNoNewVerts} without adding additional nodes. In this\ncase, an internal node is created at the node-based centroid of the\nelement. The element is then divided using that node. When an internal\nnode is created with @code{QuadTriNoNewVerts}, the user is alerted by\na warning message sent for each instance; however, the mesh will still\nbe valid and conformal."
msgstr ""

#. unit_id: 1001909a3cb3001a0332393a3f459a67d28636eae34e6c0e9b0b1db41a9d5a23
#. source_hash: fd47496fcbda1f7bec3bf5dda0f859cb41520ec2606d36e6a8cd6d2db04a7292
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|paragraph|Extrude @{ @var{expression-list} @} @{ @var{extrude-list} @var{layers} @}#7"
msgid "Both @code{QuadTriNoNewVerts} and @code{QuadTriAddVerts} can be used\nwith the optional @code{RecombLaterals} keyword. By default, the QuadTri\nalgorithms will mesh any free laterals as triangles, if\npossible. @code{RecombLaterals} forces any free laterals to remain as\nquadrangles, if possible. Lateral surfaces between two QuadTri regions\nwill always be meshed as quadrangles."
msgstr ""

#. unit_id: f55f9a64bbe12b233ca2019fa25e268bf8cf12082ddec29b9b6ad8940e07fd70
#. source_hash: 32fe441232bd287ae7d7fe9d098ab6676c175dbef6add4ab19ff89e39261a031
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|paragraph|Extrude @{ @var{expression-list} @} @{ @var{extrude-list} @var{layers} @}#8"
msgid "Note that the QuadTri algorithms will handle all potential meshing\nconflicts along the lateral surfaces of the extrusion.  In other words,\nQuadTri will not subdivide a lateral that must remain as quadrangles,\nnor will it leave a lateral as quadrangles if it @emph{must} be divided.\nThe user should therefore feel free to mix different types of\nneighboring regions with a QuadTri meshed region; the mesh should work.\nHowever, be aware that the top surface of the QuadTri extrusion will\nalways be meshed as triangles, unless it is extruded back onto the\noriginal source in a toroidal loop (a case which also works with\nQuadTri)."
msgstr ""

#. unit_id: a6f6cee80efe0f562a3611ef24f28f126c97ceec6423edd48a45ea72fb8f05b5
#. source_hash: 569d7976bc673df5be2c8b930cb121e2155cb0853ebe9ee30b532dd5ba2e1753
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|paragraph|Extrude @{ @var{expression-list} @} @{ @var{extrude-list} @var{layers} @}#9"
msgid "@code{QuadTriNoNewVerts} and @code{QuadTriAddVerts} may be used\ninterchangeably, but @code{QuadTriAddVerts} often gives better element\nquality."
msgstr ""

#. unit_id: cfb1f501f33369cb111e6ac814a1e7e4f26582580e04fb7b27d3415e617ca451
#. source_hash: ebe318e6ef4228e7e0b0edde53037fde468b0198a05164cc3872dc676dfd051d
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|paragraph|Extrude @{ @var{expression-list} @} @{ @var{extrude-list} @var{layers} @}#10"
msgid "If the user wishes to interface a structured extrusion to a tetrahedral\nvolume without modifying the original structured mesh, the user may\ncreate dedicated interface volumes around the structured geometry and\napply a QuadTri algorithm to those volumes only."
msgstr ""

#. unit_id: 2261b883d1878068cc7060149cf541f4b82e0261024507c4625d9033609c68b4
#. source_hash: c45c5320202a647084b91823774462f1d2cf481066b88f1b406d02037528ce8a
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|item|Extrude @{ @{ @var{expression-list} @}, @{ @var{expression-list} @}, @var{expression} @} @{ @var{extrude-list} @var{layers} @}"
msgid "Extrude @{ @{ @var{expression-list} @}, @{ @var{expression-list} @}, @var{expression} @} @{ @var{extrude-list} @var{layers} @}"
msgstr ""

#. unit_id: 61f0dfbe36dd2e6018c83bede32cf449892cce743a1847bb1e795c087e7f181b
#. source_hash: 241fbb38e4f65727c1fa3cf4b5cb0ccbed26a4ddcd3258e6d2ce6a8894667146
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|paragraph|Extrude @{ @{ @var{expression-list} @}, @{ @var{expression-list} @}, @var{expression} @} @{ @var{extrude-list} @var{layers} @}"
msgid "Extrude both the geometry and the mesh using a rotation\n(@pxref{Extrusions}). The @var{layers} option is defined as above.  With\nthe built-in geometry kernel the angle should be strictly smaller than\nPi. With the OpenCASCADE kernel the angle should be strictly smaller\nthan 2 Pi."
msgstr ""

#. unit_id: 3dcf5e857a4a6222322af892d22ccd36df4609fbcb60af29977bcdcbe5cc0c9f
#. source_hash: 26975c2c4b93302e39846e370ea70b0c66f24ceea9be79b83ff2b4601845e51b
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|item|Extrude @{ @{ @var{expression-list} @}, @{ @var{expression-list} @}, @{ @var{expression-list} @}, @var{expression} @} @{ @var{extrude-list} @var{layers} @}"
msgid "Extrude @{ @{ @var{expression-list} @}, @{ @var{expression-list} @}, @{ @var{expression-list} @}, @var{expression} @} @{ @var{extrude-list} @var{layers} @}"
msgstr ""

#. unit_id: 88eecda763dcf8c9e5b96c71ae5e32b8ef9bc0bdb4e8a89fa9fcc06ba58ef5f5
#. source_hash: c59b8c45ec291c70ddbaac6f1c5517711bf4d5d1222ce167604b5545f4ff2c50
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|paragraph|Extrude @{ @{ @var{expression-list} @}, @{ @var{expression-list} @}, @{ @var{expression-list} @}, @var{expression} @} @{ @var{extrude-list} @var{layers} @}"
msgid "Extrude both the geometry and the mesh using a combined translation and\nrotation (@pxref{Extrusions}). The @var{layers} option is defined as\nabove. With the built-in geometry kernel the angle should be strictly\nsmaller than Pi. With the OpenCASCADE kernel the angle should be\nstrictly smaller than 2 Pi."
msgstr ""

#. unit_id: c745ee730de4b40fbce36f28761bc692ac091c99c6d7b4aed8a87a4e6cc331b3
#. source_hash: 2847186fccc6b742381e78914098f765ad36b4015982408caa9ffaee2bc49cd0
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|item|Extrude @{ Surface @{ @var{expression-list} @}; @var{layers} < Using Index[@var{expr}]; > < Using View[@var{expr}]; > < ScaleLastLayer; > @}"
msgid "Extrude @{ Surface @{ @var{expression-list} @}; @var{layers} < Using Index[@var{expr}]; > < Using View[@var{expr}]; > < ScaleLastLayer; > @}"
msgstr ""

#. unit_id: 2f9ed0e45f825bfeca4eae49be1fbb8020c8ab1b226ea346e96b90eae1b6d102
#. source_hash: 1becdf42ccab7f9d4452bd8b697520786e001e4d734d459f835422931011ffbd
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|paragraph|Extrude @{ Surface @{ @var{expression-list} @}; @var{layers} < Using Index[@var{expr}]; > < Using View[@var{expr}]; > < ScaleLastLayer; > @}"
msgid "Extrude a ``topological'' boundary layer from the specified surfaces. If\nno view is specified, the mesh of the boundary layer entities is created\nusing a gouraud-shaded (smoothed) normal field. If a scalar view is\nspecified, it locally prescribes the thickness of the layer. If a\nvector-valued view is specified it locally prescribes both the extrusion\ndirection and the thickness. Specifying a boundary layer index allows to\nextrude several independent boundary layers (with independent normal\nsmoothing). @code{ScaleLastLayer} scales the height of the last (top)\nlayer of each normal's extrusion by the average length of the edges in\nall the source elements that contain the source node (actually, the\naverage of the averages for each element--edges actually touching the\nsource node are counted twice). This allows the height of the last layer\nto vary along with the size of the source elements in order to achieve\nbetter element quality. For example, in a boundary layer extruded with\nthe Layers definition 'Layers@{ @{1,4,2@}, @{0.5, 0.6, 1.6@} @},' a\nsource node adjacent to elements with an overall average edge length of\n5.0 will extrude to have a last layer height = (1.6-0.6) * 5.0 =\n5.0. Topological boundary layers are only available with the built-in\nkernel. See\n@url{@value{GITLAB-PREFIX}/benchmarks/extrude/sphere_boundary_layer.geo,sphere_boundary_layer.geo}\nor\n@url{@value{GITLAB-PREFIX}/benchmarks/extrude/sphere_boundary_layer_from_view.geo,sphere_boundary_layer_from_view.geo}\nfor @file{.geo} file examples, and\n@url{@value{GITLAB-PREFIX}/examples/api/aneurysm.py,aneurysm.py} for an API\nexample."
msgstr ""

#. unit_id: f527c2b0117a1d963fee846550492907150c1568f48bd3da6cb0a42c647845f4
#. source_hash: fdbf0cd214bb7ad1ac05e1c1941c729cfd62cbb4dbc794ab56fd8abe098e29d6
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|paragraph|Extrude @{ Surface @{ @var{expression-list} @}; @var{layers} < Using Index[@var{expr}]; > < Using View[@var{expr}]; > < ScaleLastLayer; > @}#2"
msgid "The advantage of this approach is that it provides a topological\ndescription of the boundary layer, which means that it can be connected\nto other geometrical entities. The disadvantage is that the mesh is just\na ``simple'' extrusion: no fans, no special treatments of reentrant\ncorners, etc. Another boundary layer algorithm is currently available\nthrough the @code{BoundaryLayer} field (@pxref{Specifying mesh element\nsizes}). It only works in 2D however, and is a meshing constraint: it\nworks directly at the mesh level, without creating geometrical\nentities. See\ne.g. @url{@value{GITLAB-PREFIX}/benchmarks/2d/BL0.geo,BL0.geo} or\n@url{@value{GITLAB-PREFIX}/benchmarks/2d/naca12_2d.geo,naca12_2d.geo}."
msgstr ""

#. unit_id: c0a28c461f1867c3563ac9aec9e2da3668436640c14c127454d01b94286167de
#. source_hash: a78fe10147d6b470a2e05da29d80e7b724c39c6c509e1a0569c6a661dbe6bf30
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|item|Transfinite Curve @{ @var{expression-list-or-all} @} = @var{expression} < Using Progression | Bump @var{expression} >;"
msgid "Transfinite Curve @{ @var{expression-list-or-all} @} = @var{expression} < Using Progression | Bump @var{expression} >;"
msgstr ""

#. unit_id: 619a12dc132fa33bcfb35256b4aab007a7d0e2d4c88724591e9312813d7cdc95
#. source_hash: 86b85714e44c243fd58a9ba7fefcd76fdeeb0fe5dc40a42ad5ecef35068cb075
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|paragraph|Transfinite Curve @{ @var{expression-list-or-all} @} = @var{expression} < Using Progression | Bump @var{expression} >;"
msgid "Select the curves in @var{expression-list} to be meshed with the 1D\ntransfinite algorithm. The @var{expression} on the right hand side gives\nthe number of nodes that will be created on the curve (this overrides\nany other mesh element size prescription---see @ref{Specifying mesh\nelement sizes}). The optional argument `@code{Using Progression\n@var{expression}}' instructs the transfinite algorithm to distribute the\nnodes following a geometric progression (@code{Progression 2} meaning\nfor example that each line element in the series will be twice as long\nas the preceding one). The optional argument `@code{Using Bump\n@var{expression}}' instructs the transfinite algorithm to distribute the\nnodes with a refinement at both ends of the curve. @value{SYNC}"
msgstr ""

#. unit_id: 6c27d7aab3f29a9453d4b004e35ad7ba4fcf0bf984e283e3f77b84b0216da441
#. source_hash: b2c530b74b516858edb0637000cd64592f58166160c340af5c214fe545048ada
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|item|Transfinite Surface @{ @var{expression-list-or-all}  @}  < = @{ @var{expression-list} @} > < Left | Right | Alternate | AlternateRight | AlternateLeft > ;"
msgid "Transfinite Surface @{ @var{expression-list-or-all}  @}  < = @{ @var{expression-list} @} > < Left | Right | Alternate | AlternateRight | AlternateLeft > ;"
msgstr ""

#. unit_id: 697149dfeff6d988e69dc1bddfbbeb2a5342a393e7c9444f353d1a9092baa827
#. source_hash: f3dd163a369366ab57bbb1dfe6561d2bcbf959e4de3d7939060b5ceeb4c3ba1d
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|paragraph|Transfinite Surface @{ @var{expression-list-or-all}  @}  < = @{ @var{expression-list} @} > < Left | Right | Alternate | AlternateRight | AlternateLeft > ;"
msgid "Select surfaces to be meshed with the 2D transfinite algorithm. The\n@var{expression-list} on the right-hand-side should contain the tags of\nthree or four points on the boundary of the surface that define the\ncorners of the transfinite interpolation. If no tags are given, the\ntransfinite algorithm will try to find the corners automatically. The\noptional argument specifies the way the triangles are oriented when the\nmesh is not recombined. @code{Alternate} is a synonym for\n@code{AlternateRight}. For 3-sided surfaces a specific algorithm can be\nused to generate structured triangular by setting\n@code{Mesh.TransfiniteTri} to 1. Examples can be found in\n@url{@value{GITLAB-PREFIX}/benchmarks/transfinite,benchmarks/transfinite}.\n@value{SYNC}"
msgstr ""

#. unit_id: f9590dfbf3d10553c1b4bf78326330817ce5cc7dc37177744ff2ecc0b3e5b0b7
#. source_hash: 74b11f5ab64eb8078fddb8095ea57438ad5b5c499f68dda2e3d4e1cd8e98c472
