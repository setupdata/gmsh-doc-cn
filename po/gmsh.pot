#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|paragraph|Coherence Mesh;"
msgid "Remove all duplicate mesh nodes in the current mesh."
msgstr ""

#. unit_id: 0abace90dde5b872a61949f66e4d7e73906e0e0b1968e3e952b2e62dee8e9c8f
