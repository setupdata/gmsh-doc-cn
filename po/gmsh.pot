msgstr ""

#. unit_id: c8224e49fb902c1e86000ed2d95362ba9bfec78fbe5a62b0a613b1a89b3fae9a
#. source_hash: d7779a3eee9fdf822f5c800e805b975e5970f577e541ba572275eca75a7df7af
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|MSH file format version 2 (Legacy)|paragraph|d2d57a2c21b221c8c5a2c1bcc95485ce4663a1488a4be34afe1ef232ec1693d3"
msgid "The MSH file format version 2 is Gmsh's previous native mesh file\nformat, now superseded by the format described in @ref{MSH file\nformat}. It is defined as follows:"
msgstr ""

