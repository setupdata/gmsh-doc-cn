msgstr ""

#. unit_id: 955dbdbbf404df426a6c6c9b41c165bfcbcf916be83dcd9441b328375b4342c5
#. source_hash: 9c96c10666859da55c7901689d84407f9b2d328ea527af77121da9958669195f
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|paragraph|MeshSizeFromBoundary Surface @{ @var{expression-list} @} = @var{expression};"
msgid "Force the mesh size to be extended from the boundary (or not, depending\non the value of @var{expression}) for the surfaces\n@var{expression-list}."
