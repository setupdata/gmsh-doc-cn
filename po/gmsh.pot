#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|and what Gmsh is not so good at|heading|and what Gmsh is not so good at"
msgid "@dots{} and what Gmsh is not so good at"
msgstr ""

#. unit_id: 619f9a87de3ba77e9bfcd0b0ac3eda2db7b8f5d88e130cbdd142dca2936e6a48
#. source_hash: 0cd76336271dff14fe95122445c942b33020c39bfc3078cf77a04e7d96a85f7e
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|and what Gmsh is not so good at|paragraph|f5d85e77bc65de7bc9e90f73be67622f38a1c523dc1406b785ff7892f36b7c04"
msgid "Here are some known weaknesses of Gmsh:"
msgstr ""

#. unit_id: 789045bc0a5c32bf50f31b188f8c5508514382b7fb3de74946875065d36faadf
#. source_hash: 0ecf451eb718e8e601992512b12ab58c1806ae39921a95c43bf5eb277e8f32da
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|and what Gmsh is not so good at|paragraph|59b6ff2bbb8a8d3f11e1352cf6d2814ef09a22ed7fb5cec2a512285f1ede666a"
msgid "Gmsh is not a multi-bloc mesh generator: all meshes produced by Gmsh are\nconforming in the sense of finite element meshes;"
msgstr ""

#. unit_id: 24939a741c7321a54082d47a9dc0c6accd0443600b6f4878cd1437b1499c920f
#. source_hash: 956d1e7732dc350174149c23b2214a7f84e8cf38a3a1cf103d124190b0f7a744
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|and what Gmsh is not so good at|paragraph|a6dc8e5ad10f03ba1e2353b74e65d1f90e327afc3571694b31901aa2d76b27ab"
msgid "Gmsh's graphical user interface is only exposing a limited number of the\navailable features, and many aspects of the interface could be enhanced\n(especially manipulators)."
msgstr ""

#. unit_id: 8ad6aa5f8d20f2bd18df6aee394f22245f310881fe2286499b98079eabe2ae48
#. source_hash: 2920c082129a349b092c54aa92c4694f70277fe1b3a8a164a5544e26cc2ac933
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|and what Gmsh is not so good at|paragraph|3587489ab996a1a52601d4c7ed0358ad8b20c5e27ef2274f73645bde8164877c"
msgid "While Gmsh can create and manipulate geometries interactively, it is in\nno way a full-fledged replacement for an advanced CAD system."
msgstr ""

#. unit_id: 2dd6ba7396db4dca6fcda786a50d7bb2554d5edbe58e302c51580e064917df53
#. source_hash: 893753a94659b861f0c6da83a57646f2cd70283e69f8d58ad28c0d62d0084e2d
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|and what Gmsh is not so good at|paragraph|9cb08e39e50b280e9280008e0ea930828a6185186987e59a86ba410e33ac5c0f"
msgid "Gmsh uses straightforward OpenGL 1.1 for graphics, without specific\ntricks to handle very large meshes and post-processing datasets\n(decimation and automatic level of detail, culling, advanced\ntransparency, etc.)."
msgstr ""

#. unit_id: 7f038a75215644283bc44134964009a8ab2cfe9395d5087a4e9faae00bbe3401
#. source_hash: d0fd97c09b6b18646370b3f380a08bd85fbb5402590a05e087377da330586208
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|and what Gmsh is not so good at|paragraph|1bad32b25c5b891ebe6eba3248051255f8c127bc17f53420f24245011364ca0f"
msgid "Your complaints about Gmsh here :-)"
msgstr ""

#. unit_id: b43a4480cd8f093630f54ecca1946ce603a36a39ea5a0257af53c0ae146420ac
#. source_hash: daf986767eb1efb3863adec6012009fe32ffa9e0a38afb58a2dc890cad83103e
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|and what Gmsh is not so good at|paragraph|628ff26d2096fa2dfd7ce4612df88ac03af11de570f32f330765dd7f6a3cd0ba"
msgid "If you have the skills and some free time, feel free to join the\nproject: we gladly accept any code contributions (@pxref{Information for\ndevelopers}) to remedy the aforementioned (and all other) shortcomings!"
msgstr ""

#. unit_id: aa3773b0d3ad66d8c4e18df6d6d2a2c698b028b2f06f9c0ab9e772fae2935c53
#. source_hash: e2b7bdf4dd22aed0e9c64356c830d3d1697bcb2023db129fa86c0f4f5014fc8e
