#. unit_id: 2ad84d84caeb66952f1d044fef0839de73cf74563cfb3730615a2b4d4ceb55b9
#. source_hash: d614a0596b761985da51ea155e8168976d0866f12c6d62e9c1f73c02af82dce9
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.10.0"
msgid "2.10.0 (July 21, 2015): improved periodic meshing constraints; new Physical\nspecification with both label and numeric id; images can now be used as glyphs\nin post-processing views, using text annotations with the `file://' prefix;\nViews can be grouped and organized in subtrees; improved visibility browser\nnavigation; geometrical entities and post-processing views can now react to\ndouble-clicks, via new generic DoubleClicked options; new Get/SetNumber and\nGet/SetString for direct access to ONELAB variables; small bug fixes and code\ncleanups."
msgstr ""

#. unit_id: 38598ede437e54d21bd440d05a941baeedce2971aaae66d4eb1b80c7b8442f87
