msgid "BSpline ( @var{expression} ) = @{ @var{expression-list} @};"
msgstr ""

#. unit_id: 8d5b722e1a7f8a4362f9fc527949fc5e5ea9e0aba7051899c4df0f07c3439cf4
#. source_hash: 7c39cce8dba661caa290af9fdc50ed55ccc31342d02ad89aef4e2a09ec8472a0
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Curves|paragraph|BSpline ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Create a cubic BSpline. The @var{expression-list} contains the tags of\nthe control points. Creates a periodic curve if the first and last\npoints are identical."
msgstr ""

#. unit_id: 55c05547fa09ea990ee4bb26995343e35cef6f7d1a15ba582d639b4023ff81ca
#. source_hash: 053648a35a4813bd65570903820b980ccae7d398d2af0a71482b2303a4027fa1
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Curves|item|Spline ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Spline ( @var{expression} ) = @{ @var{expression-list} @};"
msgstr ""

#. unit_id: b1c70a8aa66a205486efcc0fbdfe5b8777f81159938a126eaf96ca03f3d88ade
#. source_hash: 8b47b065f419d96b8226b38fa7124e4946a6df799011c0900347a007d6641648
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Curves|paragraph|Spline ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Create a spline going through the points in @var{expression-list}. With\nthe built-in geometry kernel this constructs a Catmull-Rom spline. With\nthe OpenCASCADE kernel, this constructs a C2 BSpline. Creates a periodic\ncurve if the first and last points are identical."
msgstr ""

#. unit_id: 3c91cc63197a3e3540e557b908844a57ee72cec7194695ec057e240855384e25
#. source_hash: d41fc685268cd88f185e46ad757bf57ae97e3642e6edb65f92ce4491b3ee4a3f
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Curves|item|Circle ( @var{expression} ) = @{ @var{expression}, @var{expression}, @var{expression} <, ...> @};"
msgid "Circle ( @var{expression} ) = @{ @var{expression}, @var{expression}, @var{expression} <, ...> @};"
msgstr ""

#. unit_id: ae544d498bd9848f8634dfea3cb362e924ce68fb342abd0eda56b0ef82d52e9c
#. source_hash: facbebf6efd0aad67ae9e2acec652b045730fcd144945747bd9b40b65e51e983
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Curves|paragraph|Circle ( @var{expression} ) = @{ @var{expression}, @var{expression}, @var{expression} <, ...> @};"
msgid "Create a circle arc. If three @var{expression}s are provided on the\nright-hand-side they define the start point, the center and the end\npoint of the arc; the three points should not be colinear. With the\nbuilt-in geometry kernel the arc should be strictly smaller than\nPi. With the OpenCASCADE kernel, if between 4 and 6 expressions are\nprovided the arc is created in the X-Y plane: the first three define the\ncoordinates of the center, the next one defines the radius, and the\noptional next two the start and end angle."
msgstr ""

#. unit_id: ab7f923cbc9f66ff80da96f8cccdbd567d5c00a8667068642a53fa4d5d97d566
#. source_hash: 65f5cb801c65a6d87f0d5370f4bd974c001c237226aec516802713a02e17c0a8
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Curves|item|Ellipse ( @var{expression} ) = @{ @var{expression}, @var{expression}, @var{expression} <, ...> @};"
msgid "Ellipse ( @var{expression} ) = @{ @var{expression}, @var{expression}, @var{expression} <, ...> @};"
msgstr ""

#. unit_id: 4e453562509f23c789f17598c69715e1258cfd3c554590e19f2621c48dfd99a8
#. source_hash: 790ce3dfc8f5ab53f30c006184240ab9a0f3b84a0c8ce29affd10afd9ae72860
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Curves|paragraph|Ellipse ( @var{expression} ) = @{ @var{expression}, @var{expression}, @var{expression} <, ...> @};"
msgid "Create an ellipse arc. If four @var{expression}s are provided on the\nright-hand-side they define the start point, the center point, a point\nanywhere on the major axis and the end point. If the first point is a\nmajor axis point, the third expression can be ommitted. With the\nOpenCASCADE kernel, if between 5 and 7 expressions are provided, the\nfirst three define the coordinates of the center, the next two define\nthe major (along the x-axis) and minor radii (along the y-axis), and the\nnext two the start and end angle. Note that OpenCASCADE does not allow\ncreating ellipse arcs with the major radius smaller than the minor\nradius."
msgstr ""

#. unit_id: 3685bb8222145468535ab9d8d60f2477294edd164b573f4758e0b51fb4510d29
#. source_hash: 37c84e49964e652bbd1d09afbf1bcf5697e936a55cec907571ee31c73c6b0c1f
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Curves|item|Compound Spline | BSpline ( @var{expression} ) = @{ @var{expression-list} @} Using @var{expression};"
msgid "Compound Spline | BSpline ( @var{expression} ) = @{ @var{expression-list} @} Using @var{expression};"
msgstr ""

#. unit_id: bb1b4c72abdc2b53ae065573f56c167eb51a3ff6dedd84a00384dc68a9d067d0
#. source_hash: b821a9c64089d4f854798fedb5d1b43a51e5ce769e9508467f77fa66f9fda0c5
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Curves|paragraph|Compound Spline | BSpline ( @var{expression} ) = @{ @var{expression-list} @} Using @var{expression};"
msgid "Create a spline or a BSpline from control points sampled on the curves\nin @var{expression-list}. @code{Using} @var{expression} specifies the\nnumber of intervals on each curve to compute the sampling\npoints. Compound splines and BSplines are only available with the\nbuilt-in geometry kernel."
msgstr ""

#. unit_id: 1c8e18642db09d17b42612d4a7119083f4172129df896d66c39937b68318c424
#. source_hash: d4333ed5a46bc345678cf33dd6a797996eb3dc7127bf229c2c600f6d54f180ee
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Curves|item|Curve Loop ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Curve Loop ( @var{expression} ) = @{ @var{expression-list} @};"
msgstr ""

#. unit_id: 468269ba2507b40ccc400badd83b746a14c9d309b6fa6d599f92577c06c030ea
#. source_hash: 252e053c14e776c592a3252125f75900557e7ef61f9a8329c71ef521b6fc4e59
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Curves|paragraph|Curve Loop ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Create an oriented loop of curves, i.e. a closed wire. The\n@var{expression} inside the parentheses is the curve loop's tag; the\n@var{expression-list} on the right hand side should contain the tags of\nall the curves that constitute the curve loop. A curve loop must be a\nclosed loop. With the built-in geometry kernel, the curves should be\nordered and oriented, using negative tags to specify reverse\norientation. (If the orientation is correct, but the ordering is wrong,\nGmsh will actually reorder the list internally to create a consistent\nloop; the built-in kernel also supports multiple curve loops (or\nsubloops) in a single @code{Curve Loop} command, but this is not\nrecommended). With the OpenCASCADE kernel the curve loop is always\noriented according to the orientation of its first curve; negative tags\ncan be specified for compatibility with the built-in kernel, but are\nsimply ignored. Curve loops are used to create surfaces: see\n@ref{Surfaces}."
msgstr ""

#. unit_id: 460af2a254242383405f014f91984972f54e7d5c66ae1718ba5726bbb98ca0ef
#. source_hash: 243385871342940971c3caadc5c2058fa9e9b282840f48e6973aa391078216ee
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Curves|item|Wire ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Wire ( @var{expression} ) = @{ @var{expression-list} @};"
msgstr ""

#. unit_id: b1e29996d5ee073377cc273b0c01ebaf61fd50882e4dbe3e3d52567c19574057
#. source_hash: 3d7c19b6386e8d20e0ad66e980040144a12949428dae05b4b65857d1e24f68c1
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Curves|paragraph|Wire ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Create a path made of curves. Wires are only available with the\nOpenCASCADE kernel. They are used to create @code{ThruSections} and\nextrusions along paths."
msgstr ""

#. unit_id: 40957ad18442b45da3faddd3c8479204334dcd0d68e340fc10fec43e88357e77
#. source_hash: ac595133faed1610bb4a37568f8552086797890d1093f1107dcd9b2bbcfa6848
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Curves|item|Physical Curve ( @var{expression} | @var{string-expression} <, @var{expression}> ) <+|->= @{ @var{expression-list} @};"
msgid "Physical Curve ( @var{expression} | @var{string-expression} <, @var{expression}> ) <+|->= @{ @var{expression-list} @};"
msgstr ""

#. unit_id: f906077fae1cdfc8a3186b92531fd82b9eb740644274446e4c3b23ca5c7b4167
#. source_hash: d84bd841c05cd40950d429c31b8e784cf0d3d9876319aeafea91dd78fc7b4cb0
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Curves|paragraph|Physical Curve ( @var{expression} | @var{string-expression} <, @var{expression}> ) <+|->= @{ @var{expression-list} @};"
msgid "Create a physical curve. The @var{expression} inside the parentheses is\nthe physical curve's tag; the @var{expression-list} on the right hand\nside should contain the tags of all the elementary curves that need to\nbe grouped inside the physical curve. If a @var{string-expression} is\ngiven instead instead of @var{expression} inside the parentheses, a\nstring label is associated with the physical tag, which can be either\nprovided explicitly (after the comma) or not (in which case a unique tag\nis automatically created). In some mesh file formats (e.g. MSH2),\nspecifying negative tags in the @var{expression-list} will reverse the\norientation of the mesh elements belonging to the corresponding\nelementary curves in the saved mesh file."
msgstr ""

