msgid "in\n@url{@value{GITLAB-PREFIX}/src/common/DefaultOptions.h,src/common/DefaultOptions.h},\ngive a name (for the parser to be able to access it), a reference to a\nhandling routine (i.e. @code{opt_XXX}) and a default value for this\noption;"
msgstr ""

#. unit_id: 1ba112944eae2de4d8f3c5863e486fb8bac5b194c13e01a5db4f7f49aa8fb84a
#. source_hash: 519b19d5bfe8db16895f0dc8631025d7899f4d1dbba03cc2e553ee63247ead06
