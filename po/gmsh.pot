msgctxt "doc/texinfo/gmsh.texi|Structured grids|item|Transfinite Volume @{ @var{expression-list} @} < = @{ @var{expression-list} @} > ;"
msgid "Transfinite Volume @{ @var{expression-list} @} < = @{ @var{expression-list} @} > ;"
msgstr ""

#. unit_id: e8f3915a566fd4551f318c061a3de84871f561a81fe6a607acacf63fbf141fe3
#. source_hash: 671ab2fc3ab8a002a22744f25ede7e15e31a6a17f733eee4997899ce75f666fd
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Structured grids|paragraph|Transfinite Volume @{ @var{expression-list} @} < = @{ @var{expression-list} @} > ;"
msgid "Select five- or six-face volumes to be meshed with the 3D transfinite\nalgorithm.  The @var{expression-list} on the right-hand-side should\ncontain the tags of the six or eight points on the boundary of the\nvolume that define the corners of the transfinite interpolation. If no\ntags are given, the transfinite algorithm will try to find the corners\nautomatically. @value{SYNC}"
msgstr ""

#. unit_id: b29f696a2823259eaed77892358abaf8da5643ed737236264711202841614039
