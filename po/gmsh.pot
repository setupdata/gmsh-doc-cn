msgid "Volume ( @var{expression} ) = @{ @var{expression-list} @};"
msgstr ""

#. unit_id: bf5c6d0ff4fca2647f266f61de11600ed806dfe61cef919739321bc4f0bce90e
#. source_hash: 6a18f8253ca32baa91bcce5afe7d7d1e451586fb215d18f7b6f40ee29fb61b4a
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Volumes|paragraph|Volume ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Create a volume. The @var{expression} inside the parentheses is the\nvolume's tag; the @var{expression-list} on the right hand\nside should contain the tags of all the surface loops\ndefining the volume. The first surface loop defines the exterior boundary of\nthe volume; all other surface loops define holes in the volume.  A surface\nloop defining a hole should not have any surfaces in common with the\nexterior surface loop (in which case it is not a hole, and the two volumes\nshould be defined separately). Likewise, a surface loop defining a hole\nshould not have any surfaces in common with another surface loop defining a\nhole in the same volume (in which case the two surface loops should be\ncombined)."
msgstr ""

#. unit_id: 92820f9461d5ff2bf90a7bd0408ceccb7210d643c2eb33dbb5ad6980e22edeb6
#. source_hash: 84cbd13ecfdb113b5ae2b623b842cbb2c110ffe8f1e06cd8668cfd27128a2642
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Volumes|item|Sphere ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Sphere ( @var{expression} ) = @{ @var{expression-list} @};"
msgstr ""

#. unit_id: 0f52f396b1a7665024ac57ac5f4b6a5b8f57e08fe749a8e9d31f428450bb0044
#. source_hash: 0707e2a78699d887f40aec478e2ba6c2468a3795cf6110201369d7f689418a91
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Volumes|paragraph|Sphere ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Create a sphere, defined by the 3 coordinates of its center and a\nradius. Additional expressions define 3 angle limits. The first two\noptional arguments define the polar angle opening (from -Pi/2 to\nPi/2). The optional `angle3' argument defines the azimuthal opening\n(from 0 to 2*Pi). @code{Sphere} is only available with the OpenCASCADE\nkernel."
msgstr ""

#. unit_id: 67b48ed8107a049aef7a627976e7d0454c48e8dd0768f564f57febc6443924fe
#. source_hash: debd4480b04a1b747762f30b19e7b63c1b2b4161276cefd516a4ba9f3e680f02
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Volumes|item|Box ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Box ( @var{expression} ) = @{ @var{expression-list} @};"
msgstr ""

#. unit_id: 4ef5ccbe2ba947c8facd6756d54c9295a189bf44404a988cb3ac305c42115b66
#. source_hash: 996f9b85f1fb726f89827fbda77770b7eebfee7882fbbe9d92e79a5dc0fbe515
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Volumes|paragraph|Box ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Create a box, defined by the 3 coordinates of a point and the 3\nextents. @code{Box} is only available with the OpenCASCADE kernel."
msgstr ""

#. unit_id: 0d7af40b77c591673ea55ad8f4beafbb6476c1d851e998d3c7fecae65d7bb4c6
#. source_hash: bbbe3755dda3f7ae5fd13ddfa383e6a866495273d93341d67e806778f59e9985
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Volumes|item|Cylinder ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Cylinder ( @var{expression} ) = @{ @var{expression-list} @};"
msgstr ""

#. unit_id: 7586a3af869138616dccb1f8f65c293667cfbed94aca7eac675ce672a3961433
#. source_hash: 1b65c508e0ebf4235481b49949c5b37c367114a7da5b3e6cef0f5c3c66f23937
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Volumes|paragraph|Cylinder ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Create a cylinder, defined by the 3 coordinates of the center of the\nfirst circular face, the 3 components of the vector defining its axis\nand its radius. An additional expression defines the angular\nopening. @code{Cylinder} is only available with the OpenCASCADE kernel."
msgstr ""

#. unit_id: 17d5eb9be9411ebabda20a78a47d015f508ff025283a48f75b514caffe81e534
#. source_hash: b85dc3256414401521d0210b331e4bbd76e29b38cd41e4fab6bd56d2155d0ad0
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Volumes|item|Torus ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Torus ( @var{expression} ) = @{ @var{expression-list} @};"
msgstr ""

#. unit_id: 3811b7fe45c35fb1e3aeaa894dbcdc3424c935bb8eb363c913f0d9e6cdbe5a7b
#. source_hash: 0f87ac196b7cdbeb3d4ddfa49303c4e897fcf2a0430dca398b3b55ed9ea601ca
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Volumes|paragraph|Torus ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Create a torus, defined by the 3 coordinates of its center and 2 radii.\nAn additional expression defines the angular opening. @code{Torus} is\nonly available with the OpenCASCADE kernel."
msgstr ""

#. unit_id: b4383bb8becf78967201ce434cbbb33c22c273fbdcb24af61002eb67f5f13e5c
#. source_hash: 0d8cc0da62edb4f2bdfc50a1394c9a9a1707a94bd0f105e176ebc11d84a435ee
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Volumes|item|Cone ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Cone ( @var{expression} ) = @{ @var{expression-list} @};"
msgstr ""

#. unit_id: de21bfeaa949d14703eaf030b962f983c73b963ba71311e99be23d8996526c48
#. source_hash: 3e2433d8c89a752f03c22e51c0ceb6d81376620e20a04e958db5911e946f5e86
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Volumes|paragraph|Cone ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Create a cone, defined by the 3 coordinates of the center of the first\ncircular face, the 3 components of the vector defining its axis and the\ntwo radii of the faces (these radii can be zero). An additional\nexpression defines the angular opening. @code{Cone} is only available\nwith the OpenCASCADE kernel."
msgstr ""

#. unit_id: feae4c1cf87463dbf001c5604ed1f2793a65f123ab4ef2b995623d0280920504
#. source_hash: 8aafe0509d1d4ec0ec320eba1f471b017ad1e14fc4eb76b27e88812fc7765fb0
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Volumes|item|Wedge ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Wedge ( @var{expression} ) = @{ @var{expression-list} @};"
msgstr ""

#. unit_id: 6e32cae673d0ba492ee3f2ae30d6deea3fa3498fc98682583baa71e6bd088182
#. source_hash: d5147ef966177b46e10fd862bc57f1a06571add3b77a8e434ca1974c88ec2f76
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Volumes|paragraph|Wedge ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Create a right angular wedge, defined by the 3 coordinates of the\nright-angle point and the 3 extends. An additional parameter defines the\ntop X extent (zero by default). @code{Wedge} is only available with the\nOpenCASCADE kernel."
msgstr ""

#. unit_id: 6bf1f6a14755c9fe6b7d8fb20c1ccc8c104d456cfb499efcec3107fac81d43d6
#. source_hash: 79ce46ae81cbc9513edc878cb9bab9a45b64e08fbf97b413420bfdf6382264a5
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Volumes|item|ThruSections ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "ThruSections ( @var{expression} ) = @{ @var{expression-list} @};"
msgstr ""

#. unit_id: 1413208b22b85b916bca4935a763f455b4aac48cb0d4519387fa9ed761479828
#. source_hash: 88bbdf118a3365bc20455a1e38630d973667966c121ac59c6b7ac1cc99b53597
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Volumes|paragraph|ThruSections ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Create a volume defined through curve loops. @code{ThruSections} is only\navailable with the OpenCASCADE kernel."
msgstr ""

#. unit_id: 08cef5d4b87abbf4cf228294e1b9f6b4d62d01c8b4da7ae88327fb2970a4f3a6
#. source_hash: 9e49588f1560aeb354738babd5f336bf7e23ddb328c1bf879cc6899b3390d24d
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Volumes|item|Ruled ThruSections ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Ruled ThruSections ( @var{expression} ) = @{ @var{expression-list} @};"
msgstr ""

#. unit_id: 72ba0672190e9f97cc3333b04152b59b02e34711eb6149440db7a9742d522723
#. source_hash: 939b55ac6ab9873f24b5910ce86490a1c14b2a82e26315d467a476c5e6710a85
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Volumes|paragraph|Ruled ThruSections ( @var{expression} ) = @{ @var{expression-list} @};"
msgid "Same as @code{ThruSections}, but the surfaces created on the boundary\nare forced to be ruled. @code{Ruled ThruSections} is only available with\nthe OpenCASCADE kernel."
msgstr ""

#. unit_id: 9707ea408b233dc3cd1f9b9e24832ecc9dc5d1860f568ab0f7498782c95a2238
#. source_hash: 22ac721e9a87684c6ab42e9fda9871f11f3de1acdae03f7ab9c8182d25d531cc
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Volumes|item|Physical Volume ( @var{expression} | @var{string-expression} <, @var{expression}> ) <+|->= @{ @var{expression-list} @};"
msgid "Physical Volume ( @var{expression} | @var{string-expression} <, @var{expression}> ) <+|->= @{ @var{expression-list} @};"
msgstr ""

#. unit_id: 3e061cb4077f152511f9f8e5c36d6753bcc5bd9c8911b4e38c602f7948d53403
