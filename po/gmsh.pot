#. unit_id: a19c240dfa422da0ce3d674a9482f62ef6ed699c79690e45e458f15714db4648
#. source_hash: da61e23e22aaa5b063c22cce752d301e5e4c6999044fe838b2c11fd91620ca61
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|4.15.1"
msgid "4.15.1 (February 16, 2026): improved handling of anisotropic surface meshes in\n3D Delaunay; bug fixes."
msgstr ""

#. unit_id: b78387711b6d34a5038b4751bd7334636d4f2e01bc80a2c772b594389e1c087b
#. source_hash: e29ca9ff54846d55b0b85b35e90b8c6ae6ece8ba7ec24512b2b8be9ede0ebe8e
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|4.15.0"
msgid "4.15.0 (October 26, 2025): new Closest, Parametric Point and Normal parser\nfunctions; changed Boundary and CombinedBoundary parser functions to not return\nsigned entity tags anymore (use new OrientedBoundary and\nOrientedCombinedBoundary to get the old behavior); changed default value of\noriented argument to false in model/getBoundary API; new fltk/run() option to\nautomatically load/save options between runs; improved Constant and Restrict\nmesh size fields; reverted curve drawing to use fixed number of subdivisions;\nlevelset-based plugins now take entity visibility into account; bug fixes."
msgstr ""

#. unit_id: bf2b2e24755eba1a41349cbc338f1dfcc6b46a7d63d02a2ca17e12689b1ff14e
#. source_hash: c83bdb23d4c65a2912210c7668837bd586d27e346292aa36e802e9669c95e65e
