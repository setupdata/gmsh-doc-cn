msgid "* New API functions: occ/getDistance, occ/fillet2D, occ/chamfer2D,\n  occ/offsetCurve, occ/defeature, mesh/removeElements, option/restoreDefaults,\n  logger/getMemory, logger/getTotalMemory."
msgstr ""

