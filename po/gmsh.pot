msgctxt "CHANGELOG.txt|Version history|paragraph|2.8.2"
msgid "2.8.2 (Jul 16, 2013): improved high order tools interface; minor bug fixes."
msgstr ""

#. unit_id: 6490dc5899b53ef30c591b18c68274203ad13564a1f1528a2e612dd379c84084
#. source_hash: 6e331a46d983aa7b52b388156a1054d41615ee3433eb794bed0ac384efa67168
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.8.1"
msgid "2.8.1 (Jul 11, 2013): improved compound surfaces and transfinite arrangements."
msgstr ""

#. unit_id: 432c4255df082e7cb38b65fd87d06e5a9aee258b3c0e48dcadf2fabc30e7bf53
#. source_hash: 65c8504a5a3ec89b5a6c1d8cf7360f46330a1e28162d7a3baefbb2e0eedf5668
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.8.0"
msgid "2.8.0 (Jul 8, 2013): improved Delaunay point insertion; fixed mesh orientation\nof plane surfaces; fixed mesh size prescribed at embedded points; improved\ndisplay of vectors at COG; new experimental text string display engines;\nimproved fullscreen mode; access time/step in transformations; new experimental\nfeatures: AdaptMesh and Surface In Volume; accept unicode file paths on Windows;\ncompilation and bug fixes."
msgstr ""

#. unit_id: c332d374bc19994814737790a9295357c5ae18717b9ee67488fb0f13b00b57e0
#. source_hash: 98d77a7fd9bb4122d98a83c93636084b6fef9cfccd992c977f97c01a92a31c4c
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.7.1"
msgid "2.7.1 (May 11, 2013): improved Delaunay point insertion; updated onelab; better\nAbaqus and UNV export; small bug and compilation fixes."
msgstr ""

#. unit_id: 01bfa817eac0fff5381426f7a82cdd9bdd5ded887934b74f31faccb06125d1cc
#. source_hash: 28a7cd233b5baeb7c14148db40f2c4033b1cf0abf0dea9abf71424970eec7e5f
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.7.0"
msgid "2.7.0 (Mar 9, 2013): new single-window GUI, with dynamically customizable\nwidget tree; faster STEP/BRep import; arbitrary size image export; faster 2D\nDelaunay/Frontal algorithms; full option viewer/editor; many bug fixes."
msgstr ""

#. unit_id: 30acb15e0e73978afb26991c89e57cac84f28609b4af6d411280cd48f5e2a33e
#. source_hash: 319217450918fc08d989693421261a25b015bcfd3745f2ef6221f74901efa765
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.6.1"
msgid "2.6.1 (Jul 15, 2012): minor improvements and bug fixes."
msgstr ""

#. unit_id: 78e99c7c0d2065b20eb9675cbfebd01e4e0d51aab0e5e14459d16ad41449cadf
#. source_hash: 82687c3c00280e11bde7ac31b71422693cd670e9ccd985637386b63b5103c68c
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.6.0"
msgid "2.6.0 (Jun 19, 2012): new quadrilateral meshing algorithms (Blossom and\nDelaunay-Frontal for quads); new solver module based on ONELAB project (requires\nFLTK 1.3); new tensor field visualization modes (eigenvectors, ellipsoid, etc.);\nadded support for interpolation schemes in .msh file; added support for MED3\nformat; rescale viewport around visible entities (shift+1:1 in GUI); unified\npost-processing field export; new experimental stereo+camera visualization mode;\nadded experimental BAMG & Mmg3D support for anisotropic mesh generation; new OCC\ncut & merge algorithm imported from Salome; new ability to connect extruded\nmeshes to tetrahedral grids using pyramids; new homology solver; Abaqus (INP)\nmesh export; new Python and Java wrappers; bug fixes and small improvements all\nover the place."
msgstr ""

#. unit_id: 5557a41ea3a449491d2b0e3baa62eb95846a4f7391e08e613516ba96c5dccee1
#. source_hash: 12fa60c326de1ea68750b54085e5a6be11786f8014875c17397a076992889772
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.5.0"
msgid "2.5.0 (Oct 15, 2010): new compound geometrical entities (for remeshing and/or\ntrans-patch meshing); improved mesh reclassification tool; new client/server\nvisualization mode; new ability to watch a pattern of files to merge; new\nintegrated MPEG export; new option to force the type of views dynamically;\nbumped mesh version format to 2.2 (small change in the meaning of the partition\ntags; this only affects partitioned (i.e. parallel) meshes); renamed several\npost-processing plugins (as well as plugin options) to make them easier to\nunderstand; many bug fixes and usability improvements all over the place."
msgstr ""

#. unit_id: 01f38054ea208967f582f37a4cf7875d77ecba09df70abdfb9cf47990b7447af
#. source_hash: 4b53eb1cf888fda9ba68de6513604db71f4ad4bbc861a24878811db41c4782c2
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.4.2"
msgid "2.4.2 (Sep 21, 2009): solver code refactoring + better IDE integration."
msgstr ""

#. unit_id: 8e8a44586f3f14071743f52cc0249e0fa953c07bcf03edbd228aff7e73958972
#. source_hash: f691b5ec04f712648d67bacf8bf6b404a431e99981b729091f190271be14e47d
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.4.1"
msgid "2.4.1 (Sep 1, 2009): fixed surface mesh orientation bug introduced in 2.4.0;\nmesh and graphics code refactoring, small usability enhancements and bug fixes."
msgstr ""

#. unit_id: 22c0c03d4db460b78ba0040760a9e4b98d477cf5ac6d65c5131a86915fdf9763
#. source_hash: 1711768c377e3d018c872c8f18df8815bcf8c87b4510af7412916b6523ff7a42
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.4.0"
msgid "2.4.0 (Aug 22, 2009): switched build system to CMake; optionally copy\ntransfinite mesh constraints during geometry transformations; bumped mesh\nversion format to 2.1 (small change in the $PhysicalNames section, where the\ngroup dimension is now required); ported most plugins to the new\npost-processing API; switched from MathEval to MathEx and Flu_Tree_Browser to\nFl_Tree; small bug fixes and improvements all over the place."
msgstr ""

#. unit_id: 3078f5acd6e228c07b31d8ef5f923d771902cc993a98de2383347b918dad1deb
#. source_hash: aa4bcb236286dada4def7cf5f5d31b90ddc51aca88bd76c7767b0d807dd55a52
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.3.1"
msgid "2.3.1 (Mar 18, 2009): removed GSL dependency (Gmsh now simply uses Blas and\nLapack); new per-window visibility; added support for composite window printing\nand background images; fixed string option affectation in parser; fixed surface\nmesh orientation for OpenCASCADE models; fixed random triangle orientations in\nDelaunay and Frontal algorithms."
msgstr ""

#. unit_id: 6aca599c48eb48ee92bde71db951666992c081f2e5b63034ade001bdeee4ced6
#. source_hash: 9a7137fd7f1a664747f50dc7449535ff78da5e186043b70820f0818222ffe05e
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.3.0"
msgid "2.3.0 (Jan 23, 2009): major graphics and GUI code refactoring; new\nfull-quad/hexa subdivision algorithm; improved automatic transfinite corner\nselection (now also for volumes); improved visibility browser; new automatic\nadaptive visualization for high-order simplices; modified arrow size, clipping\nplanes and transform options; many improvements and bug fixes all over the\nplace."
msgstr ""

#. unit_id: 28c1f034eb321f36d668e79fcf076dcaa5b2c0c43a5dadef99170f0b2d96daaf
#. source_hash: 0af0507adb370ac1904ecee9cea000cf5801821178940af321b589a7219dedcc
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.2.6"
msgid "2.2.6 (Nov 21, 2008): better transfinite smoothing and automatic corner\nselection; fixed high order meshing crashes on Windows and Linux; new uniform\nmesh refinement (thanks Brian!); fixed various other small bugs."
msgstr ""

#. unit_id: af1fc07de35a7b38d3c0f2fca6f38b74d12f34fb080c00fea80d4a1a5544eb41
#. source_hash: 7887f74a1aa1c9dca35beb285d95e7ee06341ff18b6e19361feec26d037273fc
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.2.5"
msgid "2.2.5 (Oct 25, 2008): Gmsh now requires FLTK 1.1.7 or above; various small\nimprovements (STL and VTK mesh I/O, Netgen upgrade, Visual C++ support, Fields,\nMesh.{Msh,Stl,...}Binary changed to Mesh.Binary) and bug fixes (pyramid\ninterpolation, Chaco crashes)."
msgstr ""

#. unit_id: 38b17624777207e74781f10cd00acab0a4a955fde3d8a18ccecee2ada338fe0f
#. source_hash: f0641020d43ecccacd2dfd74c7323f0f387414de2bd044a437d1c856387b4e6c
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.2.4"
msgid "2.2.4 (Aug 14, 2008): integrated Metis and Chaco mesh partitioners; variables\ncan now be deleted in geo files; added support for point datasets in model-based\npostprocessing views; small bug fixes."
msgstr ""

#. unit_id: 48fcfdee79b2a7346d7c398f3a9efbf1c4417ffc1e0eb19c11f2c8add0629c1b
#. source_hash: 82a5f31c530ca537efab09da0f9606ddcac2a285fd2b97340f41ff43e5533c8d
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.2.3"
msgid "2.2.3 (Jul 14, 2008): enhanced clipping interface; API cleanup; fixed various\nbugs (Plugin(Integrate), high order meshes, surface info crash)."
msgstr ""

#. unit_id: 11260e35d885a3fa3c69de7e9435b34b680b6e6e59ff701aa391abe4e5e61569
#. source_hash: 0db5d244ba9d8bc66190bcd6ee90aaec0e6d07a632273cf8c61a347eb7e1d9b2
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.2.2"
msgid "2.2.2 (Jun 20, 2008): added geometrical transformations on volumes; fixed bug in\nhigh order mesh generation."
msgstr ""

#. unit_id: 26f1737be44334876e8b3e12312cd214b8f66faeb6e844f02b17394b71d3e8a7
#. source_hash: afffbc1f83edf255b54dfa80c79e9537e1a3779f8ef28acc33aa84a9f8768bbc
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.2.1"
msgid "2.2.1 (Jun 15, 2008): various small improvements (adaptive views, GUI, code\ncleanup) and bug fixes (high order meshes, Netgen interface)."
msgstr ""

#. unit_id: 491deb68e48c02cba3028c77091152cf8f3595c9710df2bd535e7e1d8c2116e9
#. source_hash: c8b5d1dd334a5e34942878b16f63d42a734cfba52c7df20326d615c569a38eff
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.2.0"
msgid "2.2.0 (Apr 19, 2008): new model-based post-processing backend; added MED I/O for\nmesh and post-processing; fixed BDF vertex ordering for 2nd order elements;\nreplaced Mesh.ConstrainedBackgroundMesh with\nMesh.CharacteristicLength{FromPoints,ExtendFromBoundary}; new Fields interface;\ncontrol windows are now non-modal by default; new experimental 2D frontal\nalgorithm; fixed various bugs."
msgstr ""

#. unit_id: a3911fa60de51326794fb93cac294854d6dbbcc85794ce30017f7e5cb93e4e79
#. source_hash: f89d7ad82120d61d8af377aefe91aef223ded783a1b4d0e52815cd14e439fd8a
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.1.1"
msgid "2.1.1 (Mar 1, 2008): small bug fixes (second order meshes, combine views, divide\nand conquer crash, ...)."
msgstr ""

#. unit_id: 9772f34f84ef3552b1f5c509d3e8251745b078dac363d89832f3f9459f8cf465
#. source_hash: 5af63fed5b68fbdcd74cfccda0f5abbc6036dbd7232a439d54e85d699b4ff697
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.1.0"
msgid "2.1.0 (Feb 23, 2008): new post-processing database; complete rewrite of\npost-processing drawing code; improved surface mesh algorithms; improved\nSTEP/IGES/BREP support; new 3D mesh optimization algorithm; new default native\nfile choosers; fixed 'could not find extruded vertex' in extrusions; many\nimprovements and bug fixes all over the place."
msgstr ""

#. unit_id: 81cb4804d300caa914f55bf90dd44095b6df1df9904f935042323f6008b01b7e
#. source_hash: bc813af9ae6e5619d01e04b17928f49d142bb7efdd686d1d2d21efdf18915478
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.0.8"
msgid "2.0.8 (Jul 13, 2007): unused vertices are not saved in mesh files anymore; new\nplugin GUI; automatic GUI font size selection; renamed\nPlugin(DecomposeInSimplex) into Plugin(MakeSimplex); reintroduced enhanced\nPlugin(SphericalRaise); clarified meshing algo names; new option to save groups\nof nodes in UNV meshes; new background mesh infrastructure; many small\nimprovements and small bug fixes."
msgstr ""

#. unit_id: 55d6f5b8114428edab5be1c0c317c45846d79461e4b3e1556c57bcca05c84d85
#. source_hash: 5d3dd9868324f4c794a15be9fe33e4bbbd426c03826c1d0f14ba9e0ed9c09af3
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.0.7"
msgid "2.0.7 (Apr 3, 2007): volumes can now be defined from external CAD surfaces;\nDelaunay/Tetgen algorithm is now used by default when available; re-added\nsupport for Plot3D structured mesh format; added ability to export external CAD\nmodels as GEO files (this only works for the limited set of geometrical\nprimitives available in the GEO language, of course--so trying to convert e.g. a\ntrimmed NURBS from a STEP file into a GEO file will fail); \"lateral\" entities\nare now added at the end of the list returned by extrusion commands; fixed\nvarious bugs."
msgstr ""

#. unit_id: ab155cc1e3fea795af43b6f9af0aa7221068380ce9496092104bc930abaa124e
#. source_hash: 329eac634017b82c7a3f3ac208de00985e4f9563c6f716c398c5c9ed356895eb
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.0.0"
msgid "2.0.0 (Feb 5, 2007): new geometry and mesh databases, with support for STEP and\nIGES import via OpenCASCADE; complete rewrite of geometry and mesh drawing\ncode; complete rewrite of mesh I/O layer (with new native binary MSH format and\nsupport for import/export of I-deas UNV, Nastran BDF, STL, Medit MESH and VRML\n1.0 files); added support for incomplete second order elements; new 2D and 3D\nmeshing algorithms; improved integration of Netgen and TetGen algorithms;\nremoved anisotropic meshing algorithm (as well as attractors); removed explicit\nregion number specification in extrusions; option changes in the graphical\ninterface are now applied instantaneously; added support for offscreen rendering\nusing OSMesa; added support for SVG output; added string labels for Physical\nentities; lots of other improvements all over the place."
msgstr ""

#. unit_id: 1143de77e69357b9562dfc812285eea163c52e78de982ced673536777092e21e
#. source_hash: 39fa98cb267c0cfeda779362241e78d5ccd8bc6f7ff2ce03e54650b3d501c648
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.65"
msgid "1.65 (May 15, 2006): new Plugin(ExtractEdges); fixed compilation errors with\ngcc4.1; replaced Plugin(DisplacementRaise) and Plugin(SphericalRaise) with the\nmore flexible Plugin(Warp); better handling of discrete curves; new Status\ncommand in parser; added option to renumber nodes in .msh files (to avoid holes\nin the numbering sequence); fixed 2 special cases in quad->prism extrusion;\nfixed saving of 2nd order hexas with negative volume; small bug fixes and\ncleanups."
msgstr ""

#. unit_id: 8b5be8b06b544de6f33a1332e8417277fc6c92cc24aa537fbb2d817cb38f37e6
#. source_hash: 37662662805fb8228d5a20700b46575f075a9f0f7c9dee1bbdd5930249b71119
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.64"
msgid "1.64 (Mar 18, 2006): Windows versions do no depend on Cygwin anymore; various\nbug fixes and cleanups."
msgstr ""

#. unit_id: 89ed7a3f8c793dcf74653d21ad328c2e22120175a2f094d7b0afa6d71f9e8af2
#. source_hash: 3ac0825211339418408d25a2c226254bc4546f79f767d62da8ccddf6485bf6f0
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.63"
msgid "1.63 (Feb 01, 2006): post-processing views can now be exported as meshes;\nimproved background mesh handling (a lot faster, and more accurate); improved\nsupport for input images; new Plugin(ExtractElements); small bug fixes and\nenhancements."
msgstr ""

#. unit_id: eb4ac76ab6d7cd6dba060151c0826f316fa11f3ad91839c188d6b3f3ce6cc6e0
#. source_hash: 2feb586fa1f091ea420ecf84758e88d1eb582c892ea05f96a8ddb26aab13b926
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.62"
msgid "1.62 (Jan 15, 2006): new option to draw color gradients in the background;\nenhanced perspective projection mode; new \"lasso\" selection mode (same as\n\"lasso\" zoom, but in selection mode); new \"invert selection\" button in the\nvisibility browser; new snapping grid when adding points in the GUI; nicer\nnormal smoothing; new extrude syntax (old syntax still available, but\ndeprecated); various small bug fixes and enhancements."
msgstr ""

#. unit_id: 63f3334cc585549b9ddbe2ae19370d4e164e23ccc91860b45ffe7ccc355ee912
#. source_hash: a9492ea32876483c642e69c9f0bb91870d28c8880dcd69f40c31966264819d0d
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.61"
msgid "1.61 (Nov 29, 2005): added support for second order (curved) elements in\npost-processor; new version (1.4) of post-processing file formats; new stippling\noptions for 2D plots; removed limit on allowed number of files on command line;\nall \"Combine\" operations are now available in the parser; changed\nView.ArrowLocation into View.GlyphLocation; optimized memory usage when loading\nmany (>1000) views; optimized loading and drawing of line meshes and 2D iso\nviews; optimized handling of meshes with large number of physical entities;\noptimized vertex array creation for large post-processing views on\nWindows/Cygwin; removed Discrete Line and Discrete Surface commands (the same\nfunctionality can now be obtained by simply loading a mesh in .msh format);\nfixed coloring by mesh partition; added option to light wireframe meshes and\nviews; new \"mesh statistics\" export format; new full-quad recombine option; new\nPlugin(ModulusPhase); hexas and prisms are now always saved with positive\nvolume; improved interactive entity selection; new experimental Tetgen\nintegration; new experimental STL remeshing algorithm; various small bug fixes\nand improvements."
msgstr ""

#. unit_id: 28bc715b47d88ed63811c1b7709446fb4bed299b9c2057e1a03a57b44bb9f51d
#. source_hash: abc6ea85546e85374388391707bd0b5a5f21bbcdcca6ef99b1997156b35ba984
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.60"
msgid "1.60 (Mar 15, 2005): added support for discrete curves; new Window menu on Mac\nOS X; generalized all octree-based plugins (CutGrid, StreamLines, Probe, etc.)\nto handle all element types (and not only scalar and vector\ntriangles+tetrahedra); generalized Plugin(Evaluate), Plugin(Extract) and\nPlugin(Annotate); enhanced clipping plane interface; new grid/axes/rulers for 3D\npost-processing views (renamed the AbscissaName, NbAbscissa and AbscissaFormat\noptions to more general names in the process); better automatic positioning of\n2D graphs; new manipulator dialog to specify rotations, translations and\nscalings \"by hand\"; various small enhancements and bug fixes."
msgstr ""

#. unit_id: 872db18084927480751ae59d161742803535f5e51405d855765bbeb8db56db6a
#. source_hash: 808eb31986230e4c1de4418f89500f58d0f6133867e603a689a98a2f0e628a59
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.59"
msgid "1.59 (Feb 06, 2005): added support for discrete (triangulated) surfaces, either\nin STL format or with the new \"Discrete Surface\" command; added STL and Text\noutput format for post-processing views and STL output format for surface\nmeshes; all levelset-based plugins can now also compute isovolumes; generalized\nPlugin(Evaluate) to handle external view data (based on the same or on a\ndifferent mesh); generalized Plugin(CutGrid); new plugins (Eigenvalues,\nGradient, Curl, Divergence); changed default colormap to match Matlab's \"Jet\"\ncolormap; new transformation matrix option for views (for non-destructive\nrotations, symmetries, etc.); improved solver interface to keep the GUI\nresponsive during solver calls; new C++ and Python solver examples; simplified\nTools->Visibility GUI; transfinite lines with \"Progression\" now allow negative\nline numbers to reverse the progression; added ability to retrieve Gmsh's\nversion number in the parser (to help write backward compatible scripts); fixed\nwhite space in unv mesh output; fixed various small bugs."
msgstr ""

#. unit_id: 021c239faaf390dfc1292c369a164678ff15c87be3e31202c16ab9da5fb392bb
#. source_hash: 748bd06660fe4e2fa2d959aeecde353eb7172143e18ab9d2fc7c491052d303ad
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.58"
msgid "1.58 (Jan 01, 2005): fixed UNIX socket interface on Windows (broken by the TCP\nsolver patch in 1.57); bumped version number of default post-processing file\nformats to 1.3 (the only small modification is the handling of the end-of-string\ncharacter for text2d and text3d objects in the ASCII format); new File->Rename\nmenu; new colormaps+improved colormap handling; new color+min/max options in\nviews; new GetValue() function to ask for values interactively in scripts;\ngeneralized For/EndFor loops in parser; new plugins (Annotate, Remove, Probe);\nnew text attributes in views; renamed some shortcuts; fixed TeX output for large\nscenes; new option dialogs for various output formats; fixed many small memory\nleaks in parser; many small enhancements to polish the graphics and the user\ninterface."
msgstr ""

#. unit_id: 2f5f734edc40c2415b014568276372844484bd0bd24f3242e038c7ecb7f29dea
#. source_hash: 96f0c51c892f704df7fb39e5318d434e4ef5f82572b706226bdb6ab9934cd99a
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.57"
msgid "1.57 (Dec 23, 2004): generalized displacement maps to display arbitrary view\ntypes; the arrows representing a vector field can now also be colored by the\nvalues from other scalar, vector or tensor fields; new adaptive high order\nvisualization mode; new options (Solver.SocketCommand, Solver.NameCommand,\nView.ArrowSizeProportional, View.Normals, View.Tangents and General.ClipFactor);\nfixed display of undesired solver plugin popups; enhanced interactive plugin\nbehavior; new plugins (HarmonicToTime, Integrate, Eigenvectors); tetrahedral\nmesh file reading speedup (50% faster on large meshes); large memory footprint\nreduction (up to 50%) for the visualization of triangular/tetrahedral meshes;\nthe solver interface now supports TCP/IP connections; new generalized raise mode\n(allows one to use complex expressions to offset post-processing maps); upgraded\nNetgen kernel to version 4.4; new optional TIME list in parsed views to specify\nthe values of the time steps; several bug fixes in the Elliptic mesh algorithm;\nvarious other small bug fixes and enhancements."
msgstr ""

#. unit_id: 457af8ddac11c4beb393a30e644952208b57417a27a833c8222adc0c97bc9142
#. source_hash: 512c1ea452aca5af817935d131da5d6e810378259e14377d045fca7a6b720000
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.56"
msgid "1.56 (Oct 17, 2004): new post-processing option to draw a scalar view raised by\na displacement view without using Plugin(DisplacementRaise) (makes drawing\narbitrary scalar fields on deformed meshes much easier); better post-processing\nmenu (arbitrary number of views+scrollable+show view number); improved\nview->combine; new horizontal post-processing scales; new option to draw the\nmesh nodes per element; views can now also be saved in \"parsed\" format; fixed\nvarious path problems on Windows; small bug fixes."
msgstr ""

#. unit_id: a231b9ded9fd41004ec97195e36c1b221ca7b11084f01004aa12529d9846910c
#. source_hash: 93e9e4098adaa69111962ee60cdfdf785f2587d8f82a71b54fef6787859bd24d
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.55"
msgid "1.55 (Aug 21, 2004): added background mesh support for Triangle; meshes can now\nbe displayed using \"smoothed\" normals (like post-processing views); added GUI\nfor clipping planes; new interactive clipping/cutting plane definition;\nreorganized the Options GUI; enhanced 3D iso computation; enhanced lighting;\nmany small bug fixes."
msgstr ""

#. unit_id: 86eddc5dae5bd076b842e4b7222d69b4582b4bac7e80204ab4a032cea821ea2f
#. source_hash: 15efb19e22d3f3f1c5b175834b4549834abb7aad4c1b4376ae8514ff3fbf6c15
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.54"
msgid "1.54 (Jul 03, 2004): integrated Netgen (3D mesh quality optimization +\nalternative 3D algorithm); Extrude Surface now always automatically creates a\nnew volume (in the same way Extrude Point or Extrude Line create new lines and\nsurfaces, respectively); fixed UNV output; made the \"Layers\" region numbering\nconsistent between lines, surfaces and volumes; fixed home directory problem on\nWin98; new Plugin(CutParametric); the default project file is now created in the\nhome directory if no current directory is defined (e.g., when double-clicking on\nthe icon on Windows/Mac); fixed the discrepancy between the orientation of\ngeometrical surfaces and the associated surface meshes; added automatic\norientation of surfaces in surface loops; generalized Plugin(Triangulate) to\nhandle vector and tensor views; much nicer display of discrete iso-surfaces and\ncustom ranges using smooth normals; small bug fixes and cleanups."
msgstr ""

#. unit_id: 92600aaad94269c4e7ec774584c8e562f534f7d84fb22fb200b3a3ecc6103043
#. source_hash: 7ad056f1a0743512ba7c550624686bac1cc70c812dcd7e31813f383c90a536c2
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.53"
msgid "1.53 (Jun 04, 2004): completed support for second order elements in the mesh\nmodule (line, triangles, quadrangles, tetrahedra, hexahedra, prisms and\npyramids); various background mesh fixes and enhancements; major performance\nimprovements in mesh and post-processing drawing routines (OpenGL vertex arrays\nfor tri/quads); new Plugin(Evaluate) to evaluate arbitrary expressions on\npost-processing views; generalized Plugin(Extract) to handle any combination of\ncomponents; generalized \"Coherence\" to handle transfinite surface/volume\nattributes; plugin options can now be set in the option file (like all other\noptions); added \"undo\" capability during geometry creation; rewrote the contour\nguessing routines so that entities can be selected in an arbitrary order; Mac\nusers can now double click on geo/msh/pos files in the Finder to launch Gmsh;\nremoved support for FLTK 1.0; rewrote most of the code related to quadrangles;\nfixed 2d elliptic algorithm; removed all OpenGL display list code and options;\nfixed light positioning; new BoundingBox command to set the bounding box\nexplicitly; added support for inexpensive \"fake\" transparency mode; many code\ncleanups."
msgstr ""

#. unit_id: 706338d7c5e92a5777cbf87e8a0d64390e9a375d599574eeea1e90504f3870f1
#. source_hash: 67ce0c18403e6db481f891954165554877fd07ea2cc461aa24c04b847cfe8d34
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.52"
msgid "1.52 (May 06, 2004): new raster (\"bitmap\") PostScript/EPS/PDF output formats;\nnew Plugin(Extract) to extract a given component from a post-processing view;\nnew Plugin(CutGrid) and Plugin(StreamLines); improved mesh projection on\nnon-planar surfaces; added support for second order tetrahedral elements; added\ninteractive control of element order; refined mesh entity drawing selection (and\nrenamed most of the corresponding options); enhanced log scale in\npost-processing; better font selection; simplified View.Raise{X,Y,Z} by removing\nthe scaling; various bug fixes (default postscript printing mode, drawing of 3D\narrows/cylinders on Linux, default home directory on Windows, default initial\nfile browser directory, extrusion of points with non-normalized axes of\nrotation, computation of the scene bounding box in scripts, + the usual\ndocumentation updates)."
msgstr ""

#. unit_id: b4fb02f7f48070a849b14311fe11172767a0b3505d410d168127a5d8ba9b0c98
#. source_hash: 7596d672f16a77bd4415b30142c6b4f0fe7e57afcef6b925ad717246d0404169
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.51"
msgid "1.51 (Feb 29, 2004): initial support for visualizing mesh partitions; integrated\nversion 2.0 of the MSH mesh file format; new option to compute post-processing\nranges (min/max) per time step; Multiple views can now be combined into multi\ntime step ones (e.g. for programs that generate data one time step at a time);\nnew syntax: #var[] returns the size of the list var[]; enhanced \"gmsh -convert\";\ntemporary and error files are now created in the home directory to avoid file\npermission issues; new 3D arrows; better lighting support; STL facets can now be\nconverted into individual geometrical surfaces; many other small improvements\nand bug fixes (multi timestep tensors, color by physical entity, parser cleanup,\netc.)."
msgstr ""

#. unit_id: 2fb7cdcb46e042a6058fa52025ab4992c5c2679d3c4944aa73d4df34744b8103
#. source_hash: 39fd834f332ec8d8adfb3fa121a4c4041d75a6deb4be7ae13f27b7521ea879bf
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.50"
msgid "1.50 (Dec 06, 2003): small changes to the visibility browser + made visibility\nscriptable (new Show/Hide commands); fixed (rare) crash when deleting views;\nsplit File->Open into File->Open and File->New to behave like most other\nprograms; Mac versions now use the system menu bar by default (if possible);\nfixed bug leading to degenerate and/or duplicate tetrahedra in extruded meshes;\nfixed crash when reloading sms meshes."
msgstr ""

#. unit_id: 87c0b606880f64dd765ccd639c2f5eafe4414e6b90c466bf7685d028bf3b2449
#. source_hash: 5f99271cd5f91d38d579067ed79e48a5495774de361dfb9f1abef8a61ec9e532
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.49"
msgid "1.49 (Nov 30, 2003): made Merge, Save and Print behave like Include (i.e., open\nfiles in the same directory as the main project file if the path is relative);\nnew Plugin(DecomposeInSimplex); new option View.AlphaChannel to set the\ntransparency factor globally for a post-processing view; new \"Combine Views\"\ncommand; various bug fixes and cleanups."
msgstr ""

#. unit_id: 206818c66a10e7da38df1d291dc9b49d0c2c023cae0c556708efef11a868167d
#. source_hash: 40df3a6e0fe36b9f248b9766e9e3026abcbaad28db5e71a7d6b892c321dc247d
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.48"
msgid "1.48 (Nov 23, 2003): new DisplacementRaise plugin to plot arbitrary fields on\ndeformed meshes; generalized CutMap, CutPlane, CutSphere and Skin plugins to\nhandle all kinds of elements and fields; new \"Save View[n]\" command to save\nviews from a script; many small bug fixes (configure tests for libpng, handling\nof erroneous options, multi time step scalar prism drawings, copy of surface\nmesh attributes, etc.)."
msgstr ""

#. unit_id: f565372dc7221e21342ef99428018d0002056298950a78a114aad4c154dc0677
#. source_hash: 551bb70c7cfe2c28be574643824593a0cf5bece0cd8f4c81a75c343977fd3ca4
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.47"
msgid "1.47 (Nov 12, 2003): fixed extrusion of surfaces defined by only two curves; new\nsyntax to retrieve point coordinates and indices of entities created through\ngeometrical transformations; new PDF and compressed PostScript output formats;\nfixed numbering of elements created with \"Extrude Point/Line\"; use $GMSH_HOME as\nhome directory if defined."
msgstr ""

#. unit_id: 97147be591f08ac906475c50226043114098ee03a2ce7dfa7f6bb81bd8178c9f
#. source_hash: 6a4f1f46fed63fddf36daa869da946e35662ba70abfad077d154d033bad9e1ef
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.46"
msgid "1.46 (Aug 23, 2003): fixed crash for very long command lines; new options for\nsetting the displacement factor and Triangle's parameters + renamed a couple of\noptions to more sensible names (View.VectorType, View.ArrowSize); various small\nbug fixes; documentation update."
msgstr ""

#. unit_id: 90295ba8963d622ab4f92a9d917853080deb4fbade7f4665b2bb40e53626296b
#. source_hash: bff5fee1724bbd5c84a97f5b9316e16f4217a2340aebfdcf236c301d0ac2c6e2
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.45"
msgid "1.45 (Jun 14, 2003): small bug fixes (min/max computation for tensor views,\nmissing physical points in read mesh, \"jumping\" geometry during interactive\nmanipulation of large models, etc.); variable definition speedup; restored\nsupport for second order elements in one- and two-dimensional meshes;\ndocumentation updates."
msgstr ""

#. unit_id: e1e74e0be9bfa207a57ba17c11a81c8eadb958878e1eb303971201f16b87e7c9
#. source_hash: b6a8ea8467b6bd6728e7d67e9fc21d5bcd660180b9bbbbf0918f5087bf6bb4a0
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.44"
msgid "1.44 (Apr 21, 2003): new reference manual; added support for PNG output; fixed\nsmall configure script bugs."
msgstr ""

#. unit_id: 93c71f615186a960853b9932ea3495d7ef34585e42df49bdd7394e0897c3cc6c
#. source_hash: b76e4289154aaa629ea16517b51d6623eba61dabfae5bcf4128e6710c84cf0dd
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.43"
msgid "1.43 (Mar 28, 2003): fixed solver interface problem on Mac OS X; new option to\nspecify the interactive rotation center (default is now the pseudo \"center of\ngravity\" of the object, instead of (0,0,0))."
msgstr ""

#. unit_id: 0f82d2750ab88f033927f39988d7d536511ef7e1c59a30d56db8c8ba5c8b825c
#. source_hash: 84d240c5118021889636463f7bed3670274160b29c2f1b73c8b2850a26a7e6a9
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.42"
msgid "1.42 (Mar 19, 2003): suppressed the automatic addition of a \".geo\" extension if\nthe file given on the command line is not recognized; added missing Layer option\nfor Extrude Point; fixed various small bugs."
msgstr ""

#. unit_id: e87df5a5e8b85d406f1d932fd7c75fe114c58e2d07508c3d05cf1872a43d41ea
#. source_hash: 09b2077069807703ed0304672704f974e0cd084d348ddc7aaf38c35ec6810c29
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.41"
msgid "1.41 (Mar 04, 2003): Gmsh is now licensed under the GNU General Public License;\ngeneral code cleanup (indent)."
msgstr ""

#. unit_id: cd208b398c9d6588ddf8c0249b9c4ff355a66337e628ca6a25da768d0695f1cc
#. source_hash: 59ca738a1fd5a1ce8c8b194af7699b5f0c533439294861e3c544b5bb4f2fb900
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.40"
msgid "1.40 (Feb 26, 2003): various small bug fixes (mainly GSL-related)."
msgstr ""

#. unit_id: b4c0833cee07aa70bf366560995ef30a73cdff3281ec9a62af54c38c197433ab
#. source_hash: a525cd2d44afc749b22ba3c636583f612f438afad5be9077adefc1ce7509d505
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.39"
msgid "1.39 (Feb 23, 2003): removed all non-free routines; more build system work;\nimplemented Von-Mises tensor display for all element types; fixed small GUI\nbugs."
msgstr ""

#. unit_id: 8be5d77315a07852a5106820d556e9233f7e6de93a5b7c2fabb7c0afab73d45d
#. source_hash: 37fb2bc17dfc8399c5f36bef698297a7f4d095a214fc2ecc145a6c4da3051be9
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.38"
msgid "1.38 (Feb 17, 2003): fixed custom range selection for 3D iso graphs; new build\nsystem based on autoconf; new image reading code to import bitmaps as\npost-processing views."
msgstr ""

#. unit_id: cd3c4ce4c7e7b824c0f8c57455024f273709cd282a41fcbd09ab9e950e4ed18d
#. source_hash: d2f4e4f29b3b1f4fcc6b1b75f8fca81fd7bc0cf2642d28a98154ee7b34a4a54c
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.37"
msgid "1.37 (Jan 25, 2003): generalized smoothing and cuts of post-processing views;\nbetter Windows integration (solvers, external editors, etc.); small bug fixes."
msgstr ""

#. unit_id: dd2a185094e73680b92b23fddbd6b77625a104e695d95ce96b4533ceee4c7662
#. source_hash: 76576de4388c272f62514d38b72a396f414b836e094c9b266ffbb0323669d269
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.36"
msgid "1.36 (Nov 20, 2002): enhanced view duplication (one can now use \"Duplicata\nView[num]\" in the input file); merged all option dialogs in a new general option\nwindow; enhanced discoverability of the view option menus; new 3D point and line\ndisplay; many small bug fixes and enhancements (\"Print\" format in parser,\npost-processing statistics, smooth normals, save window positions, restore\ndefault options, etc.)."
msgstr ""

#. unit_id: 4847c98fd36181fee9cbac76d982b575c99b3c4774df7a3ba5735baad06aae82
#. source_hash: bd0d0597ef077947f750d730a35b7f8f32d1f4ead3310da77f230ed5c21523f6
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.35"
msgid "1.35 (Sep 11, 2002): graphical user interface upgraded to FLTK 1.1 (tooltips,\nnew file chooser with multiple selection, full keyboard navigation, cut/paste of\nmessages, etc.); colors can be now be directly assigned to mesh entities;\ninitial tensor visualization; new keyboard animation (right/left arrow for time\nsteps; up/down arrow for view cycling); new VRML output format for surface\nmeshes; new plugin for spherical elevation plots; new post-processing file\nformat (version 1.2) supporting quadrangles, hexahedra, prisms and pyramids;\ntransparency is now enabled by default for post-processing plots; many small bug\nfixes (read mesh, ...)."
msgstr ""

#. unit_id: dc6051c735f2a29e35a75741e48eeffe12cd598adb16541baad850b2c8d8e43a
#. source_hash: a7dc861a8bf06208b0f30699dfcf805ea55431ae17ab35ae6bf9702133a25742
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.34"
msgid "1.34 (Feb 18, 2002): improved surface mesh of non-plane surfaces; fixed\norientation of elements in 2D anisotropic algorithm; minor user interface polish\nand additions (mostly in post-processing options); various small bug fixes."
msgstr ""

#. unit_id: f4809afe4f265184427aadffb1f95cb779e67c0655752ee47968665b571b3eca
#. source_hash: a9a36f23389ba51c6c21350a48db03c48afe9014d32b20b55ece98312b953671
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.33"
msgid "1.33 (Jan 24, 2002): new parameterizable solver interface (allowing up to 5\nuser-defined solvers); enhanced 2D aniso algorithm; 3D initial mesh speedup."
msgstr ""

#. unit_id: d7d48731b5fa02803c360e2ee09d2922371b001f06dd4f1e94e08509fa4c324f
#. source_hash: 40094d6d9e759305efb0228735cd5b6538a461fe648c759122f1f980b0434b9f
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.32"
msgid "1.32 (Oct 04, 2001): new visibility browser; better floating point exception\nchecks; fixed infinite looping when merging meshes in project files; various\nsmall clean ups (degenerate 2D extrusion, view->reload, ...)."
msgstr ""

#. unit_id: 82696768b43a638f8f09272145d4eb653d0457d90944353bc8e1ef3e7ddc73a5
#. source_hash: a79b5999f7994ef39b8f0f712645220d9c63bd1974fe4db693aa034334672e57
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.31"
msgid "1.31 (Nov 30, 2001): corrected ellipses; PostScript output update (better\nshading, new combined PS/LaTeX output format); more interface polish; fixed\nextra memory allocation in 2D meshes; Physical Volume handling in unv format;\nvarious small fixes."
msgstr ""

#. unit_id: 1bd9536d067baacb0ebd00e6409bb981f849457ba75a464a5fe3a58feac8bd79
#. source_hash: 9359f7339c148af97795cdc696a5bee4e545266b770b2f9ea6d3215004177ea0
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.30"
msgid "1.30 (Nov 16, 2001): interface polish; fix crash when extruding quadrangles."
msgstr ""

#. unit_id: f66b68d272cb0ed94345e662734111d8d775878b4e219db64f0e9f6ee7ea0cd3
#. source_hash: d2b0dc22b9937d3fd972cf0df5449ecd5c42fc776de5bf718428b3978f645feb
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.29"
msgid "1.29 (Nov 12, 2001): translations and rotations can now be combined in\nextrusions; fixed coherence bug in Extrude Line; various small bug fixes and\nadditions."
msgstr ""

#. unit_id: 9351c05de8c3177ecfcf54f3d381efd3e4aee7800f02525bfcb8eeb3787520e0
#. source_hash: eaffff94eb66972672e1b674f0c84e4b2a7a0df42de755465ed59508ca551dcc
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.28"
msgid "1.28 (Oct 30, 2001): corrected the 'Using Progression' attribute for tranfinite\nmeshes to actually match a real geometric progression; new Triangulate plugin;\nnew 2D graphs (space+time charts); better performance of geometrical\ntransformations (warning: the numbering of some automatically created entities\nhas changed); new text primitives in post-processing views (file format updated\nto version 1.1); more robust mean plane computation and error checks; various\nother small additions and clean-ups."
msgstr ""

#. unit_id: 98e4fe0533a4b72640cf901d76e10afedb27017705659cd064ce6208374a3064
#. source_hash: 6f830fbf3acc43f142129e8edcc024b5304738260b9909d0a1cf6f83513c445f
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.27"
msgid "1.27 (Oct 05, 2001): added ability to extrude curves with Layers/Recombine\nattributes; new PointSize/LineWidth options; fixed For/EndFor loops in included\nfiles; fixed error messages (line numbers+file names) in loops and functions;\nmade the automatic removal of duplicate geometrical entities optional\n(Geometry.AutoCoherence=0); various other small bug fixes and clean-ups."
msgstr ""

#. unit_id: 1ddaffa7de5398ef234dd18b509342e711e3efcacfa89261ec945365bd066d7d
#. source_hash: 3e447dbaf69731543df01b73b7cca5f11be0dfd6ae4c6cae0e22c6bb62826a09
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.26"
msgid "1.26 (Sep 06, 2001): enhanced 2D anisotropic mesh generator (metric\nintersections); fixed small bug in 3D initial mesh; added alternative syntax for\nbuilt-in functions (for GetDP compatibility); added line element display; Gmsh\nnow saves all the elements in the mesh if no physical groups are defined (or if\nMesh.SaveAll=1)."
msgstr ""

#. unit_id: 9e610606fd3c1d946846636a3e321e41d5037678e3d8db0822da24e6d57160fa
#. source_hash: 0ca96a40ba8871ee27cb4a5d8164326cb166d9cf436fc621697d4d79e975d7f6
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.25"
msgid "1.25 (Sep 01, 2001): fixed bug with mixed recombined/non-recombined extruded\nmeshes; Linux versions are now build with no optimization, due to bugs in gcc\n2.95.X."
msgstr ""

#. unit_id: 8fd93e010e84412c7c2a99ee4840c70df3d30adb630b79557e3e7bd4464778d1
#. source_hash: c9e60a0c3784d626044a2157e65d79e8f2d21d94b5881077e703099682515f48
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.24"
msgid "1.24 (Aug 30, 2001): fixed characteristic length interpolation for Splines;\nfixed edge swapping bug in 3D initial mesh; fixed degenerated case in\ngeometrical extrusion (ruled surface with 3 borders); fixed generation of\ndegenerated hexahedra and prisms for recombined+extruded meshes; added BSplines\ncreation in the GUI; integrated Jonathan Shewchuk's Triangle as an alternative\nisotropic 2D mesh generator; added AngleSmoothNormals to control sharp edge\ndisplay with smoothed normals; fixed random crash for lighted 3D iso surfaces."
msgstr ""

#. unit_id: 8eccf957db874cfa48e5e31f5c3e0b0beeffc1d34d91ffccc2c52ffcd73e62e4
#. source_hash: 18c9782fd4509995d7b318767fe5a301bc6b105ddb964e659b79c29d8e38184f
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.23"
msgid "1.23 (Aug, 2001): fixed duplicate elements generation + non-matching tetrahedra\nfaces in 3D extruded meshes; better display of displacement maps; fixed\ninteractive ellipsis construction; generalized boundary operator; added new\nexplode option for post-processing views; enhanced link view behavior (to update\nonly the changed items); added new default plugins: Skin, Transform, Smooth;\nfixed various other small bugs (mostly in the post-processing module and for\nextruded meshes)."
msgstr ""

#. unit_id: 7fa71e1c9f347d4b6efa5595cb25e26cc5f5b320ec8aed76b851250e7dff117b
#. source_hash: ee39451a50906ecf3291e076d650bfb95b8def181423ad4e16dddffa43a0250e
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.22"
msgid "1.22 (Aug 03, 2001): fixed (yet another) bug for 2D mesh in the mean plane;\nfixed surface coherence bug in extruded meshes; new double logarithmic scale,\nsaturate value and smoothed normals option for post-processing views; plugins\nare now enabled by default; three new experimental statically linked plugins:\nCutMap (extracts a given iso surface from a 3D scalar map), CutPlane (cuts a 3D\nscalar map with a plane section), CutSphere (cuts a 3D scalar map with a\nsphere); various other bug fixes, additions and clean-ups."
msgstr ""

#. unit_id: daef6a1bebae7f22433dc4f317a232bf03a16ca17df51d086dde307f257c1b1e
#. source_hash: bdea41620d1e2c70a0e30d0ad0a3b7d61444b499080bcde9038d772c8f767901
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.21"
msgid "1.21 (Jul 25, 2001): fixed more memory leaks; added -opt command line option to\nparse definitions directly from the command line; fixed missing screen refreshes\nduring contour/surface/volume selection; enhanced string manipulation functions\n(Sprintf, StrCat, StrPrefix); many other small fixes and clean-ups."
msgstr ""

#. unit_id: 2b716817d5e4f6e6a90af19376e51114430f3244b6ac1f3d4613708780e876ab
#. source_hash: 1b9cd0f2afa5ca2c5513cab547720d62b3ab913a71caf2eb682b46f8099cb77e
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.20"
msgid "1.20 (Jun 14, 2001): fixed various bugs (memory leaks, functions in included\nfiles, solver command selection, ColorTable option, duplicate nodes in extruded\nmeshes (not finished yet), infinite loop on empty views, orientation of\nrecombined quadrangles, ...); reorganized the interface menus; added constrained\nbackground mesh and mesh visibility options; added mesh quality histograms;\nchanged default mesh colors; reintegrated the old command-line extrusion mesh\ngenerator."
msgstr ""

#. unit_id: 8caa191e3cf8aecd24232cf648eba9be3d9d6b93953e433a7f728e67b5c6fc8d
#. source_hash: a21847a4721a6eb77882f67c10d4317c72747adaaece821b9e981564881e75a2
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.19"
msgid "1.19 (May 07, 2001): fixed seg. fault for scalar simplex post-processing; new\nSolver menu; interface for GetDP solver through sockets; fixed multiple scale\nalignment; added some options + full option descriptions."
msgstr ""

#. unit_id: 3df7112e74a98c76bb65321e325510b71ebe66c7c8bf0a82df234c9cb672e462
#. source_hash: cda8b61febe0bf6d47a3e4366ac1ab2800fe04ac8f1d3232004729904848ebbc
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|1.18"
msgid "1.18 (Apr 26, 2001): fixed many small bugs and incoherences in post-processing;\nfixed broken background mesh in 1D mesh generation."
msgstr ""

#. unit_id: de8316b8616ada10b7f2e17acad142897fa6bf9090d53743cb2304c22b2b4c4e
