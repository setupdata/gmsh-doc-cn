msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|item|Periodic Curve @{ @var{expression-list} @} = @{ @var{expression-list} @} ;"
msgid "Periodic Curve @{ @var{expression-list} @} = @{ @var{expression-list} @} ;"
msgstr ""

#. unit_id: 3642b76c65e8b271d706cbec8df15d5bcbf1653328c0c3a2cae6cc6a04f45cb3
#. source_hash: fe4fa613ffc0b67860f40392371e59445ab3eddcacfe6b50eb959208ec1f15a1
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|paragraph|Periodic Curve @{ @var{expression-list} @} = @{ @var{expression-list} @} ;"
msgid "Add a meshing constraint to force the mesh of the curves on the\nleft-hand side to match the mesh of the curves on the right-hand side\n(masters). If used after meshing, generate the periodic node\ncorrespondence information assuming the mesh of the curves on the\nleft-hand side effectively matches the mesh of the curves on the\nright-hand side. @value{SYNC}"
msgstr ""

#. unit_id: ac0d3ebfc43067dbc39b7d98caf5294eef98d71e4633d317f88964742656f955
#. source_hash: 1c58f2fd8f8ff5b9408a5521f076f7c6b89e93a5607830bce1291ad3fab9232f
