msgid "Colors expressions are hybrids between fixed-length braced\n@w{@var{expression-list}s} and @w{@var{string}s}:"
msgstr ""

#. unit_id: fa88ae0afd8c80939acf978b9247c7ed5b389a003e8a27490ea0581bd63f55c9
