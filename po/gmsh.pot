msgstr ""

#. unit_id: a8bc17bb5d18ab9768e59c81aa611b6f9012a73303069f861af9d31aa20418e4
#. source_hash: 11a67b60b0c4bfacc5f518d38c519921e98382070be8bb869c6b73209c981ae0
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Post-processing module questions|paragraph|How can I see ``inside'' a complicated post-processing view?"
msgid "Use `Tools->Clipping'."
msgstr ""

#. unit_id: 366a980ef70e13ecf20cda2e86f32c259381438f4eeb6ad94a26692f1bd60b7e
#. source_hash: 363adc82b8e5d48a9fac14a60f51faa14a6ab952e2a328fba1dfe1ed8a06aabc
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Post-processing module questions|paragraph|How can I see ``inside'' a complicated post-processing view?#2"
msgid "When viewing 3D scalar fields, you can also modify the colormap\n(`Tools->Options->View->Map') to make the iso-surfaces ``transparent'':\neither by holding @kbd{Ctrl} while dragging the mouse to draw the alpha\nchannel by hand, or by using the @kbd{a}, @kbd{Ctrl+a}, @kbd{p} and\n@kbd{Ctrl+p} keyboard shortcuts."
msgstr ""

#. unit_id: dc4423d37373c5591a9b92b5dbafa7c678846ee128766607d468f91032168aa7
#. source_hash: 0efe340204f3bc6cab48ff1c022e6c9c26adbb7f34445f99ea5ac85d5ffc93c2
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Post-processing module questions|paragraph|How can I see ``inside'' a complicated post-processing view?#3"
msgid "Yet another (destructive) option is to use the ExtractVolume option in\nthe CutSphere or CutPlane plugins."
msgstr ""

