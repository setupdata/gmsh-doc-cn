#. unit_id: 5034e9b753435b7746f9dd998ea7002e528fe275acc7d8baec03f71b4103a4ea
#. source_hash: 7de044562995d62883220d33b0f25c80c7135c1d5c119311c4a0c7fd41b66a57
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|POS ASCII file format (Legacy)|paragraph|@var{text2d}"
msgid "is a list of 4 double precision numbers:"
msgstr ""

#. unit_id: 0472827e0283f0617ed5f4fd85dc70f10eeb681997bffacafa8fa60c90fb6972
#. source_hash: 07129cd7e55a43d28b67bbe25461fa9fbf5b98838b9df6a3b184f172afa0442f
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|POS ASCII file format (Legacy)|paragraph|@var{text2d}#2"
msgid "where @var{coord1} and @var{coord2} give the X-Y position of the 2D string\nin screen coordinates (measured from the top-left corner of the window) and\nwhere @var{index} gives the starting index of the string in\n@var{text2d-chars}. If @var{coord1} (respectively @var{coord2}) is negative,\nthe position is measured from the right (respectively bottom) edge of the\nwindow. If @var{coord1} (respectively @var{coord2}) is larger than 99999,\nthe string is centered horizontally (respectively vertically).  If\n@var{style} is equal to zero, the text is aligned bottom-left and displayed\nusing the default font and size. Otherwise, @var{style} is converted into an\ninteger whose eight lower bits give the font size, whose eight next bits\nselect the font (the index corresponds to the position in the font menu in\nthe GUI), and whose eight next bits define the text alignment\n(0=bottom-left, 1=bottom-center, 2=bottom-right, 3=top-left, 4=top-center,\n5=top-right, 6=center-left, 7=center-center, 8=center-right)."
msgstr ""

#. unit_id: fb5db2b4841b9d1662c53bc8cba0582a028d57331716581d57bcab3d531febf5
