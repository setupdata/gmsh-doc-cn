#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh tutorial|index|Examples"
msgid "Examples"
msgstr ""

#. unit_id: e593a8bac702a272bd238438cc0432062452b40c064bdccf0fa411b4ad895c92
#. source_hash: 1000c92b912ddde58e7667b7055d9ad5d4ba29d63123a03a40d254e895c67fc1
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh tutorial|index|Tutorial"
msgid "Tutorial"
msgstr ""

#. unit_id: 441752e9f7ef9b3ba7df041454423ab246463e27f46b81187a1c71477206b494
#. source_hash: fd7414df9e0e99f6ccd2ace89e45bdf3aad798112fb70518b81f7973dc533b6c
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh tutorial|paragraph|da9048cbf5570162903e3fb5a0af6414a1846fcc916bd0cdb3e1ece70b088f3b"
msgid "The following tutorials introduce new features gradually, starting with\nthe first tutorial @code{t1} (@pxref{t1}). The corresponding files are\navailable in the @url{@value{GITLAB-PREFIX}/tutorials,tutorials}\ndirectory of the Gmsh distribution."
msgstr ""

#. unit_id: 4af4b1fa447e0f7c1f235d96ab6d8c22e8147e6da0dbfb585978d7fa86077d46
#. source_hash: 826df492ad1bb992e92c4fea6db311abf1e5ae27804bb8a61967a69efa92b533
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh tutorial|paragraph|1ccf5b725e7c3018acd701d6e7411452f33dcd43a5cf50f16cd1d0142d781850"
msgid "The @file{.geo} files (e.g. @file{t1.geo}) are written in Gmsh's\nbuilt-in scripting language (@pxref{Gmsh scripting language}). You can\nopen them directly with the Gmsh app: in the GUI (@pxref{Gmsh graphical\nuser interface}), use the `File->Open' menu and select\ne.g. @file{t1.geo}. Or on the command line, run"
msgstr ""

#. unit_id: 7ee8bed830a53b99f687e9a1d52be21651c30dcd53e20e249f067dfee33297df
#. source_hash: 17d8df2de645b2a17fe3d2d27b53397a652e5c0b87a6156578e00fb96821fdd8
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh tutorial|paragraph|e088c1fd26d28b0a5414ade122deee187863b5e4fdce6dcacb1c02c98ecb1a48"
msgid "which will launch the GUI, or run"
msgstr ""

#. unit_id: b1c60adc52e918ca19529dda77af923dbb6761ceea3eefa8ef380173fa574d16
#. source_hash: f473db5ca441f312f39b341ed064fbe08baf4959a5c2a1763a4980f97c146e1b
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh tutorial|paragraph|1625ac56c4cb4c627b87f98e702d96b8ed6f27337321ec058c9ba1ec12ef82ec"
msgid "to perform 2D meshing in batch mode (@pxref{Gmsh command-line\ninterface})."
msgstr ""

#. unit_id: f231c572db97a5b4d50209d337e4855eb6c4775228250dd52ffbef3ada3d61e0
#. source_hash: f68fc4ca5517bd4527ccd89d501b93ceb0814d99e7c39da5ee495acd9c5b96fc
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh tutorial|paragraph|fc9b5a429c13cf9d45c1dbda3537d3371f3e24e4effd7b6b6ff00eb5a499d30f"
msgid "The @file{c++}, @file{c}, @file{python}, @file{julia} and @file{fortran}\nsubdirectories of the @url{@value{GITLAB-PREFIX}/tutorials,tutorials}\ndirectory contain the C++, C, Python, Julia and Fortran versions of the\ntutorials, written using the Gmsh API (@pxref{Gmsh application\nprogramming interface}). You will need the Gmsh dynamic library and the\nassociated header files (for C++ and C) or modules (for Python, Julia\nand Fortran) to run them (@pxref{Installing and running Gmsh on your\ncomputer}). Each subdirectory contains additional information on how to\nrun the tutorials for each supported language."
msgstr ""

#. unit_id: 1d7ea6a124ccd52e6870ff2f3f7f13713a4326531832ae1e8d6ec04ee9b10d80
#. source_hash: 6ddc4f6a84898fab05cf6fb0643cb34363b7bd704735186a03e211d673d12537
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh tutorial|paragraph|452dc216bc4204ccb388395d747853e4e74ea2a33ae84bcd200c44ee0820cbe9"
msgid "All the tutorials starting with the letter @file{t} are available both\nusing the scripting language and the API. Extended tutorials, starting\nwith the letter @file{x}, introduce features that are only available\nthrough the API."
msgstr ""

#. unit_id: 6f18b5a926bbdf850264cb1ecc09eabe4a2f387634c7a9e9d7a511320036b9f5
#. source_hash: 6a452e7e2e42ae6fc6e12e09e4a29768adbd43acd73978809a36e509d136116f
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh tutorial|paragraph|d95031a73d728d7a2f524debdb1c1dd1963b98636a7bc70f4c7a8506773ade28"
msgid "Note that besides these tutorials, the Gmsh distribution contains many\nother examples written using both the built-in scripting language and\nthe API: see @url{@value{GITLAB-PREFIX}/examples,examples} and\n@url{@value{GITLAB-PREFIX}/benchmarks,benchmarks}."
msgstr ""

