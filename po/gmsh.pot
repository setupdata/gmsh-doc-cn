msgctxt "CHANGELOG.txt|Version history|paragraph|5b45009abab8aa31ceeeb661aa5f121a9acf26666af9777b92fecb88d8c4cc50"
msgid "* New API functions: model/getEntityProperties, model/getPhysicalGroupsEntities"
msgstr ""

#. unit_id: 8c210d29433d6b4530b95c5a8ac3c3233e0cbbff07aff1e542283cdaf65452f6
#. source_hash: 2123d1e880c69b37b853f45525283e9bc65fe4f578fd4d949e74b4b80a323bbc
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|db86601173745f10f0be096b8adce4f0af5bb24b34ce5b77d6168be84292e6b1"
msgid "* Incompatible API changes: new optional arguments to occ/fillet2D; renamed\n  model/getType as model/getEntityType; renamed mesh/triangulate as\n  algorithm/triangulate and add new optional argument (edges); renamed\n  mesh/tetrahedralize as algorithm/tetrahedralize"
msgstr ""

#. unit_id: 286f4afa64012078d71ffe887ed4f09301aa03e24cc9ed7535c6d9c15f341995
#. source_hash: 3f06d7d4a210e637f3641a917eb21b2e82125600ff20743abbf58c81c95e1511
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|4.13.1"
msgid "4.13.1 (May 24, 2024): fix regression introduced in 4.13.0 when reading binary\n.msh files with post-processing data; new read-only Mesh.MinQuality updated\nafter meshing pipeline; occ/addSurfaceFilling new defaults to degree=2 for\nconsistency with .geo files; small bug fixes."
msgstr ""

#. unit_id: 1b68278d41d98a2b6dec1f0b9bf7323638a37e74f7f81953fd7a0e8151f9743a
#. source_hash: 7b52f4aef1c473fc193ede131d59e14d3a0d377695e0af6785a532253b8229bb
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|4.13.0"
msgid "4.13.0 (May 7, 2024): added support for importing and exporting XAO files; new\noptions for OCC boolean operations (OCCBooleanCheckInverted, OCCBooleanGlue,\nOCCBooleanNonDestructive, OCCBooleanSimplify); new OCC operations (2D fillets\nand chamfers, distance, defeature); new quasi-transfinite 2d meshes (with fans);\nsmall API additions; revert Crack plugin logic to version 4.10.1; bug fixes."
msgstr ""

