#. unit_id: 6801bdafa4b312d04af4dbd56442e6058bd189041d5aed0ad88909c974220488
#. source_hash: 35dcf706540c931a20da635a2cd2dbca9853f479051c4855ef01fb49fa9dbc00
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Floating point expressions|index|Constants"
msgid "Constants"
msgstr ""

#. unit_id: 42219beacd15ff6e8d67f237c0786ae40936c4089a9df2af7b03e0b39e361f1d
#. source_hash: d164cf550ff025eee442516dde17ab93cb474e1e561eeccd4aa88d863763e43d
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Floating point expressions|paragraph|91afd8ae05bf9c6b43fb8aa63e620846ad3bb5e6b7a8e4ecf482712a4d1f7e70"
msgid "The two constant types used in Gmsh scripts are @var{real} and\n@var{string} (there is no integer type).  These types have the same\nmeaning and syntax as in the C or C++ programming languages."
msgstr ""

#. unit_id: d1b253829e60b765b6292e107fb99ebfc0d0f526c0bb80c8847196a1afa65c1d
#. source_hash: 4a554cad09aa56d6db6476833d0d05f2a272f84ee3ff42bbd5b176602e1a363c
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Floating point expressions|index|Expressions, floating point"
msgid "Expressions, floating point"
msgstr ""

#. unit_id: 329c6e7c6d38098f010dc49facb335e8225dfa11c3868e798f5c0766eaeb3e10
#. source_hash: 8c8ae89fbc79aa888c0e9e019f48df1c31bbfd7fb7da031eebb37afa736378d5
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Floating point expressions|index|Real numbers"
msgid "Real numbers"
msgstr ""

#. unit_id: 74d344c55e0dfe5af5144ff604d168823fd134be9ccdb73112271a91023280d3
#. source_hash: 130205ea481bee1bccd25c74790aab79fe7d3617e087c1a7195e56f9ac39fd1b
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Floating point expressions|index|Numbers, real"
msgid "Numbers, real"
msgstr ""

#. unit_id: bfc8db17fe4b769623bdb24828a18d3960fe202e35fdbe47b04fee7059f5c831
#. source_hash: 539ac5bc37541d31c459d671962275c79ea784b93a923fdc89cc7073159be0ff
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Floating point expressions|paragraph|d5eb873f2f9162efdb85369adfdb16ecb524209ea16f1b2f77396f84caa385c5"
msgid "Floating point expressions (or, more simply, ``expressions'') are\ndenoted by the metasyntactic variable @var{expression}, and are\nevaluated during the parsing of the script file:"
msgstr ""

#. unit_id: be2586e18f60cb5008c8eac4458c823e01785d4e2fed75ad7da106ea9112ad04
#. source_hash: d371474af2fe0067e58c1324c1022fda7ffbf36804c539411c27a9b0039cb51c
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Floating point expressions|paragraph|b66cf546a5bd223931923639f5bf7055290f73467f983b1418d8f771ac96ad73"
msgid "Such @w{@var{expression}s} are used in most of Gmsh's scripting\ncommands. When @code{~@{@var{expression}@}} is appended to a string\n@var{string}, the result is a new string formed by the concatenation of\n@var{string}, @code{_} (an underscore) and the value of the\n@var{expression}. This is most useful in loops (@pxref{Loops and\nconditionals}), where it permits to define unique strings\nautomatically. For example,"
msgstr ""

#. unit_id: 3f634c3ef5788f9dff69b8c7e011a3fd84246b4d283cd932bd21a4aab534f925
#. source_hash: 8ce9645010b14beb8eb2b16fefcfb4686d05e4e631642ee83d1da8ef1396a0c5
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Floating point expressions|paragraph|0da2dbfc6d050bb858cabf804fb8cb2c63b0efe8295f1c907419c316c3b6ba5b"
msgid "is the same as"
msgstr ""

#. unit_id: b25a1553ab876fbe4603ed9dc084c9f44edd7070fed814b89627916203455dfd
#. source_hash: b7e3a7d016e4b9dc5d9bcabe62bd9752bbfbc9cac1d6b228c1bdb3232748e003
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Floating point expressions|paragraph|9fa8598f07c6bd260ab75d5812f5fe3be981ad9b890852aa04c8301016e8e6a8"
msgid "The brackets @code{[]} permit to extract one item from a list\n(parentheses can also be used instead of brackets). The @code{#} permits\nto get the size of a list. The operators @var{operator-unary-left},\n@var{operator-unary-right}, @var{operator-binary},\n@var{operator-ternary-left} and @var{operator-ternary-right} are defined\nin @ref{Operators}. For the definition of @w{@var{built-in-function}s},\nsee @ref{Built-in functions}. The various @w{@var{number-option}s} are\nlisted in @ref{Gmsh options}.  @code{Find} searches for occurrences of\nthe first expression in the second (both of which can be lists).\n@code{StrFind} searches the first @var{string-expression} for any\noccurrence of the second @var{string-expression}. @code{StrCmp} compares\nthe two strings (returns an integer greater than, equal to, or less than\n0, according as the first string is greater than, equal to, or less than\nthe second string). @code{StrLen} returns the length of the\nstring. @code{TextAttributes} creates attributes for text\nstrings. @code{Exists} checks if a variable with the given name exists\n(i.e., has been defined previously), and @code{FileExists} checks if the\nfile with the given name exists.  @code{StringToName} creates a name\nfrom the provided string.  @code{GetNumber} allows to get the value of a\nONELAB variable (the optional second argument is the default value\nreturned if the variable does not exist). @code{GetValue} allows to ask\nthe user for a value interactively (the second argument is the value\nreturned in non-interactive mode). For example, inserting\n@code{GetValue(\"Value of parameter alpha?\", 5.76)} in an input file will\nquery the user for the value of a certain parameter alpha, assuming the\ndefault value is 5.76. If the option @code{General.NoPopup} is set\n(@pxref{General options}), no question is asked and the default value is\nautomatically used."
msgstr ""

#. unit_id: 88b6206f25ea1544735b7d0f5372c21fb325289174ab5c40983248824de9cec9
#. source_hash: 69e1c7e9a2ba2727e8a7557f7d5fc1de041c4cd30d392b68422172f4f7681aa8
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Floating point expressions|paragraph|bc1a275b32f1e961a9bc26974e82fd77029d7611d5734f2c7aab86212bda8c16"
msgid "@code{DefineNumber} allows to define a ONELAB variable in-line. The\n@var{expression} given as the first argument is the default value; this\nis followed by the various ONELAB options. See the\n@uref{https://gitlab.onelab.info/doc/tutorials/wikis/ONELAB-syntax-for-Gmsh-and-GetDP,\nONELAB tutorial wiki} for more information."
msgstr ""

#. unit_id: e5b685782d8997d6ee2733fcdbc8ff9c2eaf26d3d3d96d04de2ef6d26358a75c
#. source_hash: 4bd69b0a479aeb462c6f75d74522f47696b854bd6571441aefaa3625bde78ead
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Floating point expressions|index|Expressions, lists"
msgid "Expressions, lists"
msgstr ""

