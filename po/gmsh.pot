#. unit_id: defb28d316600cd3095de5ef2cb4a095650cf7611e68663b645e0c3210797d6f
#. source_hash: dc1d56a53bdf2b0f3d0b03a398ddaf050ef83147448e622f79d367723852cefb
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.9.0"
msgid "2.9.0 (March 12, 2015): improved robustness of spatial searches (extruded meshes,\ngeometry coherence); improved reproductibility of 2D and 3D meshes; added\nsupport for high resolution (\"retina\") graphics; interactive graph point\ncommands; on-the-fly creation of onelab clients in scripts; general periodic\nmeshes using afine transforms; scripted selection of entities in bounding boxes;\nextended string and list handling functions; many small improvements and bug\nfixes."
msgstr ""

#. unit_id: 077421f688465b55b8db99dad0ef92bfb684b2b076782abe93fe803763e6e247
#. source_hash: 245df48d1994e64f1e9d7c44747dadbf560ff02ee1d7b5e8e73b52e94ba5ac28
#: CHANGELOG.txt
msgctxt "CHANGELOG.txt|Version history|paragraph|2.8.5"
msgid "2.8.5 (Jul 9, 2014): improved stability and error handling, better Coherence\nfunction, updated onelab API version and inline parameter definitions, new\nbackground image modes, more robust Triangulate/Tetrahedralize plugins, new PGF\noutput, improved support for string~index variable names in parser, small\nimprovements and bug fixes all over the place."
msgstr ""

#. unit_id: fdd7c3cec572756c2768992d61600e0c5aed8b7adc9300063cdf3b6cd12a2f30
