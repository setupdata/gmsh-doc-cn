#. unit_id: f031f670fa468b3955ebd38aec9dd7ca2719d625e39dbdd80754125c81e2b4ef
#. source_hash: 5e75cdc26251e7b76f898cbe0fd1203b1b2613c970c8b82f725dce6ac1562b91
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Reporting a bug|paragraph|51dc5cb23134806eafbe255e6baa4d729902ced6129fb6e79b71d2e6b1d0b427"
msgid "If, after reading this reference manual, you think you have found a bug\nin Gmsh, please file an issue on\n@url{https://gitlab.onelab.info/gmsh/gmsh/issues}. Provide as precise a\ndescription of the problem as you can, including sample input files that\nproduce the bug. Don't forget to mention both the version of Gmsh and\nyour operation system."
msgstr ""

