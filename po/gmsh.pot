#. unit_id: b4dee1946dac4964d98caad7a69c1ca00c8c0ee3b11b7f7910206a3968f29a37
#. source_hash: 2e356bb10fb483f3d7ac423af593649eb51c8f012665a2da2579dcbc7c63ff7c
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh command-line interface|paragraph|2ccf085ddc7920d27f607ef9a4b5c061908bdc01fcc00a6f593ce5b3e370beed"
msgid "Gmsh defines a number of commands-line switches that can be used to\ncontrol Gmsh in ``batch'' mode from the command line, and pass options\nwithout resorting to a script (@pxref{Gmsh scripting language}) or the\nAPI (@pxref{Gmsh application programming interface})."
msgstr ""

#. unit_id: 1ad8478b0101161dbf3ac63eca1cad9470f09a633b42213d50befb3d18a879a8
#. source_hash: 2b429636fc1af1be627879741cb814dd5971c4fb0118cd702d8dc9ca24733750
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh command-line interface|paragraph|9e40892b91b4be2dcdcd6b4b058e5105efadd596a90a6f83e1e37d3a108e050b"
msgid "For example, meshing the first tutorial in batch mode can be done in a\nterminal by passing the @code{-2} command-line switch:"
msgstr ""

#. unit_id: c22aa73cc8aad7243ab7f745a4fbee7142d493d937d96a14d53a1c4b9dfd2f76
#. source_hash: f02567b85c8af52e119db8a12d6e10d1569d4f47d5eaaa05721d3a17480b5057
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh command-line interface|paragraph|70544dcecb0f8554d342ed504b15cc97ebe2609958bf2ef84b9d31416893803e"
msgid "The same effect could be achieved by adding the @code{Mesh 2;} command\nat the end of @file{t1.geo} and running"
msgstr ""

#. unit_id: ec1394383d470ae87a73a66254fcb8e1fc4b9676cc541c1a6bea737249e8538d
#. source_hash: b9eced628621d40f7c8489dbe9349acbfd6dfa9f3a070abc74ee750966fc6730
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh command-line interface|paragraph|860d83d15d2848435162a298159eaf239284bceac106ff27b858f8cefa2ce1f7"
msgid "or further adding the @code{Exit;} command at the end of the script and\nsimply opening this new file:"
msgstr ""

#. unit_id: 100d3e721fd61370edc7b35e652fa631354030c565e8cec798f4a4a1bd812a8f
#. source_hash: b98a662c3efa0e731d09cd7d8a58b1f3adf5d2a2c6f2a99a7dae5d63d8266234
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh command-line interface|paragraph|5b30a387280e675d7de75d51ae3eae260fe30f08c26055638ec8836b9b0f5464"
msgid "Note that all numeric and string options (@pxref{Gmsh options}) can be\nset from the command line with the @code{-setnumber} and\n@code{-setstring} switches"
msgstr ""

#. unit_id: f59e57f56c6ea818705dc645704ca3171f9027d7ca099204efde6123b0a926f3
#. source_hash: aa44cad5b3e711a5e4dc489227b54de816f43654bb34ec9ccf8215aa4c6a43ab
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh command-line interface|paragraph|36ac8961436bf1762961f45905d58b5dde9cf4d8d3ee09562f3752789c958ca7"
msgid "The list of all command-line switches is given hereafter."
msgstr ""

#. unit_id: cfa73b08882708ce0dbccaca05fe23a2ea429757129a1357e0bb51d1f75af4a6
#. source_hash: 444bc16e4ebdefdec50fa177ed320eb52ff347efcbb2673ee3cd968a07484e12
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh scripting language|heading|Gmsh scripting language"
msgid "Gmsh scripting language"
msgstr ""

#. unit_id: 759bd7efc89a582de2055191ef0b6284abd75a5b9d55f924784fe8ae5a8d6a46
#. source_hash: 1d40e3fc66bd77c3cc712d3efaa646778bf9f89cb1d594f95ba6c475d41359ad
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh scripting language|paragraph|4faef2e1b54c7ae95f5d339772310064b1532260d4f26d59fc0ec7f981f7c4f8"
msgid "The Gmsh scripting language is interpreted at runtime by Gmsh's\nparser. Scripts are written in ASCII files and are usually given the\n@file{.geo} extension, but any extension (or no extension at all) can\nalso be used. For example Gmsh often uses the @file{.pos} extension for\nscripts that contain post-processing commands, in particular parsed\npost-processing views (@pxref{Post-processing scripting commands})."
msgstr ""

#. unit_id: 3c9eabdb8343737d9775d55eb3f72c55a25aa908a97fe9d1ed3a25b99eadc985
#. source_hash: a2388471aa5121911d18d0647a77beedc4885af1f78e6bb105270e5d023541df
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh scripting language|paragraph|356dcb44fb86a1bbc51c23b142f2478018c25bb34e9c145ca43b86b5feea8cfe"
msgid "Historically, @file{.geo} scripts have been the primary way to perform\ncomplex tasks with Gmsh, and they are indeed quite powerful: they can\nhandle (lists of) floating point (@pxref{Floating point expressions})\nand string (@pxref{String expressions}) variables, loops and tests\n(@pxref{Loops and conditionals}), macros (@pxref{User-defined macros}),\netc. However Gmsh's scripting language is still quite limited compared\nto actual programming languages: for example there are no private\nvariables, macros don't take arguments, and the runtime interpretation\nby the parser can penalize performance on large models. Depending on the\nworkflow and the application, using the Gmsh API (@pxref{Gmsh\napplication programming interface}) can thus sometimes be\npreferable. The downside of the API is that, while the scripting\nlanguage is baked into Gmsh and is thus available directly in the\nstandalone Gmsh app, the API requires external dependencies (a C++, C or\nFortran compiler; or a Python or Julia interpreter)."
msgstr ""

#. unit_id: 6ce9b54b858c4158e8f1e95b3d4efeecd3fb8a6b3cfb0af914f1a3bfc97e4100
#. source_hash: b2dcfb781dd5925c9465025c83002e4f4a37760f7446da25cde253aa049243eb
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh scripting language|paragraph|17d4046b8d7819ec945435059be01b522697dc26bd0437d47115a1a2a7b6d59a"
msgid "This chapter describes the scripting language by detailing general\ncommands first (@pxref{General scripting commands}), before detailing\nthe scripting commands specific to the geometry (@pxref{Geometry\nscripting commands}), mesh (@pxref{Mesh scripting commands}) and\npost-processing (@pxref{Post-processing scripting commands}) modules."
msgstr ""

#. unit_id: 3d8aba88fadd8f7773ffa65c4f802ad13bc38d94f1a30084513b786e3194aaa0
#. source_hash: 54c43f57d51f69ccbca79cdea4f6497594571501b1fed4db5099db5a022f0b8d
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh scripting language|paragraph|add95ec85de03369c805f9144bb20778462b2e71ffa9272eedf5355d6f4ac1b3"
msgid "The following rules are used when describing the scripting language in\nthe rest of this chapter (note that metasyntactic variable definitions\nstay valid throughout the chapter, not only in the section where the\ndefinitions appear):"
msgstr ""

#. unit_id: 100894ad37815788f46111f5376ccee2a96f6ca08d024347f11ebebe3b9d3eb9
#. source_hash: 5ad3eab536f80dcc50b25e826bb176b229ef6bf9df9a54f31a9a206c8d930eef
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh scripting language|paragraph|1de16a444f9e83c74469d626aa13c3401b8e72de15ba5a447bbfdacb4c0fda5f"
msgid "Keywords and literal symbols are printed like @code{this}."
msgstr ""

#. unit_id: 5aa6918c5d7d6734895d2ac8afbea905f995fa766768fc60177c09a26406b224
#. source_hash: 23733aee3c754826b63cf759727ba19f558d0e3f74dba808b7c021251e3c4e29
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh scripting language|paragraph|ac30af5c724e4ab1410be2a39077ab6f753e28b997d6525fe4c58cc2f8e5b23f"
msgid "Metasyntactic variables (i.e., text bits that are not part of the syntax,\nbut stand for other text bits) are printed like @var{this}."
msgstr ""

#. unit_id: 1b7b213f08df526edf1032b65ea93299ec011751eb826d95e6e11eab5654d377
#. source_hash: b7bdd14377cc9c2c1e47a0392089339ed811641d3e73518ccf6f9986c10901b8
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh scripting language|paragraph|1090e35849626dd4cf62f356148ebbf5d35522fa0a17022fdff5c335737102d9"
msgid "A colon (@code{:}) after a metasyntactic variable separates the variable\nfrom its definition."
msgstr ""

#. unit_id: e8b5b42845c6fa06f27a7fb24c74c951071d5a94554e71e82c417945247d0c58
#. source_hash: d5d78d31b5abb382658ce17b8e2ab97dfe60db5968625564409876ec1b7edb3f
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh scripting language|paragraph|79de87c4f8937817369be6cadd612dc5269c0425dad56080bcceb8a6b404718d"
msgid "Optional rules are enclosed in @code{<} @code{>} pairs."
msgstr ""

#. unit_id: 4eba763b725b4cb50ba9ea0871dc216ad28a74037dbf651f0a850e990fb05921
#. source_hash: 0e4d03bcedf8c9df8b4c2bbe46aff8028c17f1b83f15c7794094df0550505e65
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh scripting language|paragraph|cd9885b5f6449f1ce5b95067e7082580ef7b84c79e734f57716487889a5a061e"
msgid "Multiple choices are separated by @code{|}."
msgstr ""

#. unit_id: e90026615cf0f0aae70fb32c9327e5a1265b396311d33b92972f3026367fb3cf
#. source_hash: f02534b425bd425cd9bb669303d38fc5659a1d6c304853fcac4cb951e1f5ffcc
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh scripting language|paragraph|f85a31574643a39a72398cd4ac92ffe39459430258815f709c3888864f5332ad"
msgid "Three dots (@dots{}) indicate a possible (multiple) repetition of the\npreceding rule."
msgstr ""

#. unit_id: 63c5fd724bf05618896f23ef6523b159d8b7e7eef0f5fcaacba57262f9ec1896
#. source_hash: 4ca6a8973c915b8d975078624e77f179d0ef3e9bdf2daa6a2d3e55c0affc9e34
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh scripting language|index|GeoEntity @{ @var{expression} @}"
msgid "GeoEntity @{ @var{expression} @}"
msgstr ""

#. unit_id: f243d3778e4ee0a4efcceca3e4c23942fba0ca27cb3a0121cd4cc92b5acf9a4d
#. source_hash: 569454ac6b242b5d53c19b5ae9780cf8e7497940437ebaa4b3ff4bd4fc933a3d
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh scripting language|paragraph|2deb3883a78e2467926c4efb536eb211a56c967d32ceb221c114a649b19211c8"
msgid "In most commands that apply to geometrical entities of several\ndimensions with the same syntax (e.g. the creation of @code{Physical\nPoint | Curve | Surface | Volume}), the @code{Point}, @code{Curve},\n@code{Surface} and @code{Volume} keywords can be replaced by\n@code{GeoEntity @{ @var{expression} @}}, with @var{expression}\nrespectively equal to 0, 1, 2, or 3. This makes it easier to script\nparametric geometries that are valid in several dimensions, without code\nduplication."
msgstr ""

#. unit_id: 0acff0d1e2be4aa8bc78285efc2d3a35e01d1463d8426df706d151f6ad86e4bb
#. source_hash: c6afa6cbf2b300f8cd232933285b587af1c7e83acf9459cf6a5204c88e3454aa
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|General scripting commands|heading|General scripting commands"
