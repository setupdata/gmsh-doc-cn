msgid "Adding a new option"
msgstr ""

#. unit_id: 2ebc2ba262ae08a46450e3dda9bf5a5e4fb3645c598d119088e82635042a63d2
#. source_hash: f805db90694916b764eba77c13044b3827df3f90d6facb1c8da53185c1281eab
#: doc/texinfo/gmsh.texi
