#. unit_id: 8711a987cd28a6fabd3955261afdc7556868651977542017954cfe3d6e62479f
#. source_hash: 4a0f4dd19d6326ec379aa069cd3cbcf0eb27d987ac2bf6a8edcf05818db3800a
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh graphical user interface|paragraph|49a41bc51179ef0bae8af1cf4dc29490273a08822099f100bfbf83bae569be43"
msgid "Once you have the Gmsh application installed (@pxref{Installing and\nrunning Gmsh on your computer}), to launch the graphical interface just\ndouble-click on the Gmsh icon, or type"
msgstr ""

#. unit_id: b7ee2ae0dfa5ec10239296343d50eb7d0a0243238b7dcbd206c5656b5ff648f4
#. source_hash: 8bf25dc2377c8ce22f0343ce19445eaf83d8d87421c9ba2e41501499850d608b
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh graphical user interface|paragraph|6d4b26e4e3dfa7be12378ff9982305b6f9b5eac25b015814f8cca9169ad8bab0"
msgid "at the shell prompt in a terminal. This will open the main window of the\nGmsh GUI, with a menu bar on top (except on macOS, where by default the\nmenu bar is on the top of the screen -- this can be changed with the\n@code{General.SystemMenuBar} option, see @ref{General options}), a tree\nmenu on the left (which by default contains a `Modules' entry with three\nchildren: `Geometry', `Mesh' and `Solver'), a graphic area on the right,\nand a status bar with some shortcut buttons at the bottom. (You can\ndetach the tree menu using `Window->Attach/Detach Menu'.)"
msgstr ""

#. unit_id: ec55080880e2e0b22e0215a5115bc9aeba85cfb4e6109fc25d8f631a8bc18d81
#. source_hash: 6d0fbb8c533469275d4341766ea87e7d3f93b4da4429597cd7698a19d82d83d5
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh graphical user interface|paragraph|435e89ad51194fbc78a3120e214c2a0086e4aefc45dc962f12fea38ff24bdf08"
msgid "@center@image{images/gui,10.5cm,,Gmsh's graphical user interface (GUI)}"
msgstr ""

#. unit_id: 633add70515199354b1dce5d6ec2203fce148e1a8109e6832ce6bdb4c0d16dd5
#. source_hash: caf57e9699372f5ccab6d8493bd7020fb67a64ddf47081e01bf3712d7a7b08f8
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh graphical user interface|paragraph|b91940e6e8c4fe23b113782b2934f67d96e2a9219a81cb2a6d354283690f91b9"
msgid "To create a new geometrical model, use the `File->New' menu to create a\nnew model file, and choose for example @file{mymodel.geo} as file\nname. Then in the tree menu, successively open the `Geometry',\n`Elementary entities' and `Add' submenus, and click for example on\n`Rectangle'. A context window with parameters will pop up: you can enter\nsome parameters in this window (e.g. the width and height of the\nrectangle) and move the mouse to place it on the canvas. If you don't\nwant to place the rectangle with the mouse, select `X', `Y' and `Z\nfreeze' in the window and enter the coordinates manually in the context\nwindow. Once you are done, either press @kbd{e} (see the status message\non the top of the graphic window) or click on the `Add' button in the\ncontext window."
msgstr ""

#. unit_id: 1fb7ff8eb98ac8ab03427dbdd009d05ab990bc572bb599b1532e12fb03707530
#. source_hash: b618a27e4ab43b8077f563c6a6ba34fc405edb4090b07af0379eeb0a234ebf9e
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh graphical user interface|paragraph|faccdcfd313f6abe561e0cfbcc46b7ba98aa66931fa8c78ca45e0637a01437a4"
msgid "@center@image{images/gui_add_rectangle,10.5cm,,Adding a rectangle in the GUI}"
msgstr ""

#. unit_id: 7f56c40c050a109d9c3b57e2691e301fbc0f99a4a878096be308997bbb5d6a70
#. source_hash: 1475fc3ec38a5e704dd4f7651fa556b3b7ec798488af614b7cd822094aadc7e0
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh graphical user interface|paragraph|7b40f6a95717ced2e37488eab5f64c85bea3c45a6b8878d7d18c30fb9545ba14"
msgid "There is no need to save your geometrical model: when the rectangle was\nadded, scripting commands were automatically appended to your model\nfile @file{mymodel.geo}:"
msgstr ""

#. unit_id: 5c08a562ad31231bdaedead2de73d333747f2d5ce92353c10442215118fe79a7
#. source_hash: dadb946fe14e074c6edca3a3e7d66e1a267c018c70340fc04a9e54cea2cd55e7
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh graphical user interface|paragraph|2246028d38119760bdc5389399a2599e23db18f2be2dad032e5e32a278d18414"
msgid "You can edit this script with any text editor; clicking on `Edit script'\nin the tree menu will launch the default text editor specified by the\n@code{General.Editor} option (@pxref{General options}). If you edit the\nscript, you should click on `Reload script' in the tree menu to reload\nthe modifications in the GUI. The @code{//+} line in the script is a\ncomment that is used as a placemark between commands added by the GUI;\nsee @ref{Gmsh scripting language} for the scripting language reference."
msgstr ""

#. unit_id: 90d016542a6474328b3a03b38619720cd187b8275070ca31c34b77faa28718ab
#. source_hash: 467e6fd17b273367e5e053c526ffd316367d063843637c49c6d8273485777443
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh graphical user interface|paragraph|76abd386eb67a4a85879c01acacc3bde161e6334a1a965bf9e5f8a1a27448e57"
msgid "Combining GUI actions and script file editing is a classical way of\nworking with the Gmsh app. For example, it is often faster to define\nvariables and points directly in the script file, and then use the GUI\nto define the curves, the surfaces and the volumes interactively."
msgstr ""

#. unit_id: 604ba9428d9bfe15e9222a64a0370efdc7a3b7802c12553bab6a50af3b16aae0
#. source_hash: db820bec93ea845947ece2ffffa5a270d31e4e87c76220adb0a983e7949928ad
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh graphical user interface|paragraph|f59df54404de4d915afbb2786372edb91d8a0c89d04c1d18cf6e265c9ae5de1a"
msgid "To load an existing model instead of creating a model from scratch, use\nthe `File->Open' menu. For example, to open the first tutorial\n(@pxref{Gmsh tutorial}), choose\n@url{@value{GITLAB-PREFIX}/tutorials/t1.geo,t1.geo}. On the terminal,\nyou can also specify the file name directly on the command line, i.e.:"
msgstr ""

#. unit_id: cb0c398e5f884499c770f31f2e22fcaad6de38ee13d6344b6359a68562102095
#. source_hash: a4fe9db215437b7567101380ad1a2aa47ab79fbe65000fc5d036ccb7645f4a69
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh graphical user interface|paragraph|6e67babc2343f72316b7c3a4dd006ea8d4b6ad445b4d056fbb945fa54c1552e3"
msgid "To generate a mesh, open `Mesh' in the tree menu and choose the desired\ndimension: `1D' will mesh all the curves; `2D' will mesh all the\nsurfaces---as well as all the curves if `1D' was not called before; `3D'\nwill mesh all the volumes---and all the surfaces if `2D' was not called\nbefore. To save the resulting mesh in the current mesh format click on\n`Save' in the tree menu, or select the appropriate format and file name\nwith the `File->Export' menu. The default mesh file name is based on the\nname of the current active model, with an appended extension depending\non the mesh format.  Note that most interactive commands have keyboard\nshortcuts: see @ref{Keyboard shortcuts}, or select `Help->Keyboard and\nMouse Usage' in the menu. For example, to quickly generate the 2D mesh\nand save a mesh, you can first press @kbd{2}, then @kbd{Ctrl+Shift+s}."
msgstr ""

#. unit_id: f2b0e1aba79598251fd04e40e40cc2d3bf3521517237bc09198aca9cf8183844
#. source_hash: dc5be05b234cd902717db878254f1e6aede291f6ae2c870b25570b47256f0bb6
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh graphical user interface|paragraph|cebd28db48c72a04340f8d86011ee403c53555815bd42f2f369d9e166d248d8c"
msgid "A double-click in the graphic window will pop up a quick shortcut menu,\nwhich can be used e.g. to quickly toggle the visibility of mesh entities\n(like surface faces), reset the viewport, select the rotation center,\ndisplay axes, or access the full module options (from the\n`Tools->Options' menu). The shortcut buttons on the bottom left of the\nstatus bar can be used to quickly adjust the viewport: `X', `Y', `Z' set\nviewports with the corresponding axis perpendicular to graphic plane;\nthe rotation button rotates the view by 90 degrees; and `1:1' resets the\nscale."
msgstr ""

#. unit_id: ae565bd061c503a39d0ca03ba6703a38cc532156ce709e4961047009c2c3d3e6
#. source_hash: 46af4b291f07a00f53e8c7cf56c57d0fefcf26e1e1b631a63cd27bb32672a7f0
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh graphical user interface|paragraph|079c0d8c004ea5aadd6ac58a1dab1ede9a1471dd8453589e23350a44160c88ac"
msgid "@center@image{images/gui_mesh,10.5cm,,Meshing in the GUI}"
msgstr ""

#. unit_id: 9e1ffeb96640d6860e3b29426dbb8960637a701e05d2abf83e88d3945a69fa3c
#. source_hash: e6fa01c014cba491e1ccefd0a54c960ae50d8bbab354d9d4608786f0938317c3
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh graphical user interface|paragraph|1f38f32857bb17c25d561a81118b9aaa74400b834fb240afbe5a3ce45e7dc277"
msgid "Several files can be loaded simultaneously. When specified on the\ncommand line, the first one defines the active model (in the same way as\nusing the `File->Open' menu) and the others are `merged' into this model\n(in the same way as using the the `File->Merge' menu). For example, to\nmerge the post-processing views contained in the files\n@url{@value{GITLAB-PREFIX}/tutorials/view1.pos,view1.pos} and\n@url{@value{GITLAB-PREFIX}/tutorials/view5.msh,view5.msh} together with\nthe geometry of the first tutorial @ref{t1}, you can type the following\ncommand:"
msgstr ""

#. unit_id: 0c36b7b82004e43ae138e0ceb8f7041c176cb3dea48db0c0123135c892b0a6a7
#. source_hash: 85baa9dcc0814b0497ad0b5208e452c14be59946e2bdbba21a35ae0ec15e84fa
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh graphical user interface|paragraph|301275c70241e1a0fa27f1ce08eceaf06f64bc45891852789f8d718b93a2e025"
msgid "When one or more more post-processing views are loaded, a\n`Post-Processing' entry in the tree menu appears. With the previous\ncommand, three views will appear in the tree menu under\n`Post-processing', respectively labeled `A scalar map', `Nodal scalar\nmap' and `Element 1 vector'. In this example the views contain several\ntime steps: you can loop through them with the shortcuts icons on the\nleft of the status bar. A mouse click on the view name will toggle the\nvisibility of the selected view, while a click on the arrow button on\nthe right will provide access to the view's options."
msgstr ""

#. unit_id: 323b1d07ae9ea869fae995ff2005f39e546a0ce3435981068815ece8c23bef20
#. source_hash: 286cd03a7f2f05bd0d3cc56bc27d3677424e5a74ed797f405e7b7a3b4f751424
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh graphical user interface|paragraph|5610c956d48912106169060e10d4fbe33cc154223ce01ad0203c3ec7a8e2da96"
msgid "Note that all the options specified interactively can also be directly\nspecified in the script files. You can save the current options of the\ncurrent active model with the `File->Save Model Options'. This will\ncreate a new option file with the same filename as the active model, but\nwith an extra @file{.opt} extension added. The next time you open this\nmodel, the associated options will be automatically loaded, too.  To\nsave the current options as your default preferences for all future Gmsh\nsessions, use the `File->Save Options As Default' menu instead. You can\nalso save the current options in an arbitrary file by choosing the `Gmsh\noptions' format in `File->Export'. For more information about available\noptions (and how to reset them to their default values), see @ref{Gmsh\noptions}. A full list of options with their current values is also\navailable using the `Help->Current Options' menu."
msgstr ""

#. unit_id: 2940c88fefd76d5729443fd558e2c89df43dc386cc100bd79d9d8fd06c69cf1f
#. source_hash: d0de1a67eb1ec671363e1e799e546ea013fc1c6d581c317917ebeb256cf28f1b
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh graphical user interface|paragraph|25c31a5d957e0d4af4ed97ffdda9392aaac7ab1bfcc96664208a07c49266a189"
msgid "Finally, note that the GUI can also be run (and modified) using the API:\nsee @ref{Namespace gmsh/fltk} for details."
msgstr ""

#. unit_id: cc6516c9bf2d0f01c1c926f85bb638905bcd9334132f1bdcb31122b5a0274d1a
#. source_hash: e8c5fc3802e13ceeeabc32bde9b1a2f23770dae6795f4070875c683984a032d7
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Gmsh graphical user interface|paragraph|3b2db20319a826e238026d4b3014f911ca65cb87d87b15a4e212dcfb6be7a72d"
msgid "The two next sections describe the mouse actions in the GUI, as well as\nall the predefined keyboard shortcuts. Screencasts explaining how to use\nthe Gmsh GUI are available online at the following address:\n@uref{https://gmsh.info/screencasts/}."
msgstr ""

