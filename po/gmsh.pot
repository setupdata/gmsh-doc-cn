#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|item|ReorientMesh Volume @{ @var{expression-list} @} ;"
msgid "ReorientMesh Volume @{ @var{expression-list} @} ;"
msgstr ""

#. unit_id: 1ee3d5c49720f6ee53aee07f33003ab000b917e636f53d966bbaa1f64742b63a
#. source_hash: 2ce6526b6c56e6f3b0db1e0c620549e10331407648f148fdd184ea3e92d4d44a
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|paragraph|ReorientMesh Volume @{ @var{expression-list} @} ;"
msgid "Add a constraint to reorient the meshes (during mesh generation) of the\nbounding surfaces of the given volumes so that the normals point outward\nto the volumes; and if a mesh already exists, reorient it. Currently\nonly available with the OpenCASCADE kernel, as it relies on the STL\ntriangulation. @value{SYNC}"
msgstr ""

#. unit_id: d6099bdc3e52be53df843488068db5e14d781ca2a19f2c0f277211397f7b53c9
#. source_hash: 1acc4824268fc9ff9ed18f271436cdb7651fe043add2164cfb7a141ffdbbdb14
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|item|Save @var{string-expression};"
msgid "Save @var{string-expression};"
msgstr ""

#. unit_id: 4a5cc3e8c540991695e174de6945e8f4c34e2bc016f98d28ad3ea82bcd508b1f
#. source_hash: 7e30e79165c65b6c94b8cb68eeb2e604f8e395d3077b83f416b3441d2a2d7c5e
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|paragraph|Save @var{string-expression};"
msgid "Save the current mesh in a file named @var{string-expression}, using the\ncurrent @code{Mesh.Format} (@pxref{Mesh options}). If the path in\n@var{string-expression} is not absolute, @var{string-expression} is appended\nto the path of the current file. @value{SYNC}"
msgstr ""

#. unit_id: e45ce5317076770c6b0e6fe6c81e7ac63259f59638de19d785f809295b363784
#. source_hash: 6a19259a98fe87a72912fdd16bc4c09b3b1b48074ddf1e1baf4809752dfc8f72
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|item|Smoother Surface @{ @var{expression-list} @} = @var{expression};"
msgid "Smoother Surface @{ @var{expression-list} @} = @var{expression};"
msgstr ""

#. unit_id: 6f9e1d639043f3ab2ee1687fd18bdb31ad6ad37c02a2a4ed9dc688339f1bfb68
#. source_hash: 681d70c00480683295d6c5c8309acd230d8876dc09c15be413797f48b946385d
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|paragraph|Smoother Surface @{ @var{expression-list} @} = @var{expression};"
msgid "Set the number of elliptic smoothing steps for the surfaces listed in\n@var{expression-list} (smoothing only applies to transfinite meshes at\nthe moment). @value{SYNC}"
msgstr ""

#. unit_id: f77ad9f15814ce1ce876244477572264786610acb89fbd79f837c5305f3d4745
#. source_hash: 8501a978e598aaed430210fb21747d743492956bf7fd1f990d69566e2511c5d0
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|item|Homology ( @{ @var{expression-list} @} ) @{ @{ @var{expression-list} @} , @{ @var{expression-list} @} @};"
msgid "Homology ( @{ @var{expression-list} @} ) @{ @{ @var{expression-list} @} , @{ @var{expression-list} @} @};"
msgstr ""

#. unit_id: 75096257cfbca16e1362f3f445d8352bc92e5f7fee2dfe916515cd495365af0a
#. source_hash: 295235bc16a419c60906fa175097753e928abbb585b1c785cc4bb2e126f08fe4
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|paragraph|Homology ( @{ @var{expression-list} @} ) @{ @{ @var{expression-list} @} , @{ @var{expression-list} @} @};"
msgid "Compute a basis representation for homology spaces after a mesh has\nbeen generated. The first @var{expression-list} is a list of\ndimensions whose homology bases are computed; if empty, all bases are\ncomputed. The second @var{expression-list} is a list physical groups\nthat constitute the computation domain; if empty, the whole mesh is\nthe domain. The third @var{expression-list} is a list of physical\ngroups that constitute the relative subdomain of relative homology\ncomputation; if empty, absolute homology is computed. Resulting basis\nrepresentation chains are stored as physical groups in the mesh."
msgstr ""

#. unit_id: 8232d685bfd7ea3eab3b3058f95f9af5bdb9be94e757a68cbc24d66de32c60fd
#. source_hash: e5611c0861d0af749f89618513184c26a8f3babeed1c2f2e53629550dd409475
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Other mesh commands|item|Cohomology ( @{ @var{expression-list} @} ) @{ @{ @var{expression-list} @} , @{ @var{expression-list} @} @};"
msgid "Cohomology ( @{ @var{expression-list} @} ) @{ @{ @var{expression-list} @} , @{ @var{expression-list} @} @};"
msgstr ""

