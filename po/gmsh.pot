#. unit_id: a7742cc84f390e806671cdef7878473f46df68846939b85047b7b01783b1f3d8
#. source_hash: 3120d8cfc14d2d01153af8a19d9f4d29bcf391c70433ae34cd1332307526548d
#: doc/texinfo/gmsh.texi
msgctxt "doc/texinfo/gmsh.texi|Points|paragraph|Physical Point ( @var{expression} | @var{string-expression} <, @var{expression}> ) <+|->= @{ @var{expression-list} @};"
msgid "Create a physical point. The @var{expression} inside the parentheses is\nthe physical point's tag; the @var{expression-list} on the right hand\nside should contain the tags of all the elementary points that need to\nbe grouped inside the physical point.  If a @var{string-expression} is\ngiven instead instead of @var{expression} inside the parentheses, a\nstring label is associated with the physical tag, which can be either\nprovided explicitly (after the comma) or not (in which case a unique tag\nis automatically created)."
msgstr ""

