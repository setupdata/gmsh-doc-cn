FROM docker.io/library/python:3.13.14-slim-trixie@sha256:9662417aace5ae7b8e2609cce472b72a8958e134ba372808abe9cc1a0c0125e6

ARG DEBIAN_SNAPSHOT=20260813T000000Z

ENV TZ=UTC \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    PYTHONHASHSEED=0 \
    PYTHONPATH=/opt/gmsh-doc-cn/src \
    DEBIAN_FRONTEND=noninteractive

RUN printf 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/%s trixie main\n' "$DEBIAN_SNAPSHOT" > /etc/apt/sources.list \
    && rm -f /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        gettext=0.23.1-2 \
        git \
        po4a=0.73-2 \
        texinfo=7.1.1-1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY src /opt/gmsh-doc-cn/src

ENTRYPOINT ["python", "-m", "gmsh_doc_cn"]
