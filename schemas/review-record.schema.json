{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://setupdata.github.io/gmsh-doc-cn/schemas/review-record.schema.json",
  "title": "Gmsh Chinese review record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "run_id", "batch", "unit_id", "role", "round",
    "source_hash", "candidate_hash", "protected_hash", "context_hash", "rules_hash",
    "model", "reasoning_effort", "prompt_file", "prompt_hash", "glossary_hash",
    "result", "issues", "origin", "started_at", "completed_at", "retry_count", "cost"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "batch": {"type": "string", "minLength": 1},
    "unit_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["translation", "revision", "language_review", "technical_review"]},
    "round": {"type": "integer", "minimum": 0, "maximum": 2},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protected_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "context_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rules_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model": {"type": "string", "minLength": 1},
    "reasoning_effort": {"type": "string", "minLength": 1},
    "prompt_file": {"type": "string", "minLength": 1},
    "prompt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "glossary_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result": {"enum": ["accept", "revise", "unresolved"]},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": {"type": "string"},
          "severity": {"enum": ["critical", "major", "minor"]},
          "message": {"type": "string"}
        }
      }
    },
    "origin": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "completed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "retry_count": {"type": "integer", "minimum": 0},
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "amount", "source"],
      "properties": {
        "currency": {"type": "string", "minLength": 1},
        "amount": {"type": "number", "minimum": 0},
        "source": {"type": "string", "minLength": 1}
      }
    }
  }
}
