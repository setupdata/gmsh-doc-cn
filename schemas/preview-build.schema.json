{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm",
    "reproducible",
    "site_base",
    "upstream_version",
    "upstream_tag",
    "upstream_commit",
    "translation_revision",
    "translation_date",
    "source_date_epoch",
    "unit_count",
    "formal_unit_count",
    "fallback_unit_count",
    "english_root",
    "preview_root",
    "english_html_file_count",
    "preview_html_file_count",
    "noindex_nofollow_page_count",
    "visible_preview_marker_page_count",
    "english_fallback_marker_page_count",
    "english_anchor_count",
    "preview_anchor_count",
    "missing_english_anchor_count",
    "preview_only_anchor_count",
    "english_duplicate_anchor_count",
    "preview_duplicate_anchor_count",
    "english_broken_internal_link_count",
    "preview_broken_internal_link_count",
    "preview_added_broken_internal_link_count",
    "site_absolute_link_count",
    "broken_site_absolute_link_count",
    "resource_link_count",
    "broken_resource_link_count",
    "warning_fingerprints",
    "input_hashes",
    "artifact_manifest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "algorithm": {"const": "bilingual-preview-build-v1"},
    "reproducible": {"const": true},
    "site_base": {"type": "string", "pattern": "^/[^\\\\]*?/$"},
    "upstream_version": {"type": "string", "minLength": 1},
    "upstream_tag": {"type": "string", "minLength": 1},
    "upstream_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "translation_revision": {"type": "string", "pattern": "^r[1-9][0-9]*$"},
    "translation_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source_date_epoch": {"type": "integer", "minimum": 0},
    "unit_count": {"type": "integer", "minimum": 1},
    "formal_unit_count": {"type": "integer", "minimum": 0},
    "fallback_unit_count": {"type": "integer", "minimum": 0},
    "english_root": {"type": "string", "pattern": "^v[^/]+/en$"},
    "preview_root": {"type": "string", "pattern": "^preview/v[^/]+/zh-cn$"},
    "english_html_file_count": {"type": "integer", "minimum": 1},
    "preview_html_file_count": {"type": "integer", "minimum": 1},
    "noindex_nofollow_page_count": {"type": "integer", "minimum": 1},
    "visible_preview_marker_page_count": {"type": "integer", "minimum": 1},
    "english_fallback_marker_page_count": {"type": "integer", "minimum": 0},
    "english_anchor_count": {"type": "integer", "minimum": 1},
    "preview_anchor_count": {"type": "integer", "minimum": 1},
    "missing_english_anchor_count": {"const": 0},
    "preview_only_anchor_count": {"type": "integer", "minimum": 0},
    "english_duplicate_anchor_count": {"const": 0},
    "preview_duplicate_anchor_count": {"const": 0},
    "english_broken_internal_link_count": {"type": "integer", "minimum": 0},
    "preview_broken_internal_link_count": {"type": "integer", "minimum": 0},
    "preview_added_broken_internal_link_count": {"const": 0},
    "site_absolute_link_count": {"type": "integer", "minimum": 1},
    "broken_site_absolute_link_count": {"const": 0},
    "resource_link_count": {"type": "integer", "minimum": 1},
    "broken_resource_link_count": {"const": 0},
    "warning_fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["english", "preview", "preview_additions"],
      "properties": {
        "english": {"type": "array", "items": {"type": "string"}},
        "preview": {"type": "array", "items": {"type": "string"}},
        "preview_additions": {"type": "array", "maxItems": 0, "items": {"type": "string"}}
      }
    },
    "input_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_manifest",
        "site_config",
        "release",
        "po",
        "status",
        "status_schema",
        "preview_schema",
        "translation_rules",
        "glossary",
        "review_manifest",
        "reviews",
        "check_units",
        "tool_versions",
        "containerfile"
      ],
      "properties": {
        "upstream_manifest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "site_config": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "release": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "po": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status_schema": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "preview_schema": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "translation_rules": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "glossary": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_manifest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reviews": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "check_units": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tool_versions": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "containerfile": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "artifact_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "algorithm", "file_count", "files"],
      "properties": {
        "schema_version": {"const": 1},
        "algorithm": {"const": "sha256-raw-bytes-v1"},
        "file_count": {"type": "integer", "minimum": 1},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "size", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "size": {"type": "integer", "minimum": 0},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  }
}
