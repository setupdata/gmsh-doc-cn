{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batches"],
  "properties": {
    "schema_version": {"const": 1},
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["batch", "file", "run_ids"],
        "properties": {
          "batch": {"type": "string", "minLength": 1},
          "file": {"type": "string", "pattern": "^[^/\\\\]+\\.jsonl$"},
          "run_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
