{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "approval_id", "benchmark_version", "decision", "approved_at",
    "approved_by", "approval_source", "initial_reference_sha256", "reference_sha256",
    "review_manifest_sha256", "review_evidence_sha256",
    "model", "reasoning_effort", "prompt_hashes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "approval_id": {"type": "string", "minLength": 1},
    "benchmark_version": {"const": "v1"},
    "decision": {"const": "approved"},
    "approved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "approved_by": {"const": "maintainer"},
    "approval_source": {"type": "string", "minLength": 1},
    "initial_reference_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model": {"type": "string", "minLength": 1},
    "reasoning_effort": {"type": "string", "minLength": 1},
    "prompt_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translate", "revise", "review_language", "review_technical"],
      "properties": {
        "translate": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "revise": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_language": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_technical": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
